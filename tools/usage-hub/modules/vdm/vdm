  echo -e "    The proxy (port ${PROXY_PORT}) auto-switches on rate limits."
  echo -e "    Emails are fetched automatically  - no manual labeling needed."
  echo ""
}

# ─────────────────────────────────────────────────────────
# Main dispatch
# ─────────────────────────────────────────────────────────

command="${1:-help}"
shift 2>/dev/null || true

case "$command" in
  add)       cmd_add "$@" ;;
  label)     cmd_label "$@" ;;
  priority|prio) cmd_priority "$@" ;;
  disable)   cmd_disable "$@" ;;
  enable)    cmd_enable "$@" ;;
  list|ls)   cmd_list ;;
  switch|sw) cmd_switch "$@" ;;
  remove|rm) cmd_remove "$@" ;;
  status|st) cmd_status ;;
  config|cfg) cmd_config "$@" ;;
  dashboard) cmd_dashboard "$@" ;;
  logs|log) cmd_logs "$@" ;;
  tokens|tok) cmd_tokens "$@" ;;
  upgrade|update) cmd_upgrade ;;
  help|--help|-h) cmd_help ;;
  *)
    echo -e "${RED}Unknown command: $command${NC}"
    cmd_help
    exit 1
    ;;
esac
