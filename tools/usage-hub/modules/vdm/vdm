#!/usr/bin/env bash
# vdm - Van Damme-o-Matic
# Manages multiple Claude Code OAuth credential profiles: the macOS Keychain on
# a Mac, ~/.claude/.credentials.json on Windows. All running Claude Code
# sessions share that one active entry, so switching here affects every tab.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")")" && pwd)"
ACCOUNTS_DIR="$SCRIPT_DIR/accounts"
KEYCHAIN_ACCOUNT="$(whoami)"
DASHBOARD_PORT="${CSW_PORT:-3333}"
PROXY_PORT="${CSW_PROXY_PORT:-3334}"
DASHBOARD_PID_FILE="$SCRIPT_DIR/.dashboard.pid"
CONFIG_FILE="$SCRIPT_DIR/config.json"
ACTIVITY_LOG_FILE="$SCRIPT_DIR/activity-log.json"
STATE_FILE="$SCRIPT_DIR/account-state.json"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

mkdir -p "$ACCOUNTS_DIR"

# ─────────────────────────────────────────────────────────
# Startup migration: ensure hooks are installed
# (handles upgrades from versions that didn't ship install-hooks.sh)
# ─────────────────────────────────────────────────────────

if [[ -f "$SCRIPT_DIR/install-hooks.sh" ]]; then
  _needs_hooks=false
  if [[ ! -f "$HOME/.claude/settings.json" ]]; then
    _needs_hooks=true
  elif ! grep -q "api/session-start" "$HOME/.claude/settings.json" 2>/dev/null; then
    _needs_hooks=true
  fi
  if [[ "$_needs_hooks" == "true" ]]; then
    source "$SCRIPT_DIR/install-hooks.sh"
    install_beta_hooks 2>/dev/null || true
  fi
  unset _needs_hooks
fi

# ─────────────────────────────────────────────────────────
# Node helper
# ─────────────────────────────────────────────────────────
#
# JSON parsing, token hashing and credential-store access all go through
# vdm-helper.mjs. It used to be inline `python3 -c` with the shell's variables
# interpolated into the Python source — which meant python3 was a hard
# dependency (absent on a stock Windows box, where `python3` is a Store stub
# that exits non-zero), and a path containing a quote was injected into the
# program text rather than passed as data.
NODE_BIN="${VDM_NODE:-node}"
HELPER="$SCRIPT_DIR/vdm-helper.mjs"

if ! command -v "$NODE_BIN" >/dev/null 2>&1; then
  echo "vdm needs Node.js 18+ on PATH (set VDM_NODE to point at it)." >&2
  exit 1
fi

# helper <subcommand> [args...] — never prints a token unless asked to.
helper() {
  "$NODE_BIN" "$HELPER" "$@"
}

# ─────────────────────────────────────────────────────────
# Keychain service auto-detection (macOS only)
# ─────────────────────────────────────────────────────────

# The credential store is the macOS Keychain or, on Windows,
# ~/.claude/.credentials.json. vdm-helper.mjs picks; the shell never needs to
# know which. KEYCHAIN_SERVICE survives only for the status line.
detect_keychain_service() {
  if [[ "$(uname -s 2>/dev/null)" == "Darwin" ]]; then
    if security find-generic-password -a "$KEYCHAIN_ACCOUNT" -s "Claude Code-credentials" -w &>/dev/null; then
      echo "Claude Code-credentials"
      return
    fi
    local svc
    svc=$(security dump-keychain 2>/dev/null | grep -A4 '"svce"' | grep -i claude | head -1 | sed -n 's/.*"svce"<blob>="\([^"]*\)".*/\1/p') || true
    if [[ -n "$svc" ]]; then echo "$svc"; return; fi
  fi
  echo "Claude Code-credentials"
}

KEYCHAIN_SERVICE="$(detect_keychain_service)"

read_keychain() {
  helper read-creds 2>/dev/null
}

# Takes the profile PATH, not its contents: the credential blob then never
# passes through a shell variable, a process listing, or the shell history.
write_keychain_from_file() {
  helper write-creds "$1"
}

get_active_fingerprint() {
  helper active-fingerprint 2>/dev/null
}

get_profile_fingerprint() {
  helper profile-fingerprint "$1" 2>/dev/null
}

get_profile_info() {
  helper profile-info "$1" 2>/dev/null
}

fetch_account_email() {
  local token="$1"
  curl -s \
    -H "Authorization: Bearer $token" \
    -H "anthropic-beta: oauth-2025-04-20" \
    -H "User-Agent: claude-code/vdm" \
    "https://api.anthropic.com/api/oauth/claude_cli/roles" 2>/dev/null \
    | helper parse-org-email 2>/dev/null
}

format_sub_type() {
  case "$1" in
    max) echo -e "${BOLD}${CYAN}MAX${NC}" ;;
    pro) echo -e "${BOLD}${BLUE}PRO${NC}" ;;
    free) echo -e "${DIM}FREE${NC}" ;;
    *) echo -e "${DIM}$1${NC}" ;;
  esac
}

# ─────────────────────────────────────────────────────────
# Activity log (shared with dashboard)
# ─────────────────────────────────────────────────────────

log_activity() {
  local type="$1"
  shift
  helper log-activity "$ACTIVITY_LOG_FILE" "$type" "$@" 2>/dev/null || true
}

# ─────────────────────────────────────────────────────────
# Config helpers
# ─────────────────────────────────────────────────────────

read_config() {
  if [[ -f "$CONFIG_FILE" ]]; then
    cat "$CONFIG_FILE"
  else
    echo '{"autoSwitch":true,"proxyEnabled":true,"rotationStrategy":"sticky","rotationIntervalMin":60}'
  fi
}

write_config() {
  echo "$1" > "$CONFIG_FILE"
}

get_config_value() {
  helper config-get "$CONFIG_FILE" "$1" 2>/dev/null
}

# The helper prints JSON booleans (lowercase `true`). The old Python-backed
# reader printed `True`, and the display code still compared against that, so
# every boolean setting rendered as OFF while the daemon had it ON.
is_true() {
  case "$1" in
    true|True|TRUE|1) return 0 ;;
    *) return 1 ;;
  esac
}

# One line saying why the proxy skips this account, empty when it is fine.
get_block_state() {
  helper block-state "$STATE_FILE" "$1" "$ACCOUNTS_DIR/${2:-}.disabled" 2>/dev/null
}

# `value` here is a JSON literal (true/false/a number), matching the original
# contract where it was pasted straight into Python source.
set_config_value() {
  local key="$1" value="$2" type=string
  case "$value" in
    true|false) type=bool ;;
    null) type=null ;;
    ''|*[!0-9.-]*) type=string ;;
    *) type=number ;;
  esac
  helper config-set "$CONFIG_FILE" "$key" "$value" "$type" 2>/dev/null
}

get_config_string() {
  helper config-get "$CONFIG_FILE" "$1" 2>/dev/null
}

set_config_string() {
  helper config-set "$CONFIG_FILE" "$1" "$2" string 2>/dev/null
}

set_config_number() {
  helper config-set "$CONFIG_FILE" "$1" "$2" number 2>/dev/null
}

# Best-effort: push the just-written key to a running dashboard so the change
# applies live (the dashboard otherwise only reads config.json at startup).
# Reads the value back from config.json so JSON typing (bool/number/string) is correct.
apply_setting_live() {
  local key="$1" body
  body=$(helper config-one "$CONFIG_FILE" "$key" 2>/dev/null) || return 0
  [[ -z "$body" ]] && return 0
  curl -s --max-time 2 -X POST "http://localhost:$DASHBOARD_PORT/api/settings" \
    -H 'Content-Type: application/json' -d "$body" >/dev/null 2>&1 || true
}

# ─────────────────────────────────────────────────────────
# Commands
# ─────────────────────────────────────────────────────────

cmd_add() {
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    echo -e "${RED}Usage: vdm add <name>${NC}"
    echo "  Saves the currently logged-in credentials as a named profile."
    echo "  Example: vdm add work-account"
    return 1
  fi

  # Sanitize name
  name=$(echo "$name" | tr ' ' '-' | tr '[:upper:]' '[:lower:]')
  local file="$ACCOUNTS_DIR/${name}.json"

  local creds
  creds=$(read_keychain) || {
    echo -e "${RED}No active Claude Code credentials found. Run 'claude auth login' first.${NC}"
    return 1
  }

  # Get profile info for display
  echo "$creds" > "$file"
  chmod 600 "$file"

  local info
  info=$(get_profile_info "$file")
  local sub_type=$(echo "$info" | cut -d'|' -f1)
  local tier=$(echo "$info" | cut -d'|' -f2)
  local expires=$(echo "$info" | cut -d'|' -f3)

  # Auto-fetch email from API
  local token
  token=$(helper active-token 2>/dev/null)
  local email=""
  if [[ -n "$token" ]]; then
    email=$(fetch_account_email "$token")
  fi
  if [[ -n "$email" ]]; then
    echo "$email" > "$ACCOUNTS_DIR/${name}.label"
  fi

  echo -e "${GREEN}✓${NC} Saved profile ${BOLD}$name${NC}"
  if [[ -n "$email" ]]; then
    echo -e "  Email: ${CYAN}$email${NC}"
  fi
  echo -e "  Plan: $(format_sub_type "$sub_type")  Tier: ${tier}"
  echo -e "  Token expires: ${DIM}$expires${NC}"

  log_activity "account-discovered" "name=$name" "label=${email:-$name}"
}

cmd_label() {
  local name="${1:-}"
  local label="${2:-}"
  if [[ -z "$name" || -z "$label" ]]; then
    echo -e "${RED}Usage: vdm label <name> <label>${NC}"
    echo "  Gives a profile a human-readable label (e.g. email or description)."
    echo "  Example: vdm label work-account john@company.com"
    return 1
  fi

  name=$(echo "$name" | tr ' ' '-' | tr '[:upper:]' '[:lower:]')
  local file="$ACCOUNTS_DIR/${name}.json"
  if [[ ! -f "$file" ]]; then
    echo -e "${RED}Profile '$name' not found.${NC}"
    return 1
  fi

  echo "$label" > "$ACCOUNTS_DIR/${name}.label"
  echo -e "${GREEN}✓${NC} Labeled ${BOLD}$name${NC} as ${CYAN}$label${NC}"

  log_activity "account-renamed" "name=$name" "label=$label"
}

cmd_priority() {
  local name="${1:-}"
  local priority="${2:-}"
  if [[ -z "$name" || -z "$priority" ]]; then
    echo -e "${RED}Usage: vdm priority <name> <n>${NC}"
    echo "  Sets an account's priority for the 'priority' rotation strategy."
    echo "  Higher number = preferred first; 0 (default) clears it."
    echo "  Example: vdm priority work-account 10"
    return 1
  fi

  name=$(echo "$name" | tr ' ' '-' | tr '[:upper:]' '[:lower:]')
  if [[ ! "$priority" =~ ^-?[0-9]+$ ]]; then
    echo -e "${RED}Priority must be an integer (e.g. 10, 0, -1).${NC}"
    return 1
  fi
  local file="$ACCOUNTS_DIR/${name}.json"
  if [[ ! -f "$file" ]]; then
    echo -e "${RED}Profile '$name' not found.${NC}"
    return 1
  fi

  # Prefer the dashboard API (writes the sidecar AND invalidates the account
  # cache so the change takes effect immediately); fall back to a direct write.
  local resp=""
  if curl -s --max-time 2 "http://localhost:$DASHBOARD_PORT/health" >/dev/null 2>&1; then
    resp=$(curl -s --max-time 2 -X POST "http://localhost:$DASHBOARD_PORT/api/priority" \
      -H "Content-Type: application/json" \
      -d "{\"name\":\"$name\",\"priority\":$priority}" 2>/dev/null) || true
  fi
  if [[ -z "$resp" ]]; then
    # Dashboard not running — write the sidecar directly.
    if [[ "$priority" == "0" ]]; then
      rm -f "$ACCOUNTS_DIR/${name}.priority"
    else
      echo "$priority" > "$ACCOUNTS_DIR/${name}.priority"
    fi
  fi

  echo -e "${GREEN}✓${NC} Set priority of ${BOLD}$name${NC} to ${CYAN}$priority${NC}"
}

# Enable/disable an account for rotation WITHOUT removing it (sidecar `.disabled`).
cmd_set_enabled() {
  local name="${1:-}" enabled="$2" verb="$3"
  if [[ -z "$name" ]]; then
    echo -e "${RED}Usage: vdm $verb <name>${NC}"
    echo "  Excludes/includes an account from rotation without removing it."
    return 1
  fi
  name=$(echo "$name" | tr ' ' '-' | tr '[:upper:]' '[:lower:]')
  if [[ ! -f "$ACCOUNTS_DIR/${name}.json" ]]; then
    echo -e "${RED}Profile '$name' not found.${NC}"
    return 1
  fi
  # Prefer the dashboard API (invalidates the account cache so the change takes
  # effect immediately); fall back to a direct sidecar write.
  local resp=""
  if curl -s --max-time 2 "http://localhost:$DASHBOARD_PORT/health" >/dev/null 2>&1; then
    resp=$(curl -s --max-time 2 -X POST "http://localhost:$DASHBOARD_PORT/api/account-enabled" \
      -H "Content-Type: application/json" \
      -d "{\"name\":\"$name\",\"enabled\":$enabled}" 2>/dev/null) || true
  fi
  if [[ -z "$resp" ]]; then
    if [[ "$enabled" == "false" ]]; then : > "$ACCOUNTS_DIR/${name}.disabled"; else rm -f "$ACCOUNTS_DIR/${name}.disabled"; fi
  fi
  if [[ "$enabled" == "false" ]]; then
    echo -e "${YELLOW}✓${NC} Disabled ${BOLD}$name${NC} ${DIM}(excluded from rotation, not removed)${NC}"
  else
    echo -e "${GREEN}✓${NC} Enabled ${BOLD}$name${NC}"
  fi
}

cmd_disable() { cmd_set_enabled "${1:-}" false disable; }
cmd_enable()  { cmd_set_enabled "${1:-}" true  enable; }

cmd_list() {
  local active_fp
  active_fp=$(get_active_fingerprint 2>/dev/null) || active_fp=""

  local profiles=("$ACCOUNTS_DIR"/*.json)
  if [[ ! -f "${profiles[0]:-}" ]]; then
    echo -e "${YELLOW}No saved profiles. Use 'vdm add <name>' to save the current account.${NC}"
    return 0
  fi

  echo ""
  echo -e "${BOLD}  Van Damme-o-Matic Accounts${NC}"
  echo -e "  ─────────────────────────────────────────────"

  for file in "${profiles[@]}"; do
    local name=$(basename "$file" .json)
    local fp=$(get_profile_fingerprint "$file" 2>/dev/null)
    local info=$(get_profile_info "$file" 2>/dev/null)
    local sub_type=$(echo "$info" | cut -d'|' -f1)
    local tier=$(echo "$info" | cut -d'|' -f2)
    local expires=$(echo "$info" | cut -d'|' -f3)
    local label_file="$ACCOUNTS_DIR/${name}.label"
    local label=""
    [[ -f "$label_file" ]] && label=$(cat "$label_file")
    local priority_file="$ACCOUNTS_DIR/${name}.priority"
    local priority=""
    [[ -f "$priority_file" ]] && priority=$(cat "$priority_file")

    if [[ "$fp" == "$active_fp" ]]; then
      echo -e "  ${GREEN}▸ ${BOLD}$name${NC}  $(format_sub_type "$sub_type")  ${GREEN}← active${NC}"
    else
      echo -e "    ${BOLD}$name${NC}  $(format_sub_type "$sub_type")"
    fi
    if [[ -n "$label" ]]; then
      echo -e "      ${DIM}$label${NC}"
    fi
    echo -e "      ${DIM}tier: $tier  expires: $expires${NC}"
    if [[ -n "$priority" && "$priority" != "0" ]]; then
      echo -e "      ${DIM}priority: $priority${NC}"
    fi
    local blocked=$(get_block_state "$fp" "$name")
    if [[ -n "$blocked" ]]; then
      echo -e "      ${YELLOW}non selezionabile: $blocked${NC}"
    fi
    local paused=$(helper model-blocks "$SCRIPT_DIR/model-blocks.json" "$name" 2>/dev/null)
    if [[ -n "$paused" ]]; then
      echo -e "      ${DIM}in pausa solo per: $paused (gli altri modelli restano)${NC}"
    fi
  done

  echo ""
}

cmd_switch() {
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    # Interactive mode: show numbered list
    local profiles=("$ACCOUNTS_DIR"/*.json)
    if [[ ! -f "${profiles[0]:-}" ]]; then
      echo -e "${YELLOW}No saved profiles. Use 'vdm add <name>' to save the current account.${NC}"
      return 1
    fi

    local active_fp
    active_fp=$(get_active_fingerprint 2>/dev/null) || active_fp=""

    echo ""
    echo -e "${BOLD}  Select account:${NC}"
    echo ""

    local i=1
    local names=()
    for file in "${profiles[@]}"; do
      local pname=$(basename "$file" .json)
      names+=("$pname")
      local fp=$(get_profile_fingerprint "$file" 2>/dev/null)
      local info=$(get_profile_info "$file" 2>/dev/null)
      local sub_type=$(echo "$info" | cut -d'|' -f1)
      local label_file="$ACCOUNTS_DIR/${pname}.label"
      local label=""
      [[ -f "$label_file" ]] && label=" ${DIM}($( cat "$label_file"))${NC}"

      if [[ "$fp" == "$active_fp" ]]; then
        echo -e "  ${GREEN}$i)${NC} ${BOLD}$pname${NC}  $(format_sub_type "$sub_type")${label}  ${GREEN}← active${NC}"
      else
        echo -e "  $i) ${BOLD}$pname${NC}  $(format_sub_type "$sub_type")${label}"
      fi
      ((i++))
    done

    echo ""
    read -rp "  Enter number (or q to cancel): " choice

    if [[ "$choice" == "q" || -z "$choice" ]]; then
      echo "  Cancelled."
      return 0
    fi

    if [[ "$choice" -ge 1 && "$choice" -le "${#names[@]}" ]] 2>/dev/null; then
      name="${names[$((choice-1))]}"
    else
      echo -e "  ${RED}Invalid choice.${NC}"
      return 1
    fi
  fi

  name=$(echo "$name" | tr ' ' '-' | tr '[:upper:]' '[:lower:]')
  local file="$ACCOUNTS_DIR/${name}.json"

  if [[ ! -f "$file" ]]; then
    echo -e "${RED}Profile '$name' not found.${NC}"
    echo "Available profiles:"
    ls "$ACCOUNTS_DIR"/*.json 2>/dev/null | xargs -I{} basename {} .json | sed 's/^/  /'
    return 1
  fi

  # Check if already active
  local active_fp=$(get_active_fingerprint 2>/dev/null)
  local target_fp=$(get_profile_fingerprint "$file" 2>/dev/null)
  if [[ "$active_fp" == "$target_fp" ]]; then
    echo -e "${YELLOW}Already on profile '$name'.${NC}"
    return 0
  fi

  # The path, not the contents: the credential blob never enters a shell
  # variable, a process listing, or the shell history.
  if ! write_keychain_from_file "$file"; then
    echo -e "${RED}Could not write the credentials. Nothing was changed.${NC}" >&2
    return 1
  fi

  local info=$(get_profile_info "$file" 2>/dev/null)
  local sub_type=$(echo "$info" | cut -d'|' -f1)
  local label_file="$ACCOUNTS_DIR/${name}.label"
  local label=""
  [[ -f "$label_file" ]] && label=$(cat "$label_file")

  echo -e "${GREEN}✓${NC} Switched to ${BOLD}$name${NC}  $(format_sub_type "$sub_type")"
  echo -e "${DIM}  All Claude Code sessions will use this account on their next API call.${NC}"

  log_activity "manual-switch" "to=${label:-$name}"
}

cmd_remove() {
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    echo -e "${RED}Usage: vdm remove <name>${NC}"
    return 1
  fi

  name=$(echo "$name" | tr ' ' '-' | tr '[:upper:]' '[:lower:]')
  local file="$ACCOUNTS_DIR/${name}.json"

  if [[ ! -f "$file" ]]; then
    echo -e "${RED}Profile '$name' not found.${NC}"
    return 1
  fi

  rm -f "$file" "$ACCOUNTS_DIR/${name}.label"
  echo -e "${GREEN}✓${NC} Removed profile ${BOLD}$name${NC}"
}

cmd_status() {
  local creds
  creds=$(read_keychain 2>/dev/null) || {
    echo -e "${RED}No active Claude Code credentials found. Run 'claude auth login' first.${NC}"
    return 1
  }

  local active_fp=$(get_active_fingerprint 2>/dev/null)

  # Find matching profile
  local active_name="(not saved)"
  for file in "$ACCOUNTS_DIR"/*.json; do
    [[ -f "$file" ]] || continue
    local fp=$(get_profile_fingerprint "$file" 2>/dev/null)
    if [[ "$fp" == "$active_fp" ]]; then
      active_name=$(basename "$file" .json)
      break
    fi
  done

  local info
  info=$(helper active-info 2>/dev/null)

  local sub_type=$(echo "$info" | cut -d'|' -f1)
  local tier=$(echo "$info" | cut -d'|' -f2)
  local expires=$(echo "$info" | cut -d'|' -f3)
  local scopes=$(echo "$info" | cut -d'|' -f4)

  # Fetch email
  local token
  token=$(helper active-token 2>/dev/null)
  local email=""
  if [[ -n "$token" ]]; then
    email=$(fetch_account_email "$token")
  fi

  echo ""
  echo -e "${BOLD}  Active Account${NC}"
  echo -e "  ────────────────────────────────"
  if [[ -n "$email" ]]; then
    echo -e "  Email:    ${CYAN}$email${NC}"
  fi
  # Only show profile name if it's a meaningful user-given name (not auto-generated)
  if [[ ! "$active_name" =~ ^auto-[0-9]+$ && "$active_name" != "(not saved)" ]]; then
    echo -e "  Profile:  ${BOLD}$active_name${NC}"
  fi
  echo -e "  Plan:     $(format_sub_type "$sub_type")"
  echo -e "  Tier:     $tier"
  echo -e "  Expires:  $expires"
  echo -e "  Scopes:   ${DIM}$scopes${NC}"
  local active_blocked=$(get_block_state "$(get_active_fingerprint 2>/dev/null)" "$active_name")
  if [[ -n "$active_blocked" ]]; then
    echo -e "  ${YELLOW}Bloccato: $active_blocked${NC}"
  fi

  # Show proxy/auto-switch status
  local proxy_on=$(get_config_value "proxyEnabled")
  local auto_on=$(get_config_value "autoSwitch")
  local strategy=$(get_config_string "rotationStrategy")
  local interval=$(get_config_string "rotationIntervalMin")
  local notifs=$(get_config_value "notifications")
  echo ""
  echo -e "  ${BOLD}Settings${NC}"
  echo -e "  ────────────────────────────────"
  if is_true "$proxy_on"; then
    echo -e "  Proxy:         ${GREEN}ON${NC}"
  else
    echo -e "  Proxy:         ${DIM}OFF${NC}"
  fi
  if is_true "$auto_on"; then
    echo -e "  Auto-switch:   ${GREEN}ON${NC}"
  else
    echo -e "  Auto-switch:   ${DIM}OFF${NC}"
  fi
  if is_true "$notifs"; then
    echo -e "  Notifications: ${GREEN}ON${NC}"
  else
    echo -e "  Notifications: ${DIM}OFF${NC}"
  fi
  echo -e "  Rotation:      ${CYAN}${strategy:-sticky}${NC}"
  if [[ "${strategy:-sticky}" == "round-robin" ]]; then
    echo -e "  Interval:      ${interval:-60} min"
  fi
  if [[ "${strategy:-sticky}" == "balance" ]]; then
    local cap=$(get_config_string "maxConcurrentPerAccount")
    echo -e "  Max/account:   ${cap:-8} in-flight"
    # Live in-flight spread from a running dashboard, if reachable
    local pstatus
    pstatus=$(curl -s --max-time 2 "http://localhost:$DASHBOARD_PORT/api/proxy-status" 2>/dev/null) || true
    if [[ -n "$pstatus" ]]; then
      echo "$pstatus" | helper format-balance 2>/dev/null || true
    fi
  fi

  # Version
  if [[ -f "$SCRIPT_DIR/.version" ]]; then
    echo -e "  Version:       ${DIM}$(cat "$SCRIPT_DIR/.version")${NC}"
  fi
  echo ""
}

cmd_config() {
  local key="${1:-}"
  local value="${2:-}"

  if [[ -z "$key" ]]; then
    # Show current config
    echo ""
    echo -e "${BOLD}  Settings${NC}"
    echo -e "  ────────────────────────────────"
    local proxy_on=$(get_config_value "proxyEnabled")
    local auto_on=$(get_config_value "autoSwitch")
    local strategy=$(get_config_string "rotationStrategy")
    local interval=$(get_config_string "rotationIntervalMin")
    if is_true "$proxy_on"; then
      echo -e "  proxyEnabled:       ${GREEN}on${NC}"
    else
      echo -e "  proxyEnabled:       ${DIM}off${NC}"
    fi
    if is_true "$auto_on"; then
      echo -e "  autoSwitch:         ${GREEN}on${NC}"
    else
      echo -e "  autoSwitch:         ${DIM}off${NC}"
    fi
    local notifs=$(get_config_value "notifications")
    if is_true "$notifs"; then
      echo -e "  notifications:      ${GREEN}on${NC}"
    else
      echo -e "  notifications:      ${DIM}off${NC}"
    fi
    echo -e "  rotationStrategy:   ${CYAN}${strategy:-sticky}${NC}"
    echo -e "  rotationIntervalMin: ${interval:-60}"
    local serialize=$(get_config_value "serializeRequests")
    if is_true "$serialize"; then
      echo -e "  serializeRequests:  ${GREEN}on${NC}  ${DIM}[BETA]${NC}"
    else
      echo -e "  serializeRequests:  ${DIM}off${NC}  ${DIM}[BETA]${NC}"
    fi
    local delay=$(get_config_string "serializeDelayMs")
    echo -e "  serializeDelayMs:   ${delay:-200}  ${DIM}[BETA]${NC}"
    local maxconc=$(get_config_string "maxConcurrentPerAccount")
    if [[ "$strategy" == "balance" ]]; then
      echo -e "  maxConcurrentPerAccount: ${GREEN}${maxconc:-8}${NC}  ${DIM}[BETA] per-account in-flight cap${NC}"
    else
      echo -e "  maxConcurrentPerAccount: ${maxconc:-8}  ${DIM}[BETA] (only used by rotation=balance)${NC}"
    fi
    local commit_tokens=$(get_config_value "commitTokenUsage")
    if is_true "$commit_tokens"; then
      echo -e "  commitTokenUsage:   ${GREEN}on${NC}"
    else
      echo -e "  commitTokenUsage:   ${DIM}off${NC}"
    fi
    echo ""
    echo -e "  ${DIM}Usage: vdm config <key> <value>${NC}"
    echo -e "  ${DIM}  vdm config proxy on${NC}"
    echo -e "  ${DIM}  vdm config autoswitch off${NC}"
    echo -e "  ${DIM}  vdm config notifications off${NC}"
    echo -e "  ${DIM}  vdm config rotation sticky|conserve|round-robin|spread|drain-first|balance${NC}"
    echo -e "  ${DIM}  vdm config interval 15|30|60|120${NC}"
    echo -e "  ${DIM}  vdm config max-concurrent 1-50${NC}  ${DIM}[BETA] per-account cap for rotation=balance${NC}"
    echo -e "  ${DIM}  vdm config serialize on|off${NC}  ${DIM}[BETA]${NC}"
    echo -e "  ${DIM}  vdm config serialize-delay 0|100|200|500|1000${NC}  ${DIM}[BETA]${NC}"
    echo -e "  ${DIM}  vdm config commit-tokens on|off${NC}"
    return 0
  fi

  # Normalize key
  local is_bool=true
  case "$key" in
    proxy|proxyEnabled|proxy-enabled)       key="proxyEnabled" ;;
    autoswitch|autoSwitch|auto-switch)    key="autoSwitch" ;;
    notifications|notifs)                 key="notifications" ;;
    rotation|rotationStrategy|strategy)   key="rotationStrategy"; is_bool=false ;;
    interval|rotationIntervalMin)         key="rotationIntervalMin"; is_bool=false ;;
    serialize|serializeRequests|serialize-requests) key="serializeRequests" ;;
    serialize-delay|serializeDelayMs|serialize-delay-ms) key="serializeDelayMs"; is_bool=false ;;
    max-concurrent|maxConcurrentPerAccount|max-concurrent-per-account) key="maxConcurrentPerAccount"; is_bool=false ;;
    commit-tokens|commitTokenUsage|commit-token-usage) key="commitTokenUsage" ;;
    *)
      echo -e "${RED}Unknown setting: $key${NC}"
      echo "  Available: proxy, autoswitch, notifications, rotation, interval, max-concurrent, serialize, serialize-delay, commit-tokens"
      return 1
      ;;
  esac

  if [[ -z "$value" ]]; then
    if [[ "$is_bool" == "true" ]]; then
      local current=$(get_config_value "$key")
      echo "$key = $current"
    else
      local current=$(get_config_string "$key")
      echo "$key = $current"
    fi
    return 0
  fi

  if [[ "$is_bool" == "true" ]]; then
    # Boolean setting
    # JSON booleans, lowercase. These used to be the Python literals True/False
    # because the value was pasted into Python source; written to config.json as
    # such they became the STRINGS "True"/"False", which are both truthy in JS —
    # so `vdm config proxy off` read back as on.
    case "$value" in
      on|true|1|yes)   value="true" ;;
      off|false|0|no)  value="false" ;;
      *)
        echo -e "${RED}Invalid value: $value${NC}  (use on/off)"
        return 1
        ;;
    esac
    set_config_value "$key" "$value"
    if [[ "$value" == "true" ]]; then
      echo -e "${GREEN}✓${NC} ${BOLD}$key${NC} = ${GREEN}on${NC}"
    else
      echo -e "${GREEN}✓${NC} ${BOLD}$key${NC} = ${DIM}off${NC}"
    fi
  elif [[ "$key" == "rotationStrategy" ]]; then
    case "$value" in
      sticky|conserve|round-robin|spread|drain-first|balance|priority) ;;
      *)
        echo -e "${RED}Invalid strategy: $value${NC}"
        echo "  Options: sticky, conserve, round-robin, spread, drain-first, balance, priority"
        return 1
        ;;
    esac
    set_config_string "$key" "$value"
    echo -e "${GREEN}✓${NC} ${BOLD}$key${NC} = ${CYAN}$value${NC}"
    if [[ "$value" == "balance" ]]; then
      local cap=$(get_config_string "maxConcurrentPerAccount")
      echo -e "  ${DIM}Spreading load across accounts, max ${cap:-8} in-flight each. Tune: vdm config max-concurrent N${NC}"
    fi
  elif [[ "$key" == "rotationIntervalMin" ]]; then
    case "$value" in
      15|30|60|120) ;;
      *)
        echo -e "${RED}Invalid interval: $value${NC}  (use 15, 30, 60, or 120)"
        return 1
        ;;
    esac
    set_config_number "$key" "$value"
    echo -e "${GREEN}✓${NC} ${BOLD}$key${NC} = ${CYAN}${value} min${NC}"
  elif [[ "$key" == "serializeDelayMs" ]]; then
    case "$value" in
      0|100|200|500|1000|2000) ;;
      *)
        echo -e "${RED}Invalid delay: $value${NC}  (use 0, 100, 200, 500, 1000, or 2000)"
        return 1
        ;;
    esac
    set_config_number "$key" "$value"
    echo -e "${GREEN}✓${NC} ${BOLD}$key${NC} = ${CYAN}${value} ms${NC}"
  elif [[ "$key" == "maxConcurrentPerAccount" ]]; then
    if ! [[ "$value" =~ ^[0-9]+$ ]] || (( value < 1 || value > 50 )); then
      echo -e "${RED}Invalid value: $value${NC}  (use a number 1-50)"
      return 1
    fi
    set_config_number "$key" "$value"
    echo -e "${GREEN}✓${NC} ${BOLD}$key${NC} = ${CYAN}${value}${NC}  ${DIM}concurrent in-flight per account${NC}"
  fi

  # Apply live to a running dashboard so the change takes effect without a restart.
  apply_setting_live "$key"

  log_activity "settings-changed" "$key=$value"
}

cmd_dashboard() {
  local action="${1:-start}"

  case "$action" in
    stop)
      # Try PID file first, then fall back to port-based detection
      local stopped=false
      if [[ -f "$DASHBOARD_PID_FILE" ]]; then
        local pid=$(cat "$DASHBOARD_PID_FILE")
        if kill "$pid" 2>/dev/null; then
          stopped=true
        fi
        rm -f "$DASHBOARD_PID_FILE"
      fi
      if [[ "$stopped" != "true" ]]; then
        # Find by port
        local pid
        pid=$(helper port-pid "$DASHBOARD_PORT" 2>/dev/null) || true
        if [[ -n "$pid" ]]; then
          kill "$pid" 2>/dev/null
          stopped=true
        fi
      fi
      if [[ "$stopped" == "true" ]]; then
        echo -e "${GREEN}✓${NC} Dashboard stopped."
      else
        echo -e "${YELLOW}Dashboard was not running.${NC}"
      fi
      ;;
    start|"")
      # Check if already running (by PID file or port)
      if [[ -f "$DASHBOARD_PID_FILE" ]]; then
        local pid=$(cat "$DASHBOARD_PID_FILE")
        if kill -0 "$pid" 2>/dev/null; then
          echo -e "${YELLOW}Dashboard already running at http://localhost:$DASHBOARD_PORT${NC}"
          echo -e "${DIM}Use 'vdm dashboard stop' to stop it.${NC}"
          return 0
        fi
        rm -f "$DASHBOARD_PID_FILE"
      fi
      # Also check by port
      if helper port-busy "$DASHBOARD_PORT" 2>/dev/null; then
        echo -e "${YELLOW}Dashboard already running at http://localhost:$DASHBOARD_PORT${NC}"
        echo -e "${DIM}Use 'vdm dashboard stop' to stop it.${NC}"
        return 0
      fi

      echo -e "${BLUE}Starting dashboard on http://localhost:$DASHBOARD_PORT${NC}"
      node "$SCRIPT_DIR/dashboard.mjs" &
      local pid=$!
      echo "$pid" > "$DASHBOARD_PID_FILE"

      # Wait a moment then open
      sleep 0.5
      if kill -0 "$pid" 2>/dev/null; then
        echo -e "${GREEN}✓${NC} Dashboard running (PID $pid)"
        echo -e "  Dashboard: ${CYAN}http://localhost:$DASHBOARD_PORT${NC}"
        echo -e "  API Proxy: ${CYAN}http://localhost:$PROXY_PORT${NC}"
        open "http://localhost:$DASHBOARD_PORT" 2>/dev/null || echo -e "  Open http://localhost:$DASHBOARD_PORT in your browser"
      else
        echo -e "${RED}Dashboard failed to start. Check Node.js is installed.${NC}"
        rm -f "$DASHBOARD_PID_FILE"
        return 1
      fi
      ;;
    *)
      echo -e "${RED}Usage: vdm dashboard [start|stop]${NC}"
      ;;
  esac
}

cmd_upgrade() {
  # This fork, not upstream. Pointing upgrade at loekj/claude-acct-switcher
  # would replace every patched file with the unpatched original — which is
  # exactly the failure this fork exists to stop repeating.
  local REPO_URL="${VDM_REPO_URL:-https://github.com/loekj/claude-acct-switcher.git}"
  local tmpdir
  tmpdir=$(mktemp -d)
  # Ensure cleanup on any exit from this function
  trap "rm -rf '$tmpdir'" RETURN

  echo ""
  echo -e "${BOLD}  Upgrading Van Damme-o-Matic…${NC}"
  echo ""

  # Fetch latest from remote
  echo -e "  ${DIM}Fetching latest version…${NC}"
  if ! git clone --depth 1 "$REPO_URL" "$tmpdir" 2>/dev/null; then
    echo -e "  ${RED}Failed to fetch from $REPO_URL${NC}"
    return 1
  fi
  # Shallow clone may miss tags — fetch them explicitly
  git -C "$tmpdir" fetch --tags --quiet 2>/dev/null || true

  # Compare versions (prefer semver tag, fall back to commit hash)
  local current_hash=""
  if [[ -f "$SCRIPT_DIR/.version" ]]; then
    current_hash=$(cat "$SCRIPT_DIR/.version")
  fi
  local latest_hash
  latest_hash=$(git -C "$tmpdir" describe --tags --abbrev=0 2>/dev/null \
    || git -C "$tmpdir" rev-parse --short HEAD 2>/dev/null)

  if [[ -n "$current_hash" && "$current_hash" == "$latest_hash" ]]; then
    echo -e "  ${GREEN}✓${NC} Already on the latest version (${DIM}$current_hash${NC})"
    return 0
  fi

  # Verify the fetched repo has the files we need
  for f in vdm dashboard.mjs lib.mjs platform.mjs vdm-helper.mjs install-hooks.sh; do
    if [[ ! -f "$tmpdir/$f" ]]; then
      echo -e "  ${RED}Fetched repo is missing $f — aborting.${NC}"
      return 1
    fi
  done

  # Check if dashboard is running (PID file or listening on port)
  local dashboard_was_running=false
  if [[ -f "$DASHBOARD_PID_FILE" ]] && kill -0 "$(cat "$DASHBOARD_PID_FILE")" 2>/dev/null; then
    dashboard_was_running=true
  elif helper port-busy "$DASHBOARD_PORT" 2>/dev/null; then
    dashboard_was_running=true
  fi

  # Stop dashboard before overwriting files
  if [[ "$dashboard_was_running" == "true" ]]; then
    echo -e "  ${DIM}Stopping dashboard…${NC}"
    cmd_dashboard stop
    # Also kill any process on the port not tracked by PID file (e.g. shell auto-start)
    local port_pid
    port_pid=$(helper port-pid "$DASHBOARD_PORT" 2>/dev/null) || true
    if [[ -n "$port_pid" ]]; then
      kill "$port_pid" 2>/dev/null || true
    fi
  fi

  # Overwrite only code files — never touch accounts/, config.json,
  # activity-log.json, .label files, or any other user data.
  echo -e "  ${DIM}Updating files…${NC}"
  cp "$tmpdir/vdm"               "$SCRIPT_DIR/vdm"
  cp "$tmpdir/dashboard.mjs"     "$SCRIPT_DIR/dashboard.mjs"
  cp "$tmpdir/lib.mjs"           "$SCRIPT_DIR/lib.mjs"
  cp "$tmpdir/platform.mjs"      "$SCRIPT_DIR/platform.mjs"
  cp "$tmpdir/vdm-helper.mjs"    "$SCRIPT_DIR/vdm-helper.mjs"
  cp "$tmpdir/install-hooks.sh"  "$SCRIPT_DIR/install-hooks.sh"
  # A missing platform.mjs would leave dashboard.mjs unable to start at all, so
  # the copy list and this check must stay in step with the import graph.
  chmod +x "$SCRIPT_DIR/vdm" 2>/dev/null || true

  # Write version marker
  echo "$latest_hash" > "$SCRIPT_DIR/.version"

  # [BETA] Install hooks if not yet present
  if [[ -f "$SCRIPT_DIR/install-hooks.sh" ]]; then
    source "$SCRIPT_DIR/install-hooks.sh"
    install_beta_hooks && echo -e "  ${GREEN}✓${NC} [BETA] Token tracking hooks installed" || true
  fi

  # Restart dashboard if it was running
  if [[ "$dashboard_was_running" == "true" ]]; then
    echo -e "  ${DIM}Restarting dashboard…${NC}"
    cmd_dashboard start
  fi

  echo ""
  if [[ -n "$current_hash" ]]; then
    echo -e "  ${GREEN}✓${NC} Upgraded ${DIM}$current_hash${NC} → ${BOLD}$latest_hash${NC}"
  else
    echo -e "  ${GREEN}✓${NC} Upgraded to ${BOLD}$latest_hash${NC}"
  fi
  echo ""

  log_activity "upgrade" "from=${current_hash:-unknown}" "to=$latest_hash"
}

cmd_tokens() {
  # [BETA] Token usage tracking
  local repo=""
  local branch=""
  local days=1
  local per_commit=false

  # Parse args
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo)     repo="$2"; shift 2 ;;
      --branch)   branch="$2"; shift 2 ;;
      --days)     days="$2"; shift 2 ;;
      --per-commit) per_commit=true; shift ;;
      *)          shift ;;
    esac
  done

  # Auto-detect repo from cwd if not specified
  if [[ -z "$repo" ]]; then
    repo=$(git rev-parse --show-toplevel 2>/dev/null) || true
  fi

  local since=$(( ($(date +%s) - days * 86400) * 1000 ))

  # Build URL
  local url="http://localhost:$DASHBOARD_PORT/api/token-usage?since=$since"
  if [[ -n "$repo" ]]; then
    url="${url}&repo=$(helper urlencode "$repo" 2>/dev/null)"
  fi
  if [[ -n "$branch" ]]; then
    url="${url}&branch=$(helper urlencode "$branch" 2>/dev/null)"
  fi

  local usage
  usage=$(curl -s --max-time 5 "$url" 2>/dev/null) || {
    echo -e "${RED}Could not connect to dashboard. Is it running?${NC}"
    return 1
  }

  if [[ "$per_commit" == "true" && -n "$repo" ]]; then
    # Per-commit breakdown
    echo ""
    echo -e "${BOLD}  Token Usage per Commit  ${DIM}[BETA]${NC}"
    echo -e "  ────────────────────────────────────────────"
    if [[ -n "$repo" ]]; then
      echo -e "  ${DIM}Repo: $repo${NC}"
    fi
    echo ""

    printf '%s' "$usage" | helper usage-per-commit "$repo" 2>/dev/null
    echo ""
    return 0
  fi

  # Standard summary view
  echo ""
  echo -e "${BOLD}  Token Usage Summary  ${DIM}[BETA]${NC}"
  echo -e "  ────────────────────────────────────────────"
  if [[ -n "$repo" ]]; then
    echo -e "  ${DIM}Repo: $repo${NC}"
  fi
  if [[ -n "$branch" ]]; then
    echo -e "  ${DIM}Branch: $branch${NC}"
  fi
  echo -e "  ${DIM}Period: last $days day(s)${NC}"
  echo ""

  printf '%s' "$usage" | helper usage-summary 2>/dev/null
  echo ""
}

cmd_logs() {
  local filter="${1:-}"

  # Check if dashboard is running
  if ! curl -s --max-time 2 "http://localhost:$DASHBOARD_PORT/health" >/dev/null 2>&1; then
    echo -e "${RED}Dashboard is not running. Start it with: vdm dashboard${NC}"
    return 1
  fi

  echo -e "${BOLD}  Van Damme-o-Matic — Live Proxy Logs${NC}"
  echo -e "  ─────────────────────────────────────────────"
  if [[ -n "$filter" ]]; then
    echo -e "  ${DIM}Filter: $filter${NC}"
  fi
  echo -e "  ${DIM}Press Ctrl-C to stop${NC}"
  echo ""

  # Stream SSE logs, parse the JSON data lines, colorize by tag
  curl -s -N "http://localhost:$DASHBOARD_PORT/api/logs/stream" 2>/dev/null | while IFS= read -r line; do
    # SSE format: "data: {...}"
    if [[ "$line" == data:* ]]; then
      local json="${line#data: }"
      local log_line
      log_line=$(printf '%s' "$json" | helper format-log-line 2>/dev/null)
      if [[ -n "$log_line" ]]; then
        if [[ -z "$filter" ]] || echo "$log_line" | grep -qi "$filter" 2>/dev/null; then
          echo -e "  $log_line"
        fi
      fi
    fi
  done
}

