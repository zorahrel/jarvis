<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.jarvis.free-router</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>-u</string>
    <string>/Users/zorahrel/.claude/setup/bin/free-router</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>FREE_ROUTER_IDLE_EXIT_S</key><string>900</string>
    <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key><false/>
  <key>Sockets</key>
  <dict>
    <key>Listeners</key>
    <dict>
      <key>SockFamily</key><string>IPv4</string>
      <key>SockNodeName</key><string>127.0.0.1</string>
      <key>SockServiceName</key><string>18791</string>
      <key>SockType</key><string>stream</string>
    </dict>
  </dict>
  <key>StandardErrorPath</key><string>/Users/zorahrel/.claude/jarvis/logs/free-router.err.log</string>
  <key>StandardOutPath</key><string>/Users/zorahrel/.claude/jarvis/logs/free-router.out.log</string>
</dict>
</plist>
