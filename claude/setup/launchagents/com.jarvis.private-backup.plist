	<string>/tmp/jarvis-private-backup.err</string>
	<key>StandardOutPath</key>
	<string>/tmp/jarvis-private-backup.log</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>4</integer>
		<key>Minute</key>
		<integer>32</integer>
	</dict>
</dict>
</plist>
