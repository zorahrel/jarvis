#!/usr/bin/env python3
"""board-web — la board Armonia nel browser, con i messaggi in canna.

La board vive SOLO nel browser: niente finestra-app, niente PNG, niente pannello
nativo. Erano tre modi di guardare la stessa pagina, e due erano da mantenere per
sempre in cambio di niente. Qui i messaggi
proposti si leggono, si correggono e si mandano con un click. Nessun messaggio parte
senza quel click: l'invio passa da `openclaw message send`, che e' la stessa strada
di qualunque altro invio, quindi resta nei log e nei rate limit.

  board-web            avvia su http://127.0.0.1:3350
  board-web --port N   altra porta

Ascolta SOLO su 127.0.0.1: la board contiene nomi, numeri e contesto interno.
"""
import json, os, sys, datetime, subprocess, urllib.parse
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from board_core import load, save, days, minutes, now, sync  # noqa: E402

ORDER = {"bloccato": 0, "fermo": 1, "attivo": 2, "archiviato": 9}


def age(p):
    """da quanto e' ferma: 'dal' se l'ho scritto io, altrimenti l'ultimo segnale."""
    if p.get("dal"):
        return max(0, (datetime.date.today() - datetime.date.fromisoformat(p["dal"])).days)
    dv = p.get("derived") or {}
    v = [x for x in (days(dv.get("chat")), days(dv.get("push"))) if x is not None]
    return min(v) if v else None


def due(p):
    if not p.get("scadenza"):
        return None
    return (datetime.date.fromisoformat(p["scadenza"]) - datetime.date.today()).days


def state():
    """Board + outbox in una forma che la pagina puo' disegnare senza ricalcolare niente."""
    d = load()
    ppl = d["people"]
    todo = {}
    for p in d["projects"]:
        nx = p.get("next") or {}
        if nx.get("cosa") and nx.get("chi"):
            todo.setdefault(nx["chi"], []).append({
                "id": p["id"], "cosa": nx["cosa"], "stato": p["stato"],
                "eta": age(p), "scad": due(p), "aspetta": p.get("aspetta"),
                "dipende": (p.get("dopo") or None),
                "sync": minutes((p.get("derived") or {}).get("synced")),
            })
    # Attilio in cima (le sue sono le uniche che nessun altro puo' sbloccare), poi chi ha
    # la scadenza piu' vicina, poi chi ha la cosa piu' vecchia ferma. La scadenza batte
    # l'eta': una consegna fra due giorni conta piu' di una cosa ferma da tre settimane.
    def rank(k):
        if k == "attilio":
            return (0, -999, 0)
        sc = [t["scad"] for t in todo[k] if t["scad"] is not None]
        e = [t["eta"] for t in todo[k] if t["eta"] is not None]
        return (1, min(sc) if sc else 999, -(max(e) if e else 0))
    # il messaggio sta con i task di chi lo riceve: un messaggio letto lontano da cio'
    # che chiede e' un messaggio che si approva senza sapere cosa si sta approvando.
    ob = [m for m in d.get("outbox", []) if m["stato"] != "scartato"]
    per_persona = {m["a"]: m for m in ob}
    gruppi = [{
        "key": k, "nome": ppl.get(k, {}).get("nome", k),
        "cognome": ppl.get(k, {}).get("cognome"),
        "capo": ppl.get(ppl.get(k, {}).get("capo") or "", {}).get("nome"),
        "esterno": bool(ppl.get(k, {}).get("esterno")),
        "canale": ppl.get(k, {}).get("discord") and "discord" or None,
        "msg": per_persona.get(k),
        "pids": [t["id"] for t in todo[k]],
        # il piu' vecchio: un gruppo e' aggiornato quanto la sua riga piu' stantia
        "sync": (max([t["sync"] for t in todo[k] if t["sync"] is not None], default=None)),
        "task": sorted(todo[k], key=lambda t: (t["scad"] if t["scad"] is not None else 999,
                                               -(t["eta"] or 0))),
    } for k in sorted(todo, key=rank)]
    return {
        "gruppi": gruppi,
        "orfani": [m for m in ob if m["a"] not in todo],
        "people": ppl,
        "scartati": [m for m in d.get("outbox", []) if m["stato"] == "scartato"],
        "synced": minutes(d.get("_synced")),
        "aperte": sum(len(g["task"]) for g in gruppi),
    }


def send(entry):
    """Manda davvero. Ritorna (ok, dettaglio). Il dry-run e' una env, non un flag della UI:
    una spunta 'prova' in pagina si dimentica accesa e poi nessuno ha mandato niente."""
    cmd = ["openclaw", "message", "send", "--channel", entry["canale"],
           "--target", entry["target"], "-m", entry["testo"], "--json"]
    if os.environ.get("BOARD_DRY"):
        cmd.append("--dry-run")
    r = subprocess.run(cmd, capture_output=True, text=True, timeout=90)
    if r.returncode != 0:
        return False, (r.stderr or r.stdout or "").strip()[:400]
    try:
        out = json.loads(r.stdout)
        mid = out.get("messageId") or (out.get("result") or {}).get("messageId")
    except Exception:
        mid = None
    return True, mid or r.stdout.strip()[:200]


PAGE = r"""<!doctype html><html lang="it"><head><meta charset="utf-8">
