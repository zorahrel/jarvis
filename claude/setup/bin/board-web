<div id="orfani"></div><div id="scartati"></div>
<script>
const E=s=>String(s??"").replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));

function eta(t){
  if(t.scad!==null&&t.scad!==undefined)
    return `<span class="due${t.scad<=3?" hot":""}">${t.scad}g</span>`;
  if(t.eta===null||t.eta===undefined) return "";
  return `<span class="${t.eta>=14?"old":""}">${t.eta}g</span>`;
}

function fa(min){
  if(min===null||min===undefined) return "mai";
  if(min<1) return "ora";
  if(min<60) return min+"m fa";
  if(min<2880) return Math.floor(min/60)+"h fa";
  return Math.floor(min/1440)+"g fa";
}
function tempo(min,cls){
  return `<span class="upd ${cls||""}" data-min="${min===null||min===undefined?"":min}">agg. ${fa(min)}</span>`;
}

function carta(m){
  if(!m) return "";
  if(m.stato==="inviato")
    return `<div class="msg inviato" data-id="${E(m.id)}">
      <div class="why">${E(m.perche)}</div>
      <textarea disabled>${E(m.testo)}</textarea>
      <div class="act"><span class="esito">inviato ${
        E((m.inviato||"").slice(0,16).replace("T"," "))}</span></div></div>`;
  return `<div class="msg" data-id="${E(m.id)}">
      <div class="why">${E(m.perche)}</div>
      <textarea>${E(m.testo)}</textarea>
      <div class="act"><button class="go">Manda su ${E(m.canale)}</button>
        <button class="skip">Scarta</button><span class="esito"></span></div>
      <div class="scarto" hidden>
        <input placeholder="perche' lo scarti? (resta sulla board)">
        <button class="conf">Scarta</button><button class="ann">Annulla</button></div></div>`;
}

function blocco(g){
  return `<div class="blk${g.key==="attilio"?" me":""}" data-pids="${E((g.pids||[]).join(","))}">
      <div class="who">${E(g.nome)}${g.cognome?" "+E(g.cognome):""}<span class="n">${g.task.length}</span>${
        g.esterno?'<span class="ext">esterno</span>':""}${
        g.capo?`<span class="ext">riporta a ${E(g.capo)}</span>`:""}
        <span class="sp"></span>${tempo(g.sync, g.sync!==null&&g.sync>1440?"vecchio":"")}
        <button class="ref" title="riaggiorna solo le sue righe">&#8635;</button></div>
      <table>${g.task.map(t=>`<tr>
        <td class="p">${E(t.id)}${t.dipende?`<span class="dep">dopo ${E(t.dipende)}</span>`:""}</td>
        <td class="c">${E(t.cosa)}</td><td class="a">${eta(t)}</td></tr>`).join("")}</table>
      ${carta(g.msg)}
    </div>`;
}

function disegna(s){
  document.getElementById("sync").innerHTML =
    tempo(s.synced, s.synced!==null&&s.synced>1440?"vecchio":"") +
    ' <button class="ref tutto" title="riaggiorna tutta la board">&#8635;</button>';
  document.getElementById("sub").textContent =
    `${s.aperte} cose aperte · ${s.gruppi.length} persone · ${
      s.gruppi.filter(g=>g.msg&&g.msg.stato!=="inviato").length} messaggi da mandare`;
  document.getElementById("board").innerHTML = s.gruppi.map(blocco).join("");
  document.getElementById("orfani").innerHTML = s.orfani.length
    ? `<h2>Senza task sulla board</h2>` + s.orfani.map(m=>`
      <div class="blk"><div class="who">${E(s.people?.[m.a]?.nome||m.a)}</div>${carta(m)}</div>`).join("")
    : "";
  // scartati: restano visibili col motivo, altrimenti la stessa proposta ritorna fra un mese
  document.getElementById("scartati").innerHTML = s.scartati.length
    ? `<h2>Scartati</h2>` + s.scartati.map(m=>`
      <div class="msg scartato" data-id="${E(m.id)}">
        <div class="mh"><b>${E(s.people?.[m.a]?.nome||m.a)}</b>
          <span class="ch">${E((m.scartato_il||"").slice(0,10))}</span></div>
        <div class="motivo"><b>Perche' no:</b> ${E(m.motivo||"— (scartato senza motivo)")}</div>
        <div class="act"><button class="back">Rimetti in coda</button>
          <span class="esito"></span></div></div>`).join("")
    : "";
  t0 = Date.now();
}

// l'eta' scritta a schermo invecchia da sola: senza questo, "agg. ora" resta "agg. ora"
// per un'ora e la board mente proprio sul campo che serve a fidarsi di lei.
let t0 = Date.now();
function invecchia(){
  const passati = Math.floor((Date.now()-t0)/60000);
  document.querySelectorAll("[data-min]").forEach(el=>{
    const m = el.dataset.min===""?null:(+el.dataset.min+passati);
    el.textContent = "agg. "+fa(m);
    if(m!==null&&m>1440) el.classList.add("vecchio");
  });
}
setInterval(invecchia, 30000);

function cresci(t){ t.style.height="auto"; t.style.height=(t.scrollHeight+2)+"px"; }
async function carica(){
  disegna(await (await fetch("/api/state")).json());
  document.querySelectorAll("textarea").forEach(cresci);
}
document.addEventListener("input", e=>{ if(e.target.tagName==="TEXTAREA") cresci(e.target); });

async function outbox(card, body){
  const esito=card.querySelector(".esito"); esito.className="esito"; esito.textContent="…";
  const r=await fetch("/api/outbox",{method:"POST",headers:{"content-type":"application/json"},
    body:JSON.stringify({id:card.dataset.id, ...body})});
  const j=await r.json();
  if(j.ok) return carica();
  esito.className="esito err"; esito.textContent=j.errore||"non riuscito";
  card.querySelectorAll("button").forEach(x=>x.disabled=false);
}

document.addEventListener("click", async e=>{
  const b=e.target.closest("button"); if(!b) return;

  if(b.classList.contains("ref")){                       // ↻ globale o della persona
    const blk=b.closest(".blk");
    const pids=blk&&blk.dataset.pids?blk.dataset.pids.split(","):null;
    b.classList.add("gira"); b.disabled=true;
    const r=await fetch("/api/sync",{method:"POST",headers:{"content-type":"application/json"},
      body:JSON.stringify({pids})});
    const j=await r.json();
    if(!j.ok) alert("sync non riuscito: "+(j.errore||""));
    return carica();
  }

  const card=b.closest(".msg"); if(!card) return;

  if(b.classList.contains("skip")){                      // scarta: prima il motivo
    const box=card.querySelector(".scarto");
    box.hidden=false; box.querySelector("input").focus();
    return;
  }
  if(b.classList.contains("ann")){ card.querySelector(".scarto").hidden=true; return; }
  if(b.classList.contains("conf")){
    const inp=card.querySelector(".scarto input");
    const motivo=inp.value.trim();
    if(!motivo){ inp.focus(); inp.placeholder="scrivi il motivo: e' l'unica cosa che resta"; return; }
    card.querySelectorAll("button").forEach(x=>x.disabled=true);
    return outbox(card,{azione:"scarta", testo:card.querySelector("textarea").value, motivo});
  }
  if(b.classList.contains("back")){
    card.querySelectorAll("button").forEach(x=>x.disabled=true);
    return outbox(card,{azione:"riprendi"});
  }
  if(b.classList.contains("go")){
    if(!confirm("Mando questo messaggio adesso?")) return;
    card.querySelectorAll("button").forEach(x=>x.disabled=true);
    return outbox(card,{azione:"manda", testo:card.querySelector("textarea").value});
  }
});

document.addEventListener("keydown", e=>{
  if(e.target.matches(".scarto input")){
    if(e.key==="Enter") e.target.parentElement.querySelector(".conf").click();
    if(e.key==="Escape") e.target.parentElement.hidden=true;
  }
});

carica();
</script></body></html>"""


class H(BaseHTTPRequestHandler):
    def _send(self, code, body, ctype="application/json; charset=utf-8"):
        b = body if isinstance(body, bytes) else body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(b)))
        self.end_headers()
        self.wfile.write(b)

    def do_GET(self):
        path = urllib.parse.urlparse(self.path).path
        if path == "/":
            return self._send(200, PAGE, "text/html; charset=utf-8")
        if path == "/api/state":
            return self._send(200, json.dumps(state(), ensure_ascii=False))
        self._send(404, '{"errore":"non c\'e\'"}')

    def do_POST(self):
        path = urllib.parse.urlparse(self.path).path
        n = int(self.headers.get("Content-Length") or 0)
        req = json.loads(self.rfile.read(n) or b"{}")
        if path == "/api/sync":
            # pids assenti = tutta la board. Con i pids si aggiorna una card sola:
            # gh su un repo invece che su venti, e il resto della board resta com'e'.
            try:
                cnt, derive = sync(req.get("pids") or None)
            except Exception as e:
                return self._send(502, json.dumps({"ok": False, "errore": str(e)[:300]},
                                                  ensure_ascii=False))
            return self._send(200, json.dumps({"ok": True, "n": cnt, "derive": derive},
                                              ensure_ascii=False))
        if path != "/api/outbox":
            return self._send(404, '{"errore":"non c\'e\'"}')
        d = load()
        m = next((x for x in d.get("outbox", []) if x["id"] == req.get("id")), None)
        if not m:
            return self._send(404, '{"ok":false,"errore":"messaggio sconosciuto"}')
        if m["stato"] == "inviato":
            return self._send(409, '{"ok":false,"errore":"gia\' inviato"}')
        # il testo mostrato a schermo e' quello che parte: se lo ha corretto, vale la correzione
        if req.get("testo"):
            m["testo"] = req["testo"]
        if req.get("azione") == "scarta":
            # il motivo non e' burocrazia: e' cio' che impedisce di riproporre a settembre
            # lo stesso messaggio che ad agosto era sbagliato.
            motivo = (req.get("motivo") or "").strip()
            if not motivo:
                return self._send(400, json.dumps({"ok": False, "errore": "serve il motivo"},
                                                  ensure_ascii=False))
            m["stato"] = "scartato"
            m["motivo"] = motivo
            m["scartato_il"] = now()
            save(d)
            return self._send(200, '{"ok":true}')
        if req.get("azione") == "riprendi":
            m["stato"] = "proposto"
            m["ripreso_il"] = now()
            save(d)
            return self._send(200, '{"ok":true}')
        ok, det = send(m)
        if not ok:
            save(d)  # la correzione al testo si tiene comunque
            return self._send(502, json.dumps({"ok": False, "errore": det}, ensure_ascii=False))
        if os.environ.get("BOARD_DRY"):
            # una prova che marca "inviato" e' peggio di nessuna prova: il messaggio
            # sparirebbe dalla coda senza che nessuno l'abbia ricevuto
            save(d)
            return self._send(200, json.dumps({"ok": False, "errore": "dry-run: non inviato"},
                                              ensure_ascii=False))
        m["stato"] = "inviato"
        m["inviato"] = datetime.datetime.now(datetime.UTC).isoformat()
        m["messageId"] = det
        save(d)
        self._send(200, json.dumps({"ok": True, "messageId": det}, ensure_ascii=False))

    def log_message(self, *a):
        pass


if __name__ == "__main__":
    port = 3350
    if "--port" in sys.argv:
        port = int(sys.argv[sys.argv.index("--port") + 1])
    srv = ThreadingHTTPServer(("127.0.0.1", port), H)
    print(f"board-web su http://127.0.0.1:{port}" + ("  [DRY-RUN]" if os.environ.get("BOARD_DRY") else ""))
    srv.serve_forever()
