#!/bin/bash
# Esegue lo script PowerShell letto da stdin sull'host Windows, via -EncodedCommand
# (fra ssh -> cmd -> powershell gli apici collassano: il base64 li salva).
# ProgressPreference spento: le barre di avanzamento escono su stderr come CLIXML.
set -euo pipefail
# Dati del PC: solo da ~/.config/winfleet/config.env (fuori da ogni repo). Se il file o la variabile
# mancano si esce con 3 e un messaggio, invece di proseguire con un host vuoto.
wfconf() {
  local v; v="$(set +eu; . "$HOME/.config/winfleet/config.env" >/dev/null 2>&1; printf '%s' "${!1:-}")"
  [ -n "$v" ] || { echo "${0##*/}: manca $1 in ~/.config/winfleet/config.env" >&2; return 3; }
  printf '%s' "$v"
}
HOST="${WIN_HOST:-$(wfconf HOST_SSH)}" || exit 3
script=$( { echo '$ProgressPreference="SilentlyContinue"'; cat; } )
b64=$(printf '%s' "$script" | python3 -c 'import sys,base64;sys.stdout.write(base64.b64encode(sys.stdin.read().encode("utf-16-le")).decode())')
ssh -o ConnectTimeout=10 "$HOST" "powershell -NoProfile -NonInteractive -EncodedCommand $b64" 2>/dev/null
