#!/usr/bin/env python3
# Rimette su una base locale i commit di un bundle cloud (pack già indicizzato con
# `git index-pack --fix-thin`): la base della VM è un commit «seed» che esiste solo là.
# Toglie la firma SSH (cambiando il genitore non varrebbe più), tiene autore, date e messaggio.
# Uso (dentro il repo): cloud-ricuci <seed-della-VM> <base-locale> <head-del-bundle>  -> stampa il nuovo head
import subprocess as sp, sys
seed, base, head = sys.argv[1:4]
git = lambda *a, inp=None: sp.run(["git", *a], input=inp, capture_output=True, check=True).stdout
base = git("rev-parse", base).decode().strip()
chain, c = [], head
while c != seed:
    chain.append(c)
    # cat-file e non rev-list: il genitore del primo commit (il seed) qui non esiste.
    parents = [l.split()[1] for l in git("cat-file", "commit", c).decode(errors="replace").split("\n\n", 1)[0].splitlines() if l.startswith("parent ")]
    if len(parents) != 1: sys.exit(f"{c[:9]}: {len(parents)} genitori, mi aspetto una catena lineare")
    c = parents[0]
prev_old, prev_new = seed, base
for c in reversed(chain):
    hdr, msg = git("cat-file", "commit", c).split(b"\n\n", 1)
    out, skip = [], False
    for l in hdr.split(b"\n"):
        if l.startswith(b"gpgsig "): skip = True; continue
        if skip and l.startswith(b" "): continue
        skip = False
        if l.startswith(b"parent "): l = b"parent " + prev_new.encode()
        out.append(l)
    prev_new = git("hash-object", "-t", "commit", "-w", "--stdin", inp=b"\n".join(out) + b"\n\n" + msg).decode().strip()
    print(c[:9], "->", prev_new[:9], file=sys.stderr)
print(prev_new)
