#!/usr/bin/env python3
"""Quota Muse vera (finestra 5h e settimana) e token per sessione di oggi.
Uso: muse-usage [testo]   con testo: solo le sessioni il cui transcript lo contiene (es. "LOTTO 1").
Fonti: sonda della tray (api.meta.ai) e ~/.local/share/muse/sessions/<oggi>/*/session.jsonl."""
import glob, json, os, re, sys, time

sys.path.insert(0, os.path.expanduser("~/Projects/claude-usage-tray/server"))
try:
    import muse_probe as m
    u = m.fetch_subs(m.read_token())["subs_usage"]
    fmt = lambda t: time.strftime("%d/%m %H:%M", time.localtime(t))
    print(f"quota: 5h {u['window']['used_percent']}% (reset {fmt(u['window']['resets_at'])}) · "
          f"settimana {u['weekly']['used_percent']}% (reset {fmt(u['weekly']['resets_at'])})")
except Exception as e:  # la sonda a volte non risponde: i token locali valgono lo stesso
    print(f"quota: non letta ({e})")

needle = sys.argv[1] if len(sys.argv) > 1 else None
day = time.strftime("%Y/%m/%d")
rows = []
for f in glob.glob(os.path.expanduser(f"~/.local/share/muse/sessions/{day}/*/session.jsonl")):
    text = open(f, errors="ignore").read()
    if needle and needle not in text:
        continue
    inp = cached = out = 0
    for mt in re.finditer(r'"usage":\s*(\{[^{}]*\})', text):
        try:
            d = json.loads(mt.group(1))
        except ValueError:
            continue
        inp += d.get("input_tokens", 0); cached += d.get("cached_tokens", 0); out += d.get("output_tokens", 0)
    d = os.path.dirname(f)
    rows.append((os.stat(d).st_birthtime, os.path.getmtime(f), os.path.basename(d)[:13], inp, cached, out))
for b, mt, sid, inp, cached, out in sorted(rows):
    print(f"{time.strftime('%H:%M', time.localtime(b))}-{time.strftime('%H:%M', time.localtime(mt))} {sid} "
          f"input {inp/1e6:.2f}M (non in cache {(inp-cached)/1e3:.0f}k) · output {out/1e3:.0f}k")
