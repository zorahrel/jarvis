def run(args, timeout=30):
    """stdout+stderr: codesign e tmutil parlano su stderr."""
    try:
        p = subprocess.run(args, capture_output=True, text=True, errors="replace", timeout=timeout)
        return p.stdout + p.stderr
    except Exception:
        return ""


def short(p):
    return str(p).replace(HOME, "~")


def gb(kb):
    if kb < 1048576:
        return f"{max(kb // 1024, 1)} MB"
    return f"{kb / 1048576:.1f} GB".replace(".", ",")


def num(n):
    return f"{n:,}".replace(",", ".")


def secs(t):
    """etime/time di ps: [[dd-]hh:]mm:ss[.cc]"""
    d = 0
    if "-" in t:
        d, t = t.split("-")
        d = int(d)
    p = [float(x) for x in t.split(":")]
    while len(p) < 3:
        p.insert(0, 0)
    return d * DAY + p[0] * 3600 + p[1] * 60 + p[2]


def is_apple_path(p):
    return p.startswith(psj.SYSTEM_PREFIXES) or "/System/Library/" in p


_signers = {}


def signer(path):
    """Chi ha firmato l'eseguibile. Solo su processi in esecuzione: codesign legge
    il binario e gli aggiorna l'atime, che e' proprio l'indizio delle app non usate."""
    if path in _signers:
        return _signers[path]
    out = run(["codesign", "-dvv", path], 20)
    if "not signed at all" in out:
        s = "non firmato"
    elif "Signature=adhoc" in out:
        s = "firma ad hoc"
    else:
        a = re.search(r"Authority=(.+)", out)
        a = a.group(1).strip() if a else ""
        if a == "Software Signing":
            s = "Apple"
        elif a.startswith("Apple Mac OS Application Signing"):
            s = "App Store"
        elif a.startswith("Developer ID Application: "):
            s = re.sub(r"\s*\([A-Z0-9]+\)$", "", a[len("Developer ID Application: "):])
        else:
            s = a or "firma illeggibile"
    _signers[path] = s
    return s


def trusted(sig):
    return sig not in ("non firmato", "firma ad hoc", "firma illeggibile")


