    """Scrivania, Documenti e Download li protegge macOS: dal gateway OpenClaw (node sotto
    launchd) la prima lettura puo' aprire una richiesta di permesso e restare appesa. Si prova
    in un processo a parte con un tempo massimo: il controllo non si pianta e dice cosa non ha visto."""
    try:
        return subprocess.run(["ls", path], capture_output=True, timeout=10).returncode == 0
    except Exception:
        return False


def du_scan(roots):
    """Una passata sola di du: cartelle fino a 3 livelli sotto la home e file oltre 500 MB a ogni
    profondita'. Mobile Documents e' iCloud: file solo in cloud o doppioni di Scrivania e Documenti."""
    dirs, big = {}, []
    depth0 = HOME.count("/")
    p = subprocess.Popen(["nice", "-n", "15", "du", "-axk", "-I", "Mobile Documents"] + roots, stdout=subprocess.PIPE,
                         stderr=subprocess.DEVNULL, text=True, errors="replace")
    for line in p.stdout:
        kb, _, path = line.rstrip("\n").partition("\t")
        try:
            kb = int(kb)
        except ValueError:
            continue
        if path.count("/") - depth0 <= 3:
            dirs[path] = kb
        if kb >= 512000:
            big.append((path, kb))
    p.wait()
    files = [(pth, kb) for pth, kb in big if os.path.isfile(pth)]
    return {k: v for k, v in dirs.items() if not os.path.isfile(k)}, sorted(files, key=lambda x: -x[1])


def top_folders(dirs, n=20):
    """Le cartelle a due livelli dalla home (~/Projects/x, ~/Library/y), come le si apre a mano,
    piu' le cartelle di primo livello senza sottocartelle. Col figlio piu' grosso quando pesa
    almeno il 40%: «Application Support» da sola non dice niente, «di cui BeeperTexts» si'."""
    d0 = HOME.count("/")
    kids = {}
    for p in dirs:
        kids.setdefault(os.path.dirname(p), []).append(p)
    cand = [p for p in dirs if p.count("/") - d0 == 2 or (p.count("/") - d0 == 1 and p not in kids)]
    out = []
    for p in sorted(cand, key=lambda p: -dirs[p])[:n]:
        k = max(kids.get(p, []), key=lambda c: dirs[c], default=None)
        out.append((p, dirs[p], (k, dirs[k]) if k and dirs[k] >= 0.4 * dirs[p] else None))
    return out


SF_DATALESS = 0x40000000  # file iCloud scaricato solo a richiesta: leggerlo lo scaricherebbe


def walk_files(roots, min_bytes=0, max_depth=None):
    for root in roots:
        d0 = root.rstrip("/").count("/")
        for dp, dn, fn in os.walk(root):
            dn[:] = [d for d in dn if not d.startswith(".") and d != "node_modules" and not d.endswith((".photoslibrary", ".app"))
                     and (max_depth is None or dp.count("/") - d0 < max_depth)]
            for f in fn:
                fp = os.path.join(dp, f)
                try:
                    st = os.lstat(fp)
                except OSError:
                    continue
                if st.st_size >= min_bytes and not (getattr(st, "st_flags", 0) & SF_DATALESS) and os.path.isfile(fp):
                    yield fp, st


def storage(dirs, big, open_dirs):
    now = time.time()
    dl = HOME + "/Downloads"
    old = []
    for e in os.scandir(dl) if "Downloads" in open_dirs else []:
        try:
            st = e.stat(follow_symlinks=False)
        except OSError:
            continue
        if now - st.st_mtime > OLD_DOWNLOAD_DAYS * DAY:
            old.append((e.path, dirs.get(e.path, st.st_blocks // 2), int((now - st.st_mtime) / DAY)))
    old.sort(key=lambda x: -x[1])
    docs = [f"{HOME}/{d}" for d in open_dirs]
    inst = sorted(((fp, st.st_blocks // 2) for fp, st in walk_files(docs, 0, 3)
                   if fp.lower().endswith((".dmg", ".pkg", ".mpkg", ".iso", ".xip"))), key=lambda x: -x[1])
    # doppioni: stessa dimensione, poi primo e ultimo MB. Basta per segnalare; chi cancella guarda prima.
    by_size = {}
    for fp, st in walk_files(docs + [HOME + "/Pictures", HOME + "/Movies"], 10 << 20):
        by_size.setdefault(st.st_size, []).append(fp)
    dupes = []
    for size, fps in by_size.items():
        if len(fps) < 2:
            continue
        by_hash = {}
        for fp in fps:
            try:
                with open(fp, "rb") as fh:
                    h = hashlib.sha256(fh.read(1 << 20))
                    fh.seek(max(size - (1 << 20), 0))
                    h.update(fh.read(1 << 20))
                by_hash.setdefault(h.hexdigest(), []).append(fp)
            except OSError:
                continue
        for group in by_hash.values():
            if len(group) > 1:
                dupes.append((size * (len(group) - 1) // 1024, sorted(group)))
    dupes.sort(key=lambda x: -x[0])
    t = run(["du", "-sk", HOME + "/.Trash"], 120)
    m = re.match(r"(\d+)\t", t)
    logs = [(p, kb) for p, kb in big if re.search(r"\.(log|out|err)(\.\d+)?$", p)]
    return dict(top=top_folders(dirs), big=big[:20], old_downloads=old, installers=inst, dupes=dupes,
                trash_kb=int(m.group(1)) if m and "not permitted" not in t else None, logs=logs)


def unused_apps(running_exes):
    """Ultimo uso = il piu' recente fra Spotlight e l'atime del binario. Spotlight qui non
    indicizza /Applications (101 app su 102 senza data, 23/10); l'atime si', e sbaglia solo
    per difetto: chi lo scansiona lo aggiorna, ma nessuno lo azzera."""
    now = time.time()
    apps = sorted(set(glob.glob("/Applications/*.app") + glob.glob("/Applications/*/*.app")
                      + glob.glob(HOME + "/Applications/*.app")))
    out = []
    for a in apps:
        try:
            info = plistlib.load(open(a + "/Contents/Info.plist", "rb"))
        except Exception:
            continue
        exe = f"{a}/Contents/MacOS/{info.get('CFBundleExecutable', '')}"
        if any(x.startswith(a + "/") for x in running_exes):
            continue
        last = os.stat(exe).st_atime if os.path.exists(exe) else 0
        md = run(["mdls", "-name", "kMDItemLastUsedDate", "-raw", a], 10).strip()
        try:
            last = max(last, datetime.datetime.strptime(md, "%Y-%m-%d %H:%M:%S %z").timestamp())
        except ValueError:
            pass
        days = int((now - last) / DAY) if last else None
        if days is None or days >= UNUSED_DAYS:
            kb = run(["du", "-sk", a], 60).split("\t")[0]
            cat = (info.get("LSApplicationCategoryType") or "").split(".")[-1]
            out.append(dict(name=os.path.basename(a)[:-4], path=a, days=days,
                            kb=int(kb) if kb.isdigit() else 0, category=CATEGORY.get(cat, "")))
    return sorted(out, key=lambda x: -x["kb"])


