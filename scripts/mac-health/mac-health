def ps_rows():
    rows = []
    for line in run(["ps", "-Ao", "pid=,ppid=,user=,pcpu=,time=,etime=,rss=,command="]).splitlines():
        f = line.split(None, 7)
        if len(f) < 8:
            continue
        try:
            e, c = secs(f[5]), secs(f[4])
            rows.append(dict(pid=int(f[0]), ppid=int(f[1]), user=f[2], cpu=float(f[3]), etime=e,
                             avg=100 * c / e if e else 0.0, rss=int(f[6]) / 1024, cmd=f[7]))
        except ValueError:
            continue
    # comm da' il percorso dell'eseguibile anche quando contiene spazi (Beeper Desktop.app)
    exe = {}
    for line in run(["ps", "-Ao", "pid=,comm="]).splitlines():
        f = line.strip().split(None, 1)
        if len(f) == 2 and f[0].isdigit():
            exe[int(f[0])] = f[1]
    for r in rows:
        r["exe"] = exe.get(r["pid"], r["cmd"].split()[0])
    return rows


def describe(p, labels, cwds):
    name, proj = psj.name_for(p, cwds.get(p["pid"]), labels.get(p["pid"]))
    base = os.path.basename(p["exe"])
    what = next((v for k, v in APPLE_WHAT.items() if base == k or base.startswith(k + ".")), None)
    if not what:
        bits = []
        if is_apple_path(p["exe"]):
            bits.append("di macOS")
        else:
            sig = signer(p["exe"]) if os.path.exists(p["exe"]) else "eseguibile sparito"
            bits.append(sig if not trusted(sig) or sig == "eseguibile sparito" else f"firmato {sig}")
        if proj:
            bits.append(f"progetto {proj}")
        what = ", ".join(bits)
    return name, what


def processes(rows, ram_mb):
    labels = psj.launchd_labels()
    hot = [p for p in rows if p["etime"] >= CPU_MIN_HOURS * 3600 and p["avg"] >= CPU_AVG_PCT]
    # footprint solo sulla testa per RSS, come memhog: misurarli tutti costerebbe minuti
    for p in sorted(rows, key=lambda r: -r["rss"])[:30]:
        p["fp"] = memhog.footprint_mb(p["pid"])
    heavy = [p for p in rows if (p.get("fp") or 0) >= ram_mb * MEM_PCT / 100]
    top = sorted((p for p in rows if p.get("fp")), key=lambda r: -r["fp"])[:15]
    pick = {p["pid"]: p for p in hot + heavy + top}
    cwds = psj.cwds(list(pick)) if pick else {}
    out = []
    for p in pick.values():
        name, what = describe(p, labels, cwds)
        out.append(dict(pid=p["pid"], name=name, what=what, avg=p["avg"], hours=p["etime"] / 3600,
                        fp=p.get("fp"), hot=p in hot, heavy=p in heavy))
    return out


def btm_items():
    """Elementi d'avvio come li vede macOS (Impostazioni > Elementi di login), senza sudo."""
    items, uid, cur = [], None, None
    # sotto carico (load 35, 23/10) dal gateway non ha risposto in 60 s; a riposo ne bastano 4.
    # Un tentativo solo: il settimanale ha 300 s (cron 20fb44a9) e con backgroundtaskmanagementd
    # appeso (dal 24/10) due da 180 s lo facevano uccidere prima di stampare. I demoni senza
    # eseguibile li trova comunque orphan_plists(), che legge i plist dal disco.
    raw = run(["sfltool", "dumpbtm"], 120)
    for line in raw.splitlines():
        m = re.match(r"\s*Records for UID (-?\d+)", line)
        if m:
            uid = int(m.group(1))
            continue
        if re.match(r"^ #\d+:\s*$", line):
            cur = {"uid": uid}
            items.append(cur)
            continue
        m = re.match(r"^\s+([A-Za-z ]+): (.*)$", line)
        if cur is not None and m:
            cur.setdefault(m.group(1).strip(), m.group(2).strip())
    keep = []
    for it in items:
        typ = re.sub(r"\s*\(0x[0-9a-f]+\)$", "", it.get("Type", ""))
        if it["uid"] not in (os.getuid(), 0, -2) or typ not in ("login item", "legacy agent", "legacy daemon", "daemon", "agent"):
            continue
        url = it.get("URL", "(null)")
        plist = urllib.parse.unquote(url[7:]) if url.startswith("file://") else None
        target, missing = launch_target(plist, it.get("Executable Path"))
        keep.append(dict(id=it.get("Identifier", "?"), name=it.get("Name", "?"), type=typ,
                         enabled="[enabled" in it.get("Disposition", ""), exe=target or plist,
                         plist=plist, missing=missing))
    return keep


INTERP = re.compile(r"(^|/)(sh|bash|zsh|python[\d.]*|node|bun|osascript|perl|ruby)$")


def launch_target(plist, exe):
    """Cosa lancia davvero il plist (lo script, non /bin/bash) e se non c'e' piu': OMEGA
    girava da 6 giorni col venv gia' cancellato e al primo riavvio sarebbe morto in silenzio."""
    args = []
    if plist and plist.endswith(".plist") and os.path.exists(plist):
        d = load_plist(plist)
        if not isinstance(d, dict):
            return exe, None
        args = d.get("ProgramArguments") or []
        if d.get("Program"):
            args = [d["Program"]] + args[1:]
        # SMAppService: BundleProgram e' relativo al bundle che contiene il plist
        bundle = re.match(r"(.+?\.app)/Contents/Library/", plist)
        if not args and d.get("BundleProgram") and bundle:
            args = [f"{bundle.group(1)}/{d['BundleProgram']}"]
    elif plist and plist.endswith(".plist"):
        return exe, plist
    if not args and exe and exe != "(null)":
        args = [exe]
    paths = args[:1]
    if args and INTERP.search(args[0]) and len(args) > 1 and args[1].startswith("/"):
        paths.append(args[1])
    return (paths[-1] if paths else exe), next((p for p in paths if p.startswith("/") and not os.path.exists(p)), None)


def load_plist(path):
    """plistlib, e plutil quando plistlib rifiuta: launchd carica anche plist che plistlib no
    (com.armonia.topics-db-snapshot ha «--» dentro un commento XML, 25/10)."""
    try:
        return plistlib.load(open(path, "rb"))
    except Exception:
        try:
            out = subprocess.run(["plutil", "-convert", "xml1", "-o", "-", path], capture_output=True, timeout=10).stdout
            return plistlib.loads(out)
        except Exception:
            return None


def parse_disabled(text):
    """Le etichette spente in `launchctl print-disabled`: «=> disabled», o «=> true» nelle versioni vecchie."""
    return set(re.findall(r'"([^"]+)" => (?:disabled|true)\b', text))


def disabled_labels():
    """Gli override di `launchctl disable`: reggono ai riavvii, e un job spento cosi' e' gia' curato."""
    out = set()
    for dom in (f"gui/{os.getuid()}", "system"):
        out |= parse_disabled(run(["launchctl", "print-disabled", dom]))
    return out


def orphan_plists(dirs=PLIST_DIRS, disabled=None):
    """Plist il cui eseguibile non c'e' piu': il demone di un'app tolta. Letti dal disco e non da
    sfltool, che si appende. Il riordino del 12/10 ha cestinato le app e lasciato i loro plist."""
    disabled = disabled_labels() if disabled is None else disabled
    out = []
    for d in dirs:
        for pl in sorted(glob.glob(d + "/*.plist")):
            data = load_plist(pl)
            if not isinstance(data, dict):
                continue
            label = data.get("Label") or os.path.basename(pl)[:-6]
            if data.get("Disabled") is True or label in disabled:
                continue
            _, missing = launch_target(pl, None)
            if missing:
                # in /Library/LaunchDaemons gira come root: toglierlo vuole la password di Attilio
                out.append(dict(label=label, plist=pl, missing=missing, system=d.startswith("/Library/LaunchDaemons")))
    return out


def parse_print(info):
    """Una voce di `launchctl print`. None se non e' mai uscito o l'ultima uscita e' 0."""
    ex = re.search(r"\n\s+last exit code = (-?\d+)(?::\s*(\S+))?", info)
    if ex:
        code, why = int(ex.group(1)), ex.group(2) or ""
    else:
        # ucciso da un segnale: launchctl print scrive «last terminating signal = Killed: 9» e NON «last exit code»
        # (visto su com.jarvis.devbridge, 25/10). Per il resto del programma un segnale e' l'uscita negativa.
        sg = re.search(r"\n\s+last terminating signal = ([^\n]+?): (\d+)", info)  # anche «Alarm clock: 14», «Segmentation fault: 11»
        if not sg:
            return None
        code, why = -int(sg.group(2)), sg.group(1)
    if code == 0:
        return None
    runs = re.search(r"\n\s+runs = (\d+)", info)
    # campi di primo livello (un tab solo): dove gira e dove scrive, per dare alla card cartella e causa
    top = lambda k: (re.search(rf"\n\t{k} = (.+)", info) or [None, None])[1]
    args = re.search(r"\n\targuments = \{\n(.*?)\n\t\}", info, re.S)
    return dict(exit=code, why=why, runs=int(runs.group(1)) if runs else 0,
                running=bool(re.search(r"\n\s+pid = \d+", info)),
                # a intervallo o a calendario tanti avvii sono il suo mestiere: devreap ne fa 5.000, ogni 5 minuti
                periodic=bool(re.search(r"\n\s+run interval = \d+|com\.apple\.launchd\.calendarinterval", info)),
                wd=top("working directory"), out=top("stdout path"), err=top("stderr path"),
                args=[a.strip() for a in args.group(1).splitlines()] if args else [x for x in [top("program")] if x])


def job_context(x):
    """Cartella e ultima riga del log di un job: la card deve dire la causa e lavorare nel repo giusto
    (com.armonia.topics-db-snapshot gira in ~/Projects/topics-app e chiede un backup esterno, 25/10)."""
    d = x.get("wd")
    gone = None
    if d and not os.path.isdir(d):
        # cartella di lavoro cancellata: board-notte scarterebbe la card ogni notte, quindi niente cartella e niente notte
        d, gone = None, d
    elif not d:  # senza WorkingDirectory: il repo dello script lanciato (dietro l'interprete)
        prog = next((a for a in x.get("args") or [] if a.startswith("/") and not INTERP.search(a) and os.path.isfile(a)), None)
        top = run(["git", "-C", os.path.dirname(prog), "rev-parse", "--show-toplevel"], 10).strip() if prog else ""
        d = top if top.startswith("/") else None
    # l'ultima riga del log piu' recente fra stderr e stdout: un errore vecchio non deve coprire l'uscita di oggi
    tails = []
    for p in dict.fromkeys(filter(None, (x.get("err"), x.get("out")))):
        try:
            with open(p, "rb") as fh:
                fh.seek(max(0, os.path.getsize(p) - 4096))
                lines = [l.strip() for l in fh.read().decode(errors="replace").splitlines() if l.strip()]
            if lines:
                tails.append((os.path.getmtime(p), lines[-1][-200:]))
        except OSError:
            continue
    return dict(dir=d, log_tail=max(tails, key=lambda t: t[0])[1] if tails else None, gone=gone)


def launchd_failures(uptime_h):
    out = []
    targets = []
    for line in run(["launchctl", "list"]).splitlines()[1:]:
        f = line.split("\t")
        if len(f) == 3 and not f[2].startswith("com.apple.") and f[1] not in ("0", "-"):
            targets.append(f"gui/{os.getuid()}/{f[2]}")
    for pl in glob.glob("/Library/LaunchDaemons/*.plist"):
        try:
            targets.append("system/" + load_plist(pl)["Label"])
        except Exception:
            pass
    for t in targets:
        x = parse_print(run(["launchctl", "print", t]))
        if x:
            out.append(dict(x, label=t.split("/")[-1], domain=t.split("/")[0], rate=x["runs"] / max(uptime_h, 1), **job_context(x)))
    return out


