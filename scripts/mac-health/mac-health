            # la card non chiede di chiudere niente, un agente di giorno potrebbe chiudere un processo vivo.
            observing = any(r.get("verdict", "").startswith(RESTO_OBSERVE) for r in f.get("resti") or [])
            title, notte, plain_bar = "Capire chi sono i resti senza padrone che devreap vede (solo diagnosi, niente da chiudere)", False, True
            cure = ("Solo diagnosi, nessun processo chiuso e nessun cambio di DEVREAP_RESTO_KILL. "
                    + ("La classe «resto» e' in sola osservazione (DEVREAP_RESTO_KILL=0): non chiude, scrive OSSERVO-RESTO nel log di devreap. " if observing else "")
                    + "Per ogni riga «resto» di `devreap --list`: `ps -o pid,ppid,etime,command -p <pid>`, di chi era il padrone "
                    "(sessione, agente, test) e se e' davvero morto. Poi, sulla card, quali la regola avrebbe chiuso a ragione e quali a torto "
                    "(un padrone vivo, un lavoro in corso). Se serve correggere la regola, e' una modifica a devreap con il suo test.")
            bar = ("sulla card c'e' l'elenco dei resti con padrone e giudizio (a ragione / a torto) e nessun processo e' stato chiuso; "
                   "se la regola risulta affidabile, la proposta di accendere DEVREAP_RESTO_KILL=1 va ad Attilio, che decide")
        elif kind == "log":
            title, notte = f"Mettere un tetto al log {os.path.basename(name)}", False
