def findings(f):
    """Il punto critico: dai fatti alle righe da guardare. Pura, cosi' si prova con fatti finti.
    Ogni riga: (sezione, chiave stabile, testo per il rapporto, forma breve per WhatsApp).
    La chiave non contiene numeri che cambiano a ogni giro: dice «e' la stessa cosa di lunedi'»."""
    out = []
    add = lambda sec, key, line, brief: out.append((sec, f"{sec}:{key}", line, brief))
    base = f.get("baseline") or {}
    seen = lambda k: set(base[k]) if base.get(k) is not None else None  # senza base, niente «nuovo»
    why = lambda x: f" {x['why']}" if x["why"] else ""
    # avvio
    orphans = f.get("orphans") or []
    for o in orphans:
        app = re.search(r"([^/]+)\.app/", o["missing"])
        add("avvio", f"orphan:{o['label']}", f"{o['label']}: demone di un'app tolta{' (' + app.group(1) + ')' if app else ''}, "
            f"lancia {short(o['missing'])} che non esiste piu' ({short(o['plist'])})", f"{o['label']} senza la sua app")
    known = seen("startup")
    for it in f["startup"]:
        if not it["enabled"]:
            continue
        if it["missing"] and it["plist"] not in {o["plist"] for o in orphans}:  # lo stesso plist una volta sola
            add("avvio", f"missing:{it['id']}", f"{it['id']} lancia {short(it['missing'])}, che non esiste piu': al prossimo avvio muore in silenzio",
                f"{it['id']} lancia un file sparito")
        if known is not None and it["id"] not in known:
            add("avvio", f"new:{it['id']}", f"nuovo all'avvio: {it['name']} ({it['id']}, {short(it['exe'] or it['plist'] or '?')})",
                f"nuovo all'avvio {it['name']}")
    for x in f["failures"]:
        # uscita negativa = ucciso da un segnale (jetsam, qualcuno): non e' «a vuoto», e la card lo spegnerebbe
        if not x.get("periodic") and x["exit"] > 0 and (x["rate"] >= LOOP_PER_HOUR or x["runs"] >= RESPAWN_RUNS):
            add("avvio", f"loop:{x['label']}", f"{x['label']}: servizio che riparte a vuoto, {num(x['runs'])} avvii in {round(f['uptime_h'] / 24)} giorni, "
                f"ultima uscita {x['exit']}{why(x)}", f"{x['label']} riparte a vuoto ({num(x['runs'])} avvii)")
        elif not x["running"] and x["exit"] > 0 and x["label"] in ATTILIO_CHOICES:
            # non e' un guasto: il job chiede una scelta che solo Attilio puo' fare, quindi riga per lui e nessuna card
            tail = f" Ultima riga del log: «{short(x['log_tail'])}»." if x.get("log_tail") else ""
            add("avvio", f"failed:{x['label']}", f"{x['label']}: fermo (uscita {x['exit']}), ma non e' un guasto: aspetta una tua scelta, "
                f"{ATTILIO_CHOICES[x['label']]}. Cura: decidere dove, poi `launchctl kickstart gui/{os.getuid()}/{x['label']}`.{tail}",
                f"{x['label']} aspetta una tua scelta: {ATTILIO_CHOICES[x['label']].split(' (')[0]}")
        elif not x["running"] and x["exit"] > 0:  # un segnale (uscita negativa) e' qualcuno che l'ha fermato
            add("avvio", f"failed:{x['label']}", f"{x['label']}: fermo, l'ultimo giro e' fallito (uscita {x['exit']}{why(x)})",
                f"{x['label']} fermo (uscita {x['exit']})")
        elif not x.get("periodic") and x["exit"] < 0 and x["rate"] >= LOOP_PER_HOUR:
            # ucciso e rilanciato da KeepAlive almeno una volta l'ora (jetsam, un guardiano): spreco anche lui, ma
            # non «a vuoto» e non da spegnere, quindi solo «chi lo uccide e perche' riparte»
            add("avvio", f"killed:{x['label']}", f"{x['label']}: ucciso da un segnale e rilanciato, {num(x['runs'])} avvii in "
                f"{round(f['uptime_h'] / 24)} giorni (ultima uscita {x['exit']}{why(x)}): chi lo uccide e perche' riparte",
                f"{x['label']} ucciso e rilanciato ({num(x['runs'])} avvii)")
    # sicurezza
    for k, v in f["posture"].items():
        if not v:
            txt = {"filevault": "FileVault spento: il disco non e' cifrato", "firewall": "firewall spento",
                   "sip": "SIP spento", "gatekeeper": "Gatekeeper spento: le app non firmate partono senza avviso"}[k]
            add("sicurezza", f"posture:{k}", txt, txt.split(":")[0])
    for name, ports in sorted(f["lan"].items()):
        add("sicurezza", f"lan:{name}", f"{name} ascolta sulla rete locale (porte {', '.join(ports)}): raggiungibile da chiunque sul Wi-Fi",
            f"{name}:{ports[0]}{'+' + str(len(ports) - 1) if len(ports) > 1 else ''} in LAN")
    for o in f["odd"]:
        if not trusted(o["signer"]):
            add("sicurezza", f"odd:{o['path']}", f"in esecuzione da una cartella temporanea, {o['signer']}: {short(o['path'])}",
                f"{os.path.basename(o['path'])} {o['signer']} da cartella temporanea")
    seen_net = seen("net")
    for n in f["net"]:
        if seen_net is not None and n["key"] not in seen_net:
            add("sicurezza", f"net:{n['key']}", f"nuovo in rete: {n['name']} ({n['signer']}, {short(n['key'])})",
                f"nuovo in rete {n['name']} ({n['signer']})")
    seen_ext = seen("ext")
    for e in f["extensions"]:
        if not e["enabled"]:
            continue
        if not e["store"]:
            add("sicurezza", f"ext-out:{e['id']}", f"estensione fuori dallo store attiva in {e['browser']}: {e['name']}",
                f"estensione fuori store {e['name']}")
        elif seen_ext is not None and e["id"] not in seen_ext:
            add("sicurezza", f"ext-new:{e['id']}", f"estensione nuova in {e['browser']}: {e['name']}", f"estensione nuova {e['name']}")
    # backup
    b, now = f["backup"], f["now"]
    if not b["tm_dest"]:
        add("backup", "tm", "Time Machine non e' configurato: dei file fuori da iCloud e da git c'e' una copia sola" +
            (", e Scrivania e Documenti non sono su iCloud" if b["icloud_docs"] is False else ""), "Time Machine assente")
    elif b["tm_last"] is None:
        add("backup", "tm-unknown", "Time Machine configurato ma non leggo la data dell'ultimo backup", "Time Machine: data illeggibile")
    elif now - b["tm_last"] > TM_MAX_DAYS * DAY:
        dd = int((now - b["tm_last"]) / DAY)
        add("backup", "tm-old", f"ultimo backup Time Machine di {dd} giorni fa", f"Time Machine fermo da {dd} gg")
    if b["private_last"] is None or now - b["private_last"] > PRIVATE_MAX_H * 3600:
        when = "mai spinto" if b["private_last"] is None else f"fermo da {int((now - b['private_last']) / 3600)} ore"
        add("backup", "private", f"backup notturno di jarvis-private {when} (manutenzione notturna, launchd com.jarvis.manutenzione)", f"jarvis-private {when}")
    stale = [u for u in b["unpushed"] if now - u[2] > UNPUSHED_DAYS * DAY]
    if stale:
        top = ", ".join(f"{n} ({c}, dal {datetime.date.fromtimestamp(t).strftime('%d/%m')})" for n, c, t in stale[:5])
        add("backup", "unpushed", f"{len(stale)} repo in ~/Projects con commit solo su questo Mac da piu' di {UNPUSHED_DAYS} giorni: {top}",
            f"{len(stale)} repo con commit non spinti da {UNPUSHED_DAYS}+ gg")
    if b["noremote"]:
        add("backup", "noremote", f"{len(b['noremote'])} repo senza remote, solo su questo disco: {', '.join(b['noremote'][:6])}",
            f"{len(b['noremote'])} repo senza remote")
    # disco
    d = f["disk"]
    pct = 100 * d["free_gb"] / d["total_gb"]
    if pct < DISK_FREE_PCT:
        add("disco", "free", f"liberi {d['free_gb']:.0f} GB su {d['total_gb']:.0f} ({pct:.0f}%): sotto il {DISK_FREE_PCT}% lo swap resta senza spazio",
            f"liberi {d['free_gb']:.0f} GB ({pct:.0f}%)")
    s = f.get("storage")
    if s:
        old_kb = sum(kb for _, kb, _ in s["old_downloads"])
        if old_kb >= OLD_DOWNLOADS_GB << 20:
            add("disco", "old-downloads", f"{gb(old_kb)} in Download piu' vecchi di {OLD_DOWNLOAD_DAYS} giorni ({len(s['old_downloads'])} elementi)",
                f"{gb(old_kb)} di download vecchi")
        inst_kb = sum(kb for _, kb in s["installers"])
        if inst_kb >= INSTALLERS_GB << 20:
            add("disco", "installers", f"{gb(inst_kb)} di installer (.dmg/.pkg/.iso) in Download, Scrivania e Documenti ({len(s['installers'])} file)",
                f"{gb(inst_kb)} di installer")
        dup_kb = sum(kb for kb, _ in s["dupes"])
        if dup_kb >= DUPES_GB << 20:
            add("disco", "dupes", f"{gb(dup_kb)} di probabili doppioni in {len(s['dupes'])} gruppi, il piu' grosso: {short(s['dupes'][0][1][0])}",
                f"{gb(dup_kb)} di doppioni")
        for p, kb in s["logs"]:
            if kb >= BIG_LOG_GB << 20:
                add("disco", f"log:{p}", f"log da {gb(kb)}: {short(p)}", f"log {os.path.basename(p)} {gb(kb)}")
    # memoria: dal registro scripts/memlog. Il 26/10 Topics non faceva partire le card con il kernel al 53% «libera»:
    # senza storia non si distingue una pressione vera da una misura che inganna.
    ml = f.get("memlog")
    if ml is None or ml["last_age_s"] > MEMLOG_STALE_H * 3600 or ml["samples"] < ml["expected"] * MEMLOG_MIN_COVER:
        got = "illeggibile" if ml is None else f"{ml['samples']} righe su {ml['expected']} attese, ultima {ml['last_age_s'] // 3600} h fa"
        add("memoria", "registro", f"registro della memoria (com.jarvis.memlog) fermo o a buchi: {got}; cura: "
            f"`launchctl kickstart gui/{os.getuid()}/com.jarvis.memlog`", "registro memoria fermo")
    elif (ml["swap_hi_share"] or 0) >= MEMLOG_SWAP_SHARE and (ml["swapin_hi_share"] or 0) >= MEMLOG_SWAP_SHARE:
        tops = ", ".join(f"{k} {v}" for k, v in ml["top"][:3])
        add("memoria", "pressione", f"memoria stretta da giorni: swap oltre l'85% nel {ml['swap_hi_share']:.0%} dei campioni e letta da disco "
            f"oltre 10 pagine/s nel {ml['swapin_hi_share']:.0%} degli intervalli (kernel «libera» mediana {ml['lvl_p50']}%, "
            f"a Topics restano {ml['topics_p50']} GB); in testa {tops}", f"memoria stretta: swap piena {ml['swap_hi_share']:.0%} del tempo, in testa {ml['top'][0][0]}")
    # processi: una riga per processo, i piu' lontani dalla soglia prima
    far = lambda p: max(p["avg"] / CPU_AVG_PCT if p["hot"] else 0, (p["fp"] or 0) / (f["ram_mb"] * MEM_PCT / 100) if p["heavy"] else 0)
    for p in sorted((p for p in f.get("procs") or [] if p["hot"] or p["heavy"]), key=lambda p: -far(p)):
        bits = ([f"{p['avg']:.0f}% di CPU in media da {p['hours']:.0f} ore"] if p["hot"] else []) + \
               ([f"{gb(p['fp'] * 1024)} di memoria"] if p["heavy"] else [])
        brief = " ".join(([f"{p['avg']:.0f}% CPU"] if p["hot"] else []) + ([gb(p["fp"] * 1024)] if p["heavy"] else []))
        add("processi", f"proc:{p['name']}", f"{p['name']}: {', '.join(bits)} ({p['what']})", f"{p['name']} {brief}")
    r = f.get("resti") or []
    mb = sum(x["mb"] for x in r)
    if len(r) >= RESTI_N or mb >= RESTI_MB:
        add("processi", "resti", f"{len(r)} resti senza padrone ancora vivi ({gb(int(mb * 1024))}), visti da devreap --list e non chiusi",
            f"{len(r)} resti senza padrone")
    # app
    apps = f.get("apps") or []
    tot = sum(a["kb"] for a in apps)
    if tot >= UNUSED_APPS_GB << 20:
        top = ", ".join(f"{a['name']} {gb(a['kb'])}" for a in apps[:5])
        add("app", "unused", f"{len(apps)} app non aperte da {UNUSED_DAYS} giorni, {gb(tot)} in tutto: {top}",
            f"{len(apps)} app ferme da 6 mesi, {gb(tot)}")
    # agenti: Topics contro Claude Code sui lavori lunghi
    ag = f.get("agents") or {}
    tp, cc = ag.get("topics"), ag.get("claude")
    if tp and cc and tp["n"] >= AGENTS_MIN_N and cc["n"] >= AGENTS_MIN_N and rate(tp) < rate(cc) - AGENTS_GAP_PTS:
        add("agenti", "topics-peggio", f"Topics porta in fondo il {rate(tp):.0f}% dei lavori lunghi ({tp['ok']} su {tp['n']}, {tp['lost']} persi), "
            f"Claude Code il {rate(cc):.0f}% ({cc['ok']} su {cc['n']}): i lavori lunghi restano su Claude Code",
            f"Topics {rate(tp):.0f}% contro Claude Code {rate(cc):.0f}% sui lavori lunghi")
    if (ag.get("orphans") or 0) > TOPICS_ORPHANS_MAX:
        add("agenti", "orfani", f"{ag['orphans']} processi orfani lasciati dai terminali di Topics (soglia {TOPICS_ORPHANS_MAX})",
            f"{ag['orphans']} orfani da Topics")
    for line in f["blind"]:
        add("cieco", "sfltool" if line == BLIND_SFL else line, line, line)  # chiave corta: diventa la chiave della card
    return out


def split_accepted(lines, accepted):
    keep, quiet = [], []
    for sec, key, line, brief in lines:
        a = next((a for a in accepted if a.get("match") and a["match"] in line), None)
        (quiet if a else keep).append((sec, key, line, brief, a and a.get("why")))
    return keep, quiet


def snapshot(f, keep):
    """La base per «nuovo da l'ultima volta». Una sonda cieca non la azzera: al giro dopo
    tutto sembrerebbe nuovo (23/10, lsof muto → 16 «nuovo in rete» falsi)."""
    s = dict(ts=int(f["now"]), startup=sorted(i["id"] for i in f["startup"] if i["enabled"]),
             ext=sorted(e["id"] for e in f["extensions"] if e["enabled"]),
             # chi va in rete va e viene: la base della rete si accumula, se no ogni assenza diventa un «nuovo»
             net=sorted({n["key"] for n in f["net"]} | set((f.get("baseline") or {}).get("net") or [])),
             # cio' che e' gia' stato detto e c'e' ancora: il settimanale non lo ripete, il mensile si'.
             # Una riga che sparisce esce di qui e, se torna, e' di nuovo una notizia.
             reported=sorted(k for _, k, _, _, _ in keep))
    for k in f["blind_keys"]:
        if (f.get("baseline") or {}).get(k) is not None:
            s[k] = f["baseline"][k]
        else:
            s.pop(k, None)
    return s


