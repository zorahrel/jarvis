def open_cards(todo):
    """board-card per ogni card: key -> id, None se Topics non risponde."""
    bc = os.environ.get("MAC_HEALTH_BOARD_CARD") or str(JARVIS / "scripts/board-card")  # i test passano un finto
    ids = {}
    for c in todo:
        args = [bc, "--key", c["key"], "--title", c["title"], "--desc", c["desc"]]
        if c["notte"]:
            args += ["--notte", "--dir", c.get("dir") or str(JARVIS)]
        try:
            r = subprocess.run(args, capture_output=True, text=True, timeout=60)
            ids[c["key"]] = r.stdout.strip().splitlines()[-1] if r.returncode == 0 and r.stdout.strip() else None
        except Exception:
            ids[c["key"]] = None
    return ids


def for_attilio(keep, todo, ids):
    """Le righe del messaggio WhatsApp: fuori quelle gia' diventate card. Se la card non e' nata
    (Topics giu') la riga resta nel messaggio, se no la trovata si perde."""
    carded = {c["finding"] for c in todo if ids.get(c["key"])}
    return [k for k in keep if k[1] not in carded]


