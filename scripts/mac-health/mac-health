def ps_rows():
    rows = []
    for line in run(["ps", "-Ao", "pid=,ppid=,user=,pcpu=,time=,etime=,rss=,command="]).splitlines():
        f = line.split(None, 7)
        if len(f) < 8:
            continue
        try:
            e, c = secs(f[5]), secs(f[4])
            rows.append(dict(pid=int(f[0]), ppid=int(f[1]), user=f[2], cpu=float(f[3]), etime=e,
                             avg=100 * c / e if e else 0.0, rss=int(f[6]) / 1024, cmd=f[7]))
        except ValueError:
            continue
    # comm da' il percorso dell'eseguibile anche quando contiene spazi (Beeper Desktop.app)
    exe = {}
    for line in run(["ps", "-Ao", "pid=,comm="]).splitlines():
        f = line.strip().split(None, 1)
        if len(f) == 2 and f[0].isdigit():
            exe[int(f[0])] = f[1]
    for r in rows:
        r["exe"] = exe.get(r["pid"], r["cmd"].split()[0])
    return rows


def describe(p, labels, cwds):
    name, proj = psj.name_for(p, cwds.get(p["pid"]), labels.get(p["pid"]))
    base = os.path.basename(p["exe"])
    what = next((v for k, v in APPLE_WHAT.items() if base == k or base.startswith(k + ".")), None)
    if not what:
        bits = []
        if is_apple_path(p["exe"]):
            bits.append("di macOS")
        else:
            sig = signer(p["exe"]) if os.path.exists(p["exe"]) else "eseguibile sparito"
            bits.append(sig if not trusted(sig) or sig == "eseguibile sparito" else f"firmato {sig}")
        if proj:
            bits.append(f"progetto {proj}")
        what = ", ".join(bits)
    return name, what


def processes(rows, ram_mb):
    labels = psj.launchd_labels()
    hot = [p for p in rows if p["etime"] >= CPU_MIN_HOURS * 3600 and p["avg"] >= CPU_AVG_PCT]
    # footprint solo sulla testa per RSS, come memhog: misurarli tutti costerebbe minuti
    for p in sorted(rows, key=lambda r: -r["rss"])[:30]:
        p["fp"] = memhog.footprint_mb(p["pid"])
    heavy = [p for p in rows if (p.get("fp") or 0) >= ram_mb * MEM_PCT / 100]
    top = sorted((p for p in rows if p.get("fp")), key=lambda r: -r["fp"])[:15]
    pick = {p["pid"]: p for p in hot + heavy + top}
    cwds = psj.cwds(list(pick)) if pick else {}
    out = []
    for p in pick.values():
        name, what = describe(p, labels, cwds)
        out.append(dict(pid=p["pid"], name=name, what=what, avg=p["avg"], hours=p["etime"] / 3600,
                        fp=p.get("fp"), hot=p in hot, heavy=p in heavy))
    return out


def btm_items():
    """Elementi d'avvio come li vede macOS (Impostazioni > Elementi di login), senza sudo."""
    items, uid, cur = [], None, None
    # sotto carico (load 35, 23/10) dal gateway non ha risposto in 60 s; a riposo ne bastano 4
    raw = run(["sfltool", "dumpbtm"], 180) or run(["sfltool", "dumpbtm"], 180)
    for line in raw.splitlines():
        m = re.match(r"\s*Records for UID (-?\d+)", line)
        if m:
            uid = int(m.group(1))
            continue
        if re.match(r"^ #\d+:\s*$", line):
            cur = {"uid": uid}
            items.append(cur)
            continue
        m = re.match(r"^\s+([A-Za-z ]+): (.*)$", line)
        if cur is not None and m:
            cur.setdefault(m.group(1).strip(), m.group(2).strip())
    keep = []
    for it in items:
        typ = re.sub(r"\s*\(0x[0-9a-f]+\)$", "", it.get("Type", ""))
        if it["uid"] not in (os.getuid(), 0, -2) or typ not in ("login item", "legacy agent", "legacy daemon", "daemon", "agent"):
            continue
        url = it.get("URL", "(null)")
        plist = urllib.parse.unquote(url[7:]) if url.startswith("file://") else None
        target, missing = launch_target(plist, it.get("Executable Path"))
        keep.append(dict(id=it.get("Identifier", "?"), name=it.get("Name", "?"), type=typ,
                         enabled="[enabled" in it.get("Disposition", ""), exe=target or plist,
                         plist=plist, missing=missing))
    return keep


INTERP = re.compile(r"(^|/)(sh|bash|zsh|python[\d.]*|node|bun|osascript|perl|ruby)$")


def launch_target(plist, exe):
    """Cosa lancia davvero il plist (lo script, non /bin/bash) e se non c'e' piu': OMEGA
    girava da 6 giorni col venv gia' cancellato e al primo riavvio sarebbe morto in silenzio."""
    args = []
    if plist and plist.endswith(".plist") and os.path.exists(plist):
        try:
            d = plistlib.load(open(plist, "rb"))
            args = d.get("ProgramArguments") or []
            if d.get("Program"):
                args = [d["Program"]] + args[1:]
        except Exception:
            return exe, None
    elif plist and plist.endswith(".plist"):
        return exe, plist
    if not args and exe and exe != "(null)":
        args = [exe]
    paths = args[:1]
    if args and INTERP.search(args[0]) and len(args) > 1 and args[1].startswith("/"):
        paths.append(args[1])
    return (paths[-1] if paths else exe), next((p for p in paths if p.startswith("/") and not os.path.exists(p)), None)


def launchd_failures(uptime_h):
    out = []
    targets = []
    for line in run(["launchctl", "list"]).splitlines()[1:]:
        f = line.split("\t")
        if len(f) == 3 and not f[2].startswith("com.apple.") and f[1] not in ("0", "-"):
            targets.append(f"gui/{os.getuid()}/{f[2]}")
    for pl in glob.glob("/Library/LaunchDaemons/*.plist"):
        try:
            targets.append("system/" + plistlib.load(open(pl, "rb"))["Label"])
        except Exception:
            pass
    for t in targets:
        info = run(["launchctl", "print", t])
        ex = re.search(r"\n\s+last exit code = (-?\d+)(?::\s*(\S+))?", info)
        if not ex or ex.group(1) == "0":
            continue
        runs = re.search(r"\n\s+runs = (\d+)", info)
        n = int(runs.group(1)) if runs else 0
        out.append(dict(label=t.split("/")[-1], exit=int(ex.group(1)), why=ex.group(2) or "",
                        runs=n, rate=n / max(uptime_h, 1), running=bool(re.search(r"\n\s+pid = \d+", info))))
    return out


