def net_key(exe):
    """Una chiave stabile fra un aggiornamento e l'altro: il bundle esterno, senza versioni ne' hash."""
    exe = os.path.realpath(exe)  # /opt/homebrew/bin/node e opt/node/bin/node sono lo stesso Cellar
    k = exe[: exe.index(".app/") + 4] if ".app/" in exe else exe
    k = re.sub(r"/\d+(\.\d+)+(?=/|$)", "/*", k)
    return re.sub(r"/([0-9a-f]{8,}|[A-Za-z0-9_-]{16,})(?=/)", "/*", k)


def net_name(key):
    b = os.path.basename(key)
    if b.endswith(".app"):
        return b[:-4]
    parts = [x for x in key.split("/") if x and x not in ("*", "versions", "bin")]
    return parts[-1] if b == "*" and parts else b  # ~/.local/share/claude/versions/* -> claude


PRIVATE_NET = re.compile(r"^(127\.|10\.|192\.168\.|172\.(1[6-9]|2\d|3[01])\.|169\.254\.|\[::1\]|\[fe80|\[fd|localhost)")


# Indirizzi della tailnet: ci si arriva solo dai dispositivi di Attilio, ed e' la strada
# d'accesso remoto prevista (tailscale serve, mai la porta in LAN).
TAILNET = re.compile(r"^(100\.(6[4-9]|[7-9]\d|1[01]\d|12[0-7])\.|\[fd7a:115c:a1e0:)")


def network(rows):
    est = run(["lsof", "-nP", "-i", "-sTCP:ESTABLISHED"], 60)
    lis = run(["lsof", "-nP", "-iTCP", "-sTCP:LISTEN"], 60)
    if not est.strip() or not lis.strip():
        return None
    exe = {r["pid"]: r["exe"] for r in rows}
    def owner(f):
        e = exe.get(int(f[1]), "") if f[1].isdigit() else ""
        return e if e.startswith("/") and not is_apple_path(e) else None
    talkers = {}
    for line in est.splitlines()[1:]:
        f = line.split()
        m = re.search(r"->(\S+):\d+$", f[-2] if f[-1].startswith("(") else f[-1])
        e = owner(f) if len(f) > 2 else None
        if m and e and not PRIVATE_NET.match(m.group(1)):
            talkers.setdefault(net_key(e), e)
    out = [dict(key=k, name=net_name(k), signer=signer(e)) for k, e in sorted(talkers.items())]
    lan = {}
    for line in lis.splitlines()[1:]:
        f = line.split()
        e = owner(f) if len(f) > 2 else None
        host, _, port = (f[-2] if f[-1] == "(LISTEN)" else f[-1]).rpartition(":")
        # anche Tailscale stesso ascolta su *: e' la VPN, non un servizio esposto
        if not e or "/Tailscale.app/" in e or host.startswith(("127.", "[::1]", "localhost")) or TAILNET.match(host):
            continue
        lan.setdefault(net_name(net_key(e)), set()).add(port)
    return out, {k: sorted(v, key=int) for k, v in lan.items()}


def locale_name(ext_dir, man):
    n = man.get("name", "?")
    m = re.match(r"__MSG_(.+)__$", n)
    if not m:
        return n
    for loc in (man.get("default_locale", "en"), "en", "en_US", "it"):
        try:
            msgs = json.load(open(f"{ext_dir}/_locales/{loc}/messages.json"))
            for k, v in msgs.items():
                if k.lower() == m.group(1).lower():
                    return v.get("message", n)
        except Exception:
            continue
    return n


def extensions():
    """Estensioni dei browser Chromium lette dai file del profilo, senza aprire il browser.
    Safari e Firefox qui non ne hanno (pluginkit vuoto, nessun profilo Firefox, 23/10)."""
    base = HOME + "/Library/Application Support"
    out = []
    for ext in glob.glob(base + "/*/*/Extensions") + glob.glob(base + "/*/*/*/Extensions"):
        prof = os.path.dirname(ext)
        if not os.path.exists(prof + "/Preferences"):
            continue
        sett = {}
        for f in ("Preferences", "Secure Preferences"):
            try:
                sett.update(json.load(open(f"{prof}/{f}")).get("extensions", {}).get("settings", {}))
            except Exception:
                pass
        browser = short(prof).replace("~/Library/Application Support/", "")
        for i in sorted(os.listdir(ext)):
            s = sett.get(i, {})
            if len(i) != 32 or s.get("location") in (5, 10):  # 5 e 10: componenti del browser stesso
                continue
            if "disable_reasons" in s:
                on = not s["disable_reasons"]
            else:
                on = s.get("state", 1) == 1
            vers = sorted(os.listdir(f"{ext}/{i}")) if os.path.isdir(f"{ext}/{i}") else []
            name = "?"
            if vers:
                try:
                    name = locale_name(f"{ext}/{i}/{vers[-1]}", json.load(open(f"{ext}/{i}/{vers[-1]}/manifest.json")))
                except Exception:
                    pass
            out.append(dict(id=f"{browser}:{i}", browser=browser, name=name, enabled=on,
                            store=bool(s.get("from_webstore")) and s.get("location") not in (4, 8)))
    return out


def git_ts(repo, *args):
    out = run(["git", "-C", repo, "log", "--format=%ct"] + list(args), 20).split()
    return [int(x) for x in out if x.isdigit()]


