def resti(text):
    """Le righe «resto» di devreap --list: processi il cui padrone (sessione, agente, test) e' sparito.
    Contratto con devreap (25/10): «  resto pid=<pid> albero=<n> fp=<MB>MB eta=<min>m <motivo> -> <verdetto>».
    Contano solo i verdetti di RESTO_COUNTED, col prefisso «osservo: » tolto: le righe «in uso» contate davano una card
    verso processi vivi, e «aspetta (lsof non risponde…)» e' una passata cieca, non un resto."""
    if text is None:
        return None
    out = []
    for line in text.splitlines():
        if not re.match(r"\s*resto pid=\d+", line):
            continue
        verdict = line.rpartition("->")[2].strip()
        observed = verdict.startswith(RESTO_OBSERVE)
        bare = verdict[len(RESTO_OBSERVE):] if observed else verdict
        if bare.startswith(RESTO_COUNTED) and RESTO_BLIND not in bare:
            fp = re.search(r"\bfp=(\d+(?:\.\d+)?)MB", line)
            out.append(dict(line=line.strip(), mb=float(fp.group(1)) if fp else 0.0, verdict=verdict))
    return out


