    return True if p.returncode == 0 else (False if "No such file" in p.stderr else None)


def backup():
    dest = run(["tmutil", "destinationinfo"])
    tm_dest = len(re.findall(r"^Name\s*:", dest, re.M))
    tm_last = None
    if tm_dest:
        m = re.search(r"(\d{4}-\d{2}-\d{2}-\d{6})", run(["tmutil", "latestbackup"], 60))
        if m:
            tm_last = datetime.datetime.strptime(m.group(1), "%Y-%m-%d-%H%M%S").timestamp()
    priv = git_ts(str(JARVIS / "private"), "-1", "@{u}")
    unpushed, noremote = [], []
    for g in glob.glob(HOME + "/Projects/*/.git"):
        repo = os.path.dirname(g)
        if not run(["git", "-C", repo, "remote"], 10).strip():
            noremote.append(os.path.basename(repo))
            continue
        ts = git_ts(repo, "@{u}..HEAD")
        if ts and "fatal" not in run(["git", "-C", repo, "rev-parse", "@{u}"], 10):
            unpushed.append((os.path.basename(repo), len(ts), min(ts)))
    return dict(tm_dest=tm_dest, tm_last=tm_last, private_last=priv[0] if priv else None,
                icloud_docs=icloud_docs(),
                unpushed=sorted(unpushed, key=lambda x: -x[1]), noremote=sorted(noremote))


def read_facts(weekly):
    t0 = time.time()
    rows = ps_rows()
    ram_mb = int(run(["sysctl", "-n", "hw.memsize"]).strip() or 0) / 1048576
    boot = re.search(r"sec = (\d+)", run(["sysctl", "-n", "kern.boottime"]))
    uptime_h = (time.time() - int(boot.group(1))) / 3600 if boot else 1
    st = os.statvfs(HOME)
    f = dict(now=time.time(), weekly=weekly, ram_mb=ram_mb, uptime_h=uptime_h,
             disk=dict(free_gb=st.f_bavail * st.f_frsize / 1e9, total_gb=st.f_blocks * st.f_frsize / 1e9),
             startup=btm_items(), failures=launchd_failures(uptime_h), orphans=orphan_plists(),
             resti=resti(devreap_list()), memlog=memlog_report(), posture=posture(),
             extensions=extensions(), backup=backup(), agents=agents(time.time()), blind=[], blind_keys=[])
    net = network(rows)
    if net is None:
        f["blind"].append("lsof non ha risposto: connessioni e porte in LAN NON controllate")
        f["blind_keys"].append("net")
        net = ([], {})
    f["net"], f["lan"] = net
    if not f["startup"]:
        f["blind"].append(BLIND_SFL)
        f["blind_keys"].append("startup")
    f["odd"] = [dict(path=r["exe"], signer=signer(r["exe"])) for r in rows
                if r["exe"].startswith(ODD_DIRS) and os.path.exists(r["exe"])]
    if not weekly:
        f["procs"] = processes(rows, ram_mb)
        open_dirs = [d for d in PROTECTED if readable(f"{HOME}/{d}")]
        shut = [d for d in PROTECTED if d not in open_dirs]
        if shut:
            f["blind"].append(f"{', '.join(shut)} non leggibili da qui (permesso File e cartelle di macOS): "
                              "spazio, installer e doppioni li' dentro NON controllati")
        dirs, big = du_scan(sorted(e.path for e in os.scandir(HOME) if e.name not in shut))
        f["storage"] = storage(dirs, big, open_dirs)
        f["apps"] = unused_apps({r["exe"] for r in rows})
    f["seconds"] = round(time.time() - t0)
    try:
        f["baseline"] = json.load(open(STATE))
    except Exception:
        f["baseline"] = None
    try:
        f["accepted"] = json.load(open(ACCEPT))
    except Exception:
        f["accepted"] = []
    return f


def _ro(path):
    import sqlite3
    return sqlite3.connect(f"file:{path}?mode=ro", uri=True, timeout=5)


def _iso(t):
    try:
        return datetime.datetime.fromisoformat(t.replace("Z", "+00:00")).timestamp() if t else None
    except ValueError:
        return None


def agents(now):
    """Lavori lunghi degli ultimi AGENTS_DAYS: quanti, quanti arrivati in fondo. None = fonte illeggibile."""
    since, long_s = now - AGENTS_DAYS * DAY, AGENTS_LONG_MIN * 60
    out = dict(claude=None, topics=None, orphans=None, gb=None)
    try:  # claude -p da OpenClaw: modello anthropic/*, runtime claude-cli
        n = ok = 0
        for pj, in _ro(OPENCLAW_DB).execute("SELECT payload_json FROM subagent_runs WHERE created_at >= ?", (since * 1000,)):
            r = json.loads(pj)
            if not str(r.get("model") or "").startswith("anthropic/"):
                continue
            ex = r.get("execution") or {}
            a, b, st = ex.get("startedAt"), ex.get("endedAt"), (ex.get("outcome") or {}).get("status")
            if b is None and a and now - a / 1000 < 2 * 3600:
                continue  # ancora vivo: non e' ne' finito ne' perso
            if b is not None and a and (b - a) / 1000 < long_s and st != "timeout":
                continue
            n += 1
            ok += b is not None and st == "ok"
        out["claude"] = dict(n=n, ok=ok)
    except Exception:
        pass
    try:  # Topics: sotto-agenti (spawn_agent) e tentativi delle card
        n = ok = lost = 0
        db = _ro(TOPICS_DB)
        rows = [(s_, a, b, s_ == "retired", s_ == "lost") for s_, a, b in
                db.execute("SELECT state, created_at, ended_at FROM subagents WHERE state NOT IN ('running','stopped')")]
        rows += [(s_, a, b, s_ in ("delivered", "selected", "discarded"), False) for s_, a, b in
                 db.execute("SELECT state, created_at, ended_at FROM task_attempts WHERE state != 'running'")]
        for _, a, b, good, gone in rows:
            ta, tb = _iso(a), _iso(b)
            if ta is None or ta < since:
                continue
            if not gone and (tb is None or tb - ta < long_s):
                continue
            n += 1; ok += good; lost += gone
        out["topics"] = dict(n=n, ok=ok, lost=lost)
    except Exception:
        pass
    try:  # orfani lasciati dai terminali di Topics, e GB fissi delle due app
        import ctypes
        resp = ctypes.CDLL(None).responsibility_get_pid_responsible_for_pid
        resp.restype, resp.argtypes = ctypes.c_int, [ctypes.c_int]
        procs = {}
        for line in run(["ps", "-Ao", "pid=,ppid=,command="]).splitlines():
            m = re.match(r"\s*(\d+)\s+(\d+)\s+(.*)", line)
            if m:
                procs[int(m[1])] = (int(m[2]), m[3])
        host = {p for p, (_, c) in procs.items() if "Topics Host.app" in c}
        out["orphans"] = sum(1 for p, (pp, _) in procs.items() if pp == 1 and p not in host and resp(p) in host)
        fp = lambda keys: sum(memhog.footprint_mb(p) or 0 for p, (_, c) in procs.items() if any(k in c for k in keys)) / 1024
        # il nucleo di ciascuna app; i processi delle sessioni (CLI, MCP) pesano uguale da tutte e due le parti
        out["gb"] = dict(topics=fp(["topics-app/server.ts", "topics-app/server/ai-bridge.mjs", "Topics Host.app", "Topics.app/Contents/MacOS"]),
                         claude=fp(["/Applications/Claude.app/Contents/"]))
    except Exception:
        pass
    return out


def rate(x):
    return None if not x or not x["n"] else 100 * x["ok"] / x["n"]


