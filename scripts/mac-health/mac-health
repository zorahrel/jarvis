                f"Barra: {bar}{'' if plain_bar else '; il prossimo mac-health non lo riporta'}.\n\nRapporto: {short(report)}")
        out.append(dict(key=f"mac-health:{key}", finding=key, title=f"[Jarvis] {title}", desc=desc, notte=notte, dir=str(where)))
