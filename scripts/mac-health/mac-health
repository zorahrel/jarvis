def cards(f, keep, report):
    """Le righe che un agente sa curare, come card: una per chiave stabile (board-card non fa doppioni),
    con la prova, la cura proposta e la barra. Restano ad Attilio, e quindi su WhatsApp, quelle che solo
    lui puo' decidere: sicurezza, i suoi repo, file, app e processi suoi, e cio' che gira come root
    (/Library/LaunchDaemons: vuole la sua password)."""
    uid = os.getuid()
    fail = {x["label"]: x for x in f["failures"]}
    orph = {o["label"]: o for o in f.get("orphans") or []}
    btm = {i["id"]: i for i in f["startup"]}
    day = datetime.date.fromtimestamp(f["now"]).strftime("%d/%m")
    out = []
    for _, key, line, *_ in keep:
        kind, _, name = key.partition(":")[2].partition(":")
        plain_bar = False
        job, notte = f"gui/{uid}/{name}", True  # notte: reversibile e non aspetta Attilio (board-card --notte)
        if kind in ("loop", "failed", "killed") and name in ATTILIO_CHOICES:
            continue  # la cura e' una scelta di Attilio: la riga resta nel messaggio per lui
        x = fail.get(name, {})
        where = JARVIS  # dove lavora la coda notturna; per i job, la loro cartella
        gone = x.get("gone") if kind in ("loop", "failed", "killed") and x.get("domain") == "gui" else None
        if kind in ("loop", "failed", "killed") and x.get("domain") == "gui":
