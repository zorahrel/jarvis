def check(name, facts, expect_substr):
    """expect_substr None = nessuna riga; altrimenti una riga deve contenerlo."""
    global fails
    lines = [x[2] for x in mh.findings(facts)]
    ok = (not lines) if expect_substr is None else any(expect_substr in l for l in lines)
    print(f"{'ok  ' if ok else 'FAIL'} {name}" + ("" if ok else f"  -> {lines}"))
    fails += not ok


ERR = []


def safe(thunk):
    try:
        return thunk()
    except Exception as e:
        ERR.append(f"{type(e).__name__}: {e}")
        return False


def f(**patch):
    x = copy.deepcopy(BASE)
    for k, v in patch.items():
        cur = x
        *path, last = k.split("__")
        for p in path:
            cur = cur[p]
        cur[last] = v
    return x


