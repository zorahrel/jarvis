#!/usr/bin/env python3
"""Riavvio veloce del gateway OpenClaw senza perdere lavoro.

OpenClaw non riprende i sottoagenti che un riavvio interrompe: li segna interrupted e poi
subagent-error, e nessuno li rilancia (misurato 15/10: 7 su 7 fermi). Aspettare che finiscano non
serve, durano 30-80 minuti (--safe ha atteso 10 minuti e li ha interrotti lo stesso). Quindi:

  oc-restart                 NON taglia turni: se c'e' lavoro in corso (sottoagenti, run cron, chat che
                             risponde) si stacca in background e riavvia da solo appena il gateway e'
                             libero (max 6 h, poi riavvia comunque con la ripresa); se e' libero riavvia
                             subito. Chi lo chiama da dentro un turno non resta bloccato: il suo turno
                             finisce e il riavvio parte dopo.
  oc-restart --now           riavvia adesso come prima (taglia i turni vivi e li riprende): solo per un
                             gateway rotto (WhatsApp bloccato, heartbeat morto)
  oc-restart --resume-since N  solo la ripresa: sottoagenti finiti male negli ultimi N minuti
  oc-restart --dry-run       dice cosa farebbe e cosa blocca, non riavvia e non scrive a nessuno

La ripresa e' un messaggio interno alla sessione del canale che li aveva lanciati (senza --deliver):
e' quell'agente a ricontrollare git/worktree e a rilanciarli, con il contesto che ha gia'."""
import json, os, re, sqlite3, subprocess, sys, time, urllib.request
from pathlib import Path

DB = Path.home() / ".openclaw/state/openclaw.sqlite"
LOGDIR = Path("/tmp/openclaw")
STATE = Path.home() / ".claude/jarvis/state"
LABEL = "ai.openclaw.gateway"
UP_S = 240                    # tempo concesso a gateway e WhatsApp per tornare su
BAD_END = ("subagent-error", "subagent-killed")
OC_CONFIG = Path.home() / ".openclaw/openclaw.json"
DISCORD_AGENT = {"default": "main", "visione": "gtm"}  # account Discord -> agente che lo serve
ACTIVE_DAYS = 3               # canali con una sessione viva negli ultimi giorni


# Con completionTarget «parent» il record del sottoagente sta dentro parentCompletion (81 righe al 22/10):
# il filtro lo prendeva per una riga di servizio e Note spese, morto nel riavvio delle 12:56, non e' ripartito.
STATUS = ("coalesce(json_extract(payload_json,'$.execution.status'), "
          "json_extract(payload_json,'$.parentCompletion.execution.status'))")
ENDED = ("coalesce(json_extract(payload_json,'$.execution.endedAt'), "
         "json_extract(payload_json,'$.parentCompletion.execution.endedAt'), created_at)")


def payload(raw):
    d = json.loads(raw)
    return d.get("parentCompletion") or d


def why_failed(p):
    return (((p.get("execution") or {}).get("outcome") or {}).get("error") or "")[:120]


def rows(sql, args=()):
    con = sqlite3.connect(f"file:{DB}?mode=ro", uri=True, timeout=10)
    try:
        return [payload(r[0]) | {"_run": r[1], "_req": r[2]} for r in con.execute(sql, args)]
    finally:
        con.close()


def running():
    return rows("select payload_json, run_id, requester_session_key from subagent_runs "
                f"where {STATUS} not in ('terminal')")


def lost_since(ms):
    """Finiti male (errore/ucciso) o mai consegnati, partiti o chiusi dopo ms."""
    out = []
    for p in rows("select payload_json, run_id, requester_session_key from subagent_runs "
                  f"where {ENDED} >= ?", (ms,)):
        ex, dl = p.get("execution") or {}, p.get("delivery") or {}
        if not p.get("label"):
            continue  # righe di servizio senza compito proprio
        bad = p.get("endedReason") in BAD_END or ex.get("status") == "interrupted"
        undelivered = ex.get("status") == "terminal" and dl.get("status") not in ("delivered", None)
        if bad or undelivered:
            out.append(p)
    return out


TERMINAL = (None, "done", "failed", "interrupted", "killed", "timeout")  # isTerminalSessionStatus di OpenClaw
REPLY_WAIT_S = 120


def replying():
    """Chat con un turno in corso (sottoagenti e cron esclusi: per loro c'e' la ripresa).
    Un riavvio a meta' risposta lascia la consegna «incerta» e alla prossima domanda OpenClaw manda
    «I couldn't confirm whether my previous reply reached this chat» (22/10, 16:30 dopo un oc-restart)."""
    out = subprocess.run(["openclaw", "sessions", "--active", "15", "--all-agents", "--json"],
                         capture_output=True, text=True, timeout=60).stdout
    try:
        d = json.loads(out)
    except ValueError:
        return []
    ss = d.get("sessions", []) if isinstance(d, dict) else d
    return [s["key"] for s in ss if s.get("status") not in TERMINAL
            and ":subagent:" not in s.get("key", "") and ":cron:" not in s.get("key", "")]


def wait_replies(dry):
    end = time.time() + REPLY_WAIT_S
    busy = replying()
    while busy and not dry and time.time() < end:
        time.sleep(5)
        busy = replying()
    if busy:
        print(f"risposta ancora in corso in {', '.join(busy)}" + ("" if dry else f": riavvio dopo {REPLY_WAIT_S} s lo stesso"))


IDLE_QUIET_S = 20            # gateway libero per tanto di fila prima di riavviare
IDLE_POLL_S = 5
IDLE_MAX_WAIT_S = 6 * 3600


def blockers():
    """Lavoro che un riavvio taglierebbe: sottoagenti vivi, run cron in corso, chat che sta rispondendo."""
    out = [("sottoagente", p.get("label", "?")) for p in running()]
    out += [("chat", k) for k in replying()]
    con = sqlite3.connect(f"file:{DB}?mode=ro", uri=True, timeout=10)
    try:
        for (job,) in con.execute("select job_id from cron_run_receipts where status='running' and started_at_ms > ?",
                                  ((time.time() - 7200) * 1000,)):
            out.append(("cron", job[:8]))
    finally:
        con.close()
    return out


def wait_idle(max_wait=IDLE_MAX_WAIT_S):
    """Aspetta gateway libero per IDLE_QUIET_S di fila. True = libero, False = scaduto il tempo."""
    end, quiet_since = time.time() + max_wait, None
    while time.time() < end:
        b = blockers()
        if b:
            quiet_since = None
        elif quiet_since is None:
            quiet_since = time.time()
        elif time.time() - quiet_since >= IDLE_QUIET_S:
            return True
        time.sleep(IDLE_POLL_S)
    return False


def log_request(mode, busy):
    """Chi chiede un riavvio e quando: la catena dei processi padre, per trovare chi lo fa."""
    chain, pid = [], os.getppid()
    for _ in range(6):
        r = subprocess.run(["ps", "-o", "ppid=,command=", "-p", str(pid)], capture_output=True, text=True).stdout.strip()
        if not r:
            break
        ppid, _, cmd = r.partition(" ")
        chain.append(cmd.strip()[:90])
        pid = int(ppid) if ppid.strip().isdigit() else 0
        if pid <= 1:
            break
    STATE.mkdir(parents=True, exist_ok=True)
    with open(STATE / "oc-restart-requests.jsonl", "a") as f:
        f.write(json.dumps({"t": time.strftime("%Y-%m-%dT%H:%M:%S"), "mode": mode, "bloccanti": len(busy), "chain": chain}) + "\n")


def gateway_pid():
    out = subprocess.run(["launchctl", "print", f"gui/{os.getuid()}/{LABEL}"], capture_output=True, text=True).stdout
    m = re.search(r"^\s*pid = (\d+)", out, re.M)
    return m and m.group(1)


def whatsapp_listening_after(ts):
    """True se un log di oggi dice «Listening for WhatsApp» dopo ts (epoch)."""
    stamp = time.strftime("%Y-%m-%dT%H:%M:%S", time.localtime(ts))
    for f in sorted(LOGDIR.glob(f"openclaw-{time.strftime('%Y-%m-%d')}*.log")):
        with open(f, errors="replace") as fh:
            for line in fh:
                if "Listening for WhatsApp" in line:
                    m = re.search(r'"time":"([^".+]+)', line)
                    if m and m.group(1) >= stamp:
                        return True
    return False


def restart():
    old, t0 = gateway_pid(), time.time()
    r = subprocess.run(["openclaw", "gateway", "restart", "--force", "--json"], capture_output=True, text=True, timeout=180)
    if r.returncode:
        # esce 1 anche quando il riavvio c'e' stato: la sua sonda da 3 s scade su un gateway che
        # sta ancora salendo (15/10). Decide il pid nuovo qui sotto, non questo exit code.
        print(f"restart --force: exit {r.returncode}, controllo il pid")
    end, pid = t0 + UP_S, None
    while time.time() < end:
        time.sleep(3)
        pid = gateway_pid()
        if pid and pid != old and whatsapp_listening_after(t0):
            print(f"gateway su (pid {old} -> {pid}) e WhatsApp in ascolto in {time.time() - t0:.0f} s")
            return t0
    sys.exit(f"dopo {UP_S} s: pid {pid} (era {old}), WhatsApp in ascolto: {whatsapp_listening_after(t0)}")


def discord_get(token, path):
    req = urllib.request.Request("https://discord.com/api/v10" + path, headers={
        "Authorization": f"Bot {token}", "User-Agent": "DiscordBot (jarvis-oc-restart, 1.0)"})
    with urllib.request.urlopen(req, timeout=20) as r:
        return json.load(r)


def snowflake(ms):
    return str((int(ms) - 1420070400000) << 22)


def resolve_token(tok):
    """Stringa o SecretRef del Keychain ({"provider": "keychain", "id": "servizio/account"}). Dal passaggio dei
    token al Keychain discord_missed saltava in silenzio ogni account: «0 messaggi» anche quando ce n'erano."""
    if isinstance(tok, str):
        return tok
    if isinstance(tok, dict) and tok.get("provider") == "keychain" and "/" in tok.get("id", ""):
        service, _, account = tok["id"].partition("/")
        r = subprocess.run(["/usr/bin/security", "find-generic-password", "-s", service, "-a", account, "-w"],
                           capture_output=True, text=True)
        return r.stdout.strip() if r.returncode == 0 else None
    return None


def discord_missed(since_ms, until_ms):
    """Messaggi umani arrivati su Discord a gateway giu' e mai registrati nella sessione del canale.
    Discord non riconsegna gli eventi persi: senza questo un messaggio scritto durante il riavvio
    resta senza risposta. Ritorna {session_key: [righe]}."""
    accounts = ((json.loads(OC_CONFIG.read_text()).get("channels") or {}).get("discord") or {}).get("accounts") or {}
    con = sqlite3.connect(f"file:{DB}?mode=ro", uri=True, timeout=10)
    out = {}
    try:
        cutoff = (time.time() - ACTIVE_DAYS * 86400) * 1000
        for acc, agent in DISCORD_AGENT.items():
            token = resolve_token((accounts.get(acc) or {}).get("token"))
            if not token:
                print(f"  discord {acc}: token non leggibile, canali non controllati")
                continue
            keys = [r[0] for r in con.execute(
                "select session_key from session_state_heads where agent_id=? and session_key like ? and updated_at>=?",
                (agent, f"agent:{agent}:discord:channel:%", cutoff))]
            for key in keys:
                chan = key.rsplit(":", 1)[-1]
                try:
                    msgs = discord_get(token, f"/channels/{chan}/messages?limit=50&after={snowflake(since_ms)}")
                except Exception as e:
                    print(f"  discord {chan}: lettura fallita ({e})")
                    continue
                # visto = gia' entrato nella coda di ingresso di quell'account (event_id = id del messaggio)
                ids = [m["id"] for m in msgs]
                seen = {r[0] for r in con.execute(
                    f"select event_id from channel_ingress_events where account_id=? and event_id in ({','.join('?' * len(ids))})",
                    (acc, *ids))} if ids else set()
                lines = []
                for m in sorted(msgs, key=lambda m: m["id"]):
                    if (m.get("author") or {}).get("bot"):
                        continue
                    ts = (int(m["id"]) >> 22) + 1420070400000
                    if ts > until_ms or m["id"] in seen:
                        continue
                    who = (m.get("author") or {}).get("global_name") or (m.get("author") or {}).get("username", "?")
                    lines.append(f"[{time.strftime('%H:%M', time.localtime(ts / 1000))}] {who} (<@{(m.get('author') or {}).get('id')}>): {m.get('content', '')[:1500]}")
                if lines:
                    out[key] = lines
    finally:
        con.close()
    return out


def discord_catchup(since_ms, until_ms, dry):
    missed = discord_missed(since_ms, until_ms)
    print(f"Discord: {sum(len(v) for v in missed.values())} messaggi arrivati a gateway giu' in {len(missed)} canali")
    procs = []
    for key, lines in missed.items():
        msg = ("Nota di servizio (riavvio del gateway): mentre era giu' in questo canale sono arrivati questi "
               "messaggi, che non hai ricevuto. Trattali come appena arrivati, con le regole di questo canale "
               "(menzioni comprese): se non ti riguardano, NO_REPLY. La tua risposta finale arriva nel canale cosi' "
               "com'e': scrivila per chi e' nel canale e non mandarla anche con message(send), senza riepiloghi per me "
               "(22/10: un riepilogo in inglese e' finito in #mooncircles-development).\n\n" + "\n".join(lines))
        print(f"  {key}: {len(lines)}")
        if dry:
            continue
        out = STATE / f"oc-restart-discord-{time.strftime('%Y%m%d-%H%M%S')}-{key.rsplit(':', 1)[-1]}.log"
        STATE.mkdir(parents=True, exist_ok=True)
        # --deliver: la risposta deve arrivare nel canale come una normale
        procs.append(subprocess.Popen(["sh", "-c", 'for i in 1 2 3; do openclaw agent --session-key "$1" --message "$2" '
                                       '--deliver --timeout 1800 --json && exit 0; echo "tentativo $i fallito"; sleep 30; done; exit 1',
                                       "oc-restart", key, msg],
                                      stdout=open(out, "w"), stderr=subprocess.STDOUT, start_new_session=True))
        print(f"  esito in {out}")
    return procs


def resume_message(items, why):
    """Testo della nota di servizio al genitore; usato anche da subagent-watchdog."""
    lines = [f"- «{p['label']}» (run {p['_run'][:8]}, partito alle "
             f"{time.strftime('%H:%M', time.localtime(p.get('createdAt', 0) / 1000))}, "
             f"{p.get('endedReason') or (p.get('execution') or {}).get('status')}, "
             f"consegna {(p.get('delivery') or {}).get('status')})" + (f": {why_failed(p)}" if why_failed(p) else "")
             for p in items]
    return (f"Nota di servizio ({why}): questi tuoi sottoagenti sono stati "
            "interrotti prima di finire, o il loro resoconto non e' arrivato.\n" + "\n".join(lines) +
            "\n\nPer ciascuno: controlla cosa c'e' gia' (git, worktree, file), poi rilancialo con lo stesso "
            "compito dicendogli di riprendere da li', non da zero. Se risulta gia' finito, riporta l'esito "
            "nel canale come faresti normalmente. Se l'errore accanto dice che rilanciarlo uguale fallirebbe "
            "di nuovo (quota, credito, lo stesso bug), non rilanciarlo: scrivilo nel canale. "
            "Non serve rispondere a questa nota.")


def resume(lost, when, dry):
    by_req = {}
    for p in lost:
        by_req.setdefault(p["_req"], []).append(p)
    procs = []
    for req, items in by_req.items():
        msg = resume_message(items, f"riavvio del gateway delle {when}")
        print(f"{req}: {len(items)} da riprendere")
        if dry:
            continue
        # l'esito va su file: il 15/10 una nota spedita a gateway ancora in salita e' sparita in silenzio
        out = STATE / f"oc-restart-resume-{time.strftime('%Y%m%d-%H%M%S')}-{req.rsplit(':', 1)[-1]}.log"
        STATE.mkdir(parents=True, exist_ok=True)
        procs.append(subprocess.Popen(["sh", "-c", 'for i in 1 2 3; do openclaw agent --session-key "$1" --message "$2" '
                                       '--timeout 1800 --json && exit 0; echo "tentativo $i fallito"; sleep 30; done; exit 1',
                                       "oc-restart", req, msg],
                                      stdout=open(out, "w"), stderr=subprocess.STDOUT, start_new_session=True))
        print(f"  esito in {out}")
    return procs


def main():
    a = sys.argv[1:]
    # un'opzione sconosciuta (--help, -h, refusi) non deve riavviare: il 15/10 «--help» ha riavviato davvero
    unknown = [x for x in a if x.startswith("-") and x not in ("--dry-run", "--resume-since", "--now", "--wait-idle")]
    if unknown:
        print(__doc__)
        sys.exit(0 if set(unknown) <= {"-h", "--help"} else 2)
    dry = "--dry-run" in a
    if "--resume-since" in a:
        mins = float(a[a.index("--resume-since") + 1])
        lost = lost_since((time.time() - mins * 60) * 1000)
        print(f"{len(lost)} sottoagenti da riprendere degli ultimi {mins:g} min")
        resume(lost, time.strftime("%H:%M"), dry)
        discord_catchup((time.time() - mins * 60) * 1000, time.time() * 1000, dry)
        return 0
    now_mode, wait_mode = "--now" in a, "--wait-idle" in a
    busy = blockers()
    if dry:
        print(f"{len(busy)} cose in corso: " + (", ".join(f"{k} {v}" for k, v in busy) or "nessuna"))
        print("riavvierebbe subito" if now_mode or not busy else "si staccherebbe e aspetterebbe il gateway libero")
        return 0
    if not now_mode and not wait_mode:
        log_request("default", busy)
        if busy:
            STATE.mkdir(parents=True, exist_ok=True)
            out = STATE / f"oc-restart-wait-{time.strftime('%Y%m%d-%H%M%S')}.log"
            subprocess.Popen([sys.executable, str(Path(__file__).resolve()), "--wait-idle"],
                             stdout=open(out, "w"), stderr=subprocess.STDOUT, start_new_session=True)
            print(f"rimandato: {len(busy)} cose in corso ({', '.join(f'{k} {v}' for k, v in busy[:5])}). "
                  f"Riavvio da solo appena il gateway e' libero (max 6 h). Esito in {out}")
            return 0
    elif now_mode:
        log_request("now", busy)
    if wait_mode:
        print(f"{time.strftime('%H:%M:%S')} attendo il gateway libero")
        ok = wait_idle()
        print(f"{time.strftime('%H:%M:%S')} " + ("gateway libero" if ok else "tempo scaduto: riavvio comunque con la ripresa"))
    alive = running()
    print(f"{len(alive)} sottoagenti vivi: " + ", ".join(p.get("label", "?") for p in alive))
    if not wait_mode:
        wait_replies(dry)
    STATE.mkdir(parents=True, exist_ok=True)
    snap = STATE / f"oc-restart-{time.strftime('%Y%m%d-%H%M%S')}.json"
    snap.write_text(json.dumps([{"run": p["_run"], "req": p["_req"], "label": p.get("label")} for p in alive], ensure_ascii=False))
    t0 = restart()
    time.sleep(20)  # l'avvio marca gli orfani come interrupted/subagent-error
    ids = {p["_run"] for p in alive}
    lost = [p for p in lost_since((t0 - 60) * 1000) if p["_run"] in ids]
    print(f"{len(lost)} su {len(alive)} interrotti dal riavvio")
    resume(lost, time.strftime("%H:%M", time.localtime(t0)), False)
    discord_catchup((t0 - 60) * 1000, time.time() * 1000, False)
    return 0


if __name__ == "__main__":
    sys.exit(main())
