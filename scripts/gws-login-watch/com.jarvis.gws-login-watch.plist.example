<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.jarvis.gws-login-watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/zorahrel/.claude/jarvis/scripts/gws-login-watch/gws-login-watch</string>
  </array>
  <!-- Ogni 10 min: guarda solo se i file del login ci sono, 0,05 s a giro. Il token in memoria dura un'ora,
       quindi la voce in «Ti aspetta» arriva prima del primo cron rotto. -->
  <key>StartInterval</key><integer>600</integer>
  <key>RunAtLoad</key><true/>
  <key>Nice</key><integer>5</integer>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key><string>/Users/zorahrel</string>
  </dict>
  <key>StandardOutPath</key><string>/dev/null</string>
  <key>StandardErrorPath</key><string>/Users/zorahrel/.claude/jarvis/logs/gws-login-watch.err.log</string>
</dict>
</plist>
