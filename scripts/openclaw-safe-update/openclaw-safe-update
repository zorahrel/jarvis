def kickstart():
    """Riavvio del gateway via launchd (mai bootout). None = tornato su."""
    old = gateway_pid()
    rc, _, err = run(["launchctl", "kickstart", "-k", f"gui/{os.getuid()}/{LABEL}"], 60)
    if rc:
        return f"kickstart: {tail(err)}"
    end = time.time() + KICK_S
    while time.time() < end:
        time.sleep(min(POLL_S, 5))
        pid = gateway_pid()
        if pid and pid != old and gateway_up():
            log(f"gateway riavviato (pid {old} -> {pid})")
            return None
    return f"il gateway non e' tornato su entro {KICK_S:g} s dal kickstart"


def behind(app, cli):
    """True se la versione dell'app e' piu' vecchia di quella della CLI (il suffisso -N non conta), False se uguale o avanti."""
    return vtuple(base(app)) < vtuple(base(cli))


def app_version():
    try:
        with open(APP / "Contents/Info.plist", "rb") as f:
            return plistlib.load(f).get("CFBundleShortVersionString")
    except (OSError, ValueError, plistlib.InvalidFileException):
        return None  # anche a meta' della sostituzione del bundle da parte di Sparkle


def app_running():
    exe = str(APP / "Contents/MacOS/OpenClaw")
    _, out, _ = run(["ps", "-axo", "command="], 30)
    return any(c == exe or c.startswith(exe + " ") for c in (line.strip() for line in out.splitlines()))


def app_plan(cli):
    """La voce del piano di --dry-run per l'app del Mac: cosa farebbe align_app, senza toccare niente."""
    app = app_version()
    if not app:
        return "app del Mac non installata: niente"
    if not behind(app, cli):
        return f"app del Mac {app} " + ("come" if base(app) == base(cli) else "piu' nuova della") + f" CLI {cli}: niente"
    if not app_running():
        return f"app del Mac {app} ≠ CLI {cli}, ma chiusa: niente (Sparkle la aggiorna quando si apre)"
    return (f"app del Mac {app} ≠ CLI {cli}: quit e open -ga, solo a Mac fermo e OpenClaw fermo; se Sparkle non"
            " installa, prima chiude i suoi aiutanti rimasti col binario sparito")


def sparkle_leftovers():
    """Gli aiutanti di Sparkle di questa app rimasti da un update che non si installera' piu': l'Updater gira da un
    binario che non c'e' piu' (25/10: vivo dal 6/10, la sua cartella in ~/Library/Caches/ai.openclaw.mac finita nel
    Cestino), e l'Autoupdate dell'app si chiude con lui. Solo quelli di APP: l'Updater di ChatGPT e' identico.
    {pid: (avvio, comando)}, vuoto se nessun Updater e' orfano del suo binario."""
    updater = re.compile(r"(/.*?/" + re.escape(APP_ID) + r"/org\.sparkle-project\.Sparkle/.*?/Updater\.app/Contents"
                         r"/MacOS/Updater) " + re.escape(str(APP)) + r"(?: |$)")
    installer = re.compile(re.escape(str(APP / "Contents/Frameworks/Sparkle.framework")) + r"/.*/Autoupdate "
                           + re.escape(APP_ID) + r"(?: |$)")
    stale, installers = {}, {}
    for pid, (_, ident) in process_table().items():
        m = updater.match(ident[1])
        if m and not os.path.exists(m.group(1)):
            stale[pid] = ident
        elif installer.match(ident[1]):
            installers[pid] = ident
    return {**stale, **installers} if stale else {}


def align_app(cli):
    """L'app del Mac alla versione della CLI. Resta alla sua finche' qualcuno non la chiude, perche' Sparkle installa
    solo alla chiusura (25/10: app 2026.9.5 con CLI 2026.10.5, WebContent a 528 MB, l'Autoupdate in attesa dal 6/10).
    Gira dopo un update riuscito e nelle notti senza update. Quit e open -ga solo a Mac fermo e a OpenClaw fermo (l'app
    da' approvazioni e controllo del Mac ai turni); un'app chiusa da Attilio resta chiusa. Ritorna la riga per il log,
    None se l'app e' gia' allineata o non c'e'."""
    app = app_version()
    if not app or not behind(app, cli):
        return None  # allineata, o piu' nuova della CLI (un'app avanti non si riavvia: non c'e' niente da installare)
    if not app_running():
        return f"app OpenClaw {app} indietro sulla CLI {cli}, ma chiusa: Sparkle la aggiorna quando si apre"
    busy = wait_idle(APP_IDLE_MIN)
    if busy:
        return f"app OpenClaw {app} indietro sulla CLI {cli}: OpenClaw al lavoro ({', '.join(busy)}), non la riavvio"
    if run([MAC_LIBERO], 10)[0] != 0:
        return f"app OpenClaw {app} indietro sulla CLI {cli}: Mac in uso, non la riavvio"
    rc, _, err = run([OSASCRIPT, "-e", f'tell application id "{APP_ID}" to quit'], 30)
    # exit e stderr di osascript nel log: un -1743 (TCC nega gli Apple Event a launchd) sembrerebbe un'app lenta
    why = f" (osascript exit {rc}: {tail(err) or 'nessun messaggio'})" if rc else ""
    end = time.time() + APP_WAIT_S
    while app_running() and time.time() < end:
        time.sleep(1)
    if app_running():
        return f"app OpenClaw {app}: non si chiude entro {APP_WAIT_S:g} s, resta com'era{why}"
    # Sparkle sostituisce il bundle dopo la chiusura: si riapre quando la versione cambia, o allo scadere
    end = time.time() + APP_WAIT_S
    while app_version() in (app, None) and time.time() < end:
        time.sleep(2)
    now, cleaned = app_version(), ""
    if now == app:
        # un installer vivo da un update perso tiene occupato il posto: alla riapertura Sparkle non ne parte uno nuovo
        left = sparkle_leftovers()
        if left:
            term_then_kill(left, "aiutante di Sparkle rimasto da un update perso")
            cleaned = (f"; chiusi gli aiutanti di Sparkle rimasti {', '.join(map(str, sorted(left)))} (binario sparito):"
                       " Sparkle riscarica e installa alla prossima chiusura")
    rc = run([OPEN, "-ga", str(APP)], 30)[0]
    if now == app:
        return f"app OpenClaw riavviata ma ancora {app}: Sparkle non ha installato niente (open exit {rc}){cleaned}{why}"
    return f"app OpenClaw {app} -> {now}, riaperta in background (open exit {rc}){why}"


def pick_plugin_version(pkg, core):
    """(versione, nota): quella del core se pubblicata, se no la piu' alta compatibile."""
    vs = parse_json(run(["npm", "view", pkg, "versions", "--json"], 90)[1]) or []
    vs = [vs] if isinstance(vs, str) else vs
    for want in dict.fromkeys((core, base(core))):
        if want in vs:
            return want, None
    for v in sorted((v for v in vs if re.fullmatch(VER_RE, v) and vtuple(v) <= vtuple(core)), key=vtuple, reverse=True):
        need = parse_json(run(["npm", "view", f"{pkg}@{v}", "openclaw.compat.pluginApi", "--json"], 90)[1])
        m = re.search(VER_RE, str(need or ""))
        if not m or vtuple(m.group(0)) <= vtuple(core):
            return v, f"{pkg}@{core} non pubblicato, uso {v}"
    return None, f"nessuna versione di {pkg} compatibile con {core}"


def ensure_auto_off(notes):
    # un update puo' riscrivere la config: l'auto-update interno deve restare spento
    _, out, _ = oc(["config", "get", "update.auto.enabled"], 60)
    if out.strip() == "true":
        rc, _, err = oc(["config", "set", "update.auto.enabled", "false"], 60)
        notes.append("auto-update interno rispento" if rc == 0 else f"auto-update: config set fallito ({tail(err)})")


def converge(core, idle_minutes):
    """Plugin fissati e patch MCP a posto per `core`, con un solo riavvio e solo a OpenClaw fermo.
    Ritorna (problemi, note, rimandato). rimandato = serviva un riavvio ma OpenClaw non si e' mai
    fermato: niente riavvio, plugin e patch restano come sono e li sistema il giro dopo."""
    notes = []
    ensure_auto_off(notes)
    plugins = plugin_list()
    if PLUGIN not in plugins:
        return ["plugin whatsapp non trovato"], notes, False
    installs = {}
    for pid, pkg in misaligned(plugins, core).items():
        v, note = pick_plugin_version(pkg, core)
        if note:
            notes.append(note)
        if not v:
            return [note], notes, False
        installs[pid] = f"{pkg}@{v}"
    patch = None
    if mcp_lazy("check")[0]:
        if mcp_lazy("upstream")[0] == 0:
            # fix ufficiale nel codice: niente patch su dist, basta l'opt-in (si ricarica a caldo)
            rc, _, err = oc(["config", "set", "tools.toolSearch", "true"], 60)
            notes.append("fix MCP upstream: tools.toolSearch acceso" if rc == 0 else f"tools.toolSearch: {tail(err)}")
        else:
            patch = "apply"
    announce = announce_fix("check")[0] != 0
    durable = durable_view("check")[0] != 0
    outlimit = cli_output_limit("check")[0] != 0
    botmention = bot_mention("check")[0] != 0
    annsilent = announce_silent("check")[0] != 0
    # un plugin reinstallato perde la patch: dopo l'install va riapplicata comunque
    wacatchup = bool(installs) or wa_catchup("check")[0] != 0
    hbsub = hb_subagents("check")[0] != 0
    sessset = session_settings("check")[0] != 0
    pinned = pinned_fallback("check")[0] != 0
    descexp = descendant_expiry("check")[0] != 0
    cronddl = cron_receipt_ddl("check")[0] != 0
    cronhist = cron_history_names("check")[0] != 0
    if not (installs or patch or announce or durable or outlimit or botmention or annsilent or wacatchup or hbsub or sessset or pinned or descexp or cronddl or cronhist):
        return [], notes, False
    busy = wait_idle(idle_minutes, down_ok=True)
    if busy:
        why = f"OpenClaw mai fermo in {idle_minutes:g} min ({', '.join(busy)})"
        log(f"niente riavvio: {why}; plugin e patch MCP li sistema il giro dopo")
        return [], notes + [f"plugin/patch MCP rimandati: {why}"], True
    problems = []
    for spec in installs.values():
        log(f"plugin: openclaw plugins install {spec} --force --pin")
        rc, out, err = oc(["plugins", "install", spec, "--force", "--pin"], 300)
        # l'install a caldo puo' lasciare i canali fermi anche quando esce 1 (30/09 09:44):
        # il kickstart qui sotto parte comunque, subito
        if rc:
            problems.append(f"plugins install {spec}: exit {rc} {tail(err or out)}")
    if patch:
        rc, msg = mcp_lazy("apply")
        if rc:
            problems.append(f"patch MCP: {msg}")
    if announce:
        rc, msg = announce_fix("apply")
        notes.append(f"patch annunci non applicata: {msg}" if rc else "patch annunci applicata")
    if durable:
        rc, msg = durable_view("apply")
        notes.append(f"patch finali WhatsApp non applicata: {msg}" if rc else "patch finali WhatsApp applicata")
    if outlimit:
        rc, msg = cli_output_limit("apply")
        notes.append(f"patch tetti sottoagenti non applicata: {msg}" if rc else "patch tetti sottoagenti applicata")
    if botmention:
        rc, msg = bot_mention("apply")
        notes.append(f"patch tag tra bot non applicata: {msg}" if rc else "patch tag tra bot applicata")
    if annsilent:
        rc, msg = announce_silent("apply")
        notes.append(f"patch silenzio consegne non applicata: {msg}" if rc else "patch silenzio consegne applicata")
    if hbsub:
        rc, msg = hb_subagents("apply")
        notes.append(f"patch battito non applicata: {msg}" if rc else "patch battito applicata")
    if sessset:
        rc, msg = session_settings("apply")
        notes.append(f"patch sessione non pronta non applicata: {msg}" if rc else "patch sessione non pronta applicata")
    if pinned:
        rc, msg = pinned_fallback("apply")
        notes.append(f"patch ripiego silenzioso non applicata: {msg}" if rc else "patch ripiego silenzioso applicata")
    if descexp:
        rc, msg = descendant_expiry("apply")
        notes.append(f"patch consegne scadute non applicata: {msg}" if rc else "patch consegne scadute applicata")
    if cronddl:
        rc, msg = cron_receipt_ddl("apply")
        notes.append(f"patch exec integrity admission non applicata: {msg}" if rc else "patch exec integrity admission applicata")
    if cronhist:
        rc, msg = cron_history_names("apply")
        notes.append(f"patch storia con cron non applicata: {msg}" if rc else "patch storia con cron applicata")
    if wacatchup:
        rc, msg = wa_catchup("apply")
        notes.append(f"patch coda WhatsApp non applicata: {msg}" if rc else "patch coda WhatsApp applicata")
    err = kickstart()
    if err:
        problems.append(err)
    after = plugin_list()
    for pid, spec in installs.items():
        got, want = (after.get(pid) or {}).get("version"), spec.rsplit("@", 1)[1]
        if got != want:
            problems.append(f"plugin {pid} {got}, atteso {want}")
    if installs and not problems:
        notes.append("plugin -> " + ", ".join(f"{k} {v.rsplit('@', 1)[1]}" for k, v in installs.items()))
    return problems, notes, False


def heartbeat_job():
    d = oc_json(["cron", "list", "--all", "--json"], 90) or {}
    return next((j for j in d.get("jobs") or [] if j.get("name") == HEARTBEAT), None)


def heartbeat_last():
    """Com'e' finito l'ultimo heartbeat prima dell'update: [stato, errore], o None se non si sa."""
    st = (heartbeat_job() or {}).get("state") or {}
    return [st["lastRunStatus"], str(st.get("lastError") or "")] if st.get("lastRunStatus") else None


def heartbeat(before=None):
    """Un heartbeat vero: modello, tool MCP (con la patch), sessioni. None = andato.
    before: heartbeat_last() della fotografia; un esito uguale a quello di prima non e' dell'update."""
    job = heartbeat_job()
    if not job:
        return f"cron {HEARTBEAT} non trovato"
    rc, out, err = oc(["cron", "run", job["id"]], 120)
    d = parse_json(out) or {}
    if d.get("reason") == "already-running":
        # 15/10: battito appeso da prima (Muse a quota zero, bug #144400): non dice niente sulla
        # versione nuova. Bocciarla qui ha mandato in rollback una 10.3 sana.
        log("heartbeat: gia' in corso da prima del riavvio (#144400): non conta, giro vero non verificato")
        return None
    run_id = d.get("runId") if re.fullmatch(HB_RUN_RE, d.get("runId") or "") else None
    if not run_id:
        m = re.search(HB_RUN_RE, f"{out or ''}\n{err or ''}")
        run_id = m.group(0) if m else None
    if not run_id:
        return f"heartbeat: nessun run avviato (exit {rc} {tail(err or out)})"
    e = {}
    end = time.time() + HB_BUDGET_S
    while time.time() < end:
        e = ((oc_json(["cron", "runs", job["id"], "--run-id", run_id, "--limit", "1", "--json"], 90) or {})
             .get("entries") or [{}])[0]
        if e.get("status") in ("ok", "error", "skipped"):
            break
        time.sleep(min(POLL_S, 30))
    if e.get("status") not in ("ok", "error", "skipped"):
        return f"heartbeat: run {run_id} non finito in {HB_BUDGET_S / 60:.0f} min"
    error = str(e.get("error") or "")
    if e.get("status") != "ok" and KNOWN_DELIVERY_BUG in error:
        # bug openclaw#153453 (~1 heartbeat su 4 il 30/09, anche su 2026.9.5): il turno e' girato,
        # e' fallita solo la consegna. Non dice niente sulla versione nuova: bocciarla qui la
        # riporterebbe indietro per un difetto che ha anche la vecchia.
        log("heartbeat: turno eseguito, consegna fallita per il bug noto #153453: non conta")
        return None
    if e.get("status") != "ok" and [e.get("status"), error] == before:
        # 08/10: «skipped: alerts-disabled» da prima dell'update (heartbeatVisibility tutta spenta
        # dal 03/10, l'heartbeat non parte nemmeno). Bocciare la 9.8 per questo era un falso allarme.
        log(f"heartbeat: {e.get('status')} come prima dell'update ({error[:80]}): non conta, "
            "ma il giro vero non e' verificato")
        return None
    if e.get("status") != "ok":
        return f"heartbeat: {e.get('status')} {error[:120]}"
    return None


def health_gate(expected, rec, deferred=False):
    """Problemi NUOVI rispetto alla fotografia di prima: uno gia' rotto non e' colpa dell'update.
    deferred: la patch MCP e' rimandata al giro dopo, quindi la sua assenza e' attesa."""
    before = set(rec.get("problems") or [])
    end = time.time() + SETTLE_S
    while True:
        problems = [x for x in live_problems(expected) if x not in before]
        if not problems or time.time() >= end:
            break
        time.sleep(min(POLL_S, 10))
    if problems:
        return problems
    if not deferred:
        rc, msg = mcp_lazy("check")
        if rc:
            problems.append(f"patch MCP: {msg}")
    hb = heartbeat(rec.get("heartbeat"))
    if hb:
        problems.append(hb)
    new = sorted(set(doctor_fails()) - set(rec.get("doctor") or []))
    if deferred:
        new = [x for x in new if MCP_DOCTOR not in x]
    new = [x for x in new if ANNOUNCE_DOCTOR not in x]  # mai un rollback per lei: vedi ANNOUNCE_FIX
    new = [x for x in new if APP_DOCTOR not in x]  # ne' per l'app del Mac: vedi APP
    if new:
        problems.append("agents-doctor: " + "; ".join(new)[:240])
    return problems


def process_table():
    """{pid: (ppid, (avvio, comando))}: l'avvio distingue un pid riusato da quello visto prima."""
    _, out, _ = run(["ps", "-A", "-o", "pid=,ppid=,lstart=,command="], 30)
    table = {}
    for ln in out.splitlines():
        f = ln.split(None, 7)  # pid, ppid, lstart (5 campi), comando
        if len(f) == 8 and f[0].isdigit() and f[1].isdigit():
            table[int(f[0])] = (int(f[1]), (" ".join(f[2:7]), f[7]))
    return table


def descendants(pid):
    table, found, todo = process_table(), {}, [pid]
    while todo:
        parent = todo.pop()
        for child, (ppid, ident) in table.items():
            if ppid == parent and child not in found:
                found[child] = ident
                todo.append(child)
    return found


def kill_orphans(children):
    """Termina i figli dell'update interrotto che gli sono sopravvissuti (il 01/10 un
    update-candidate-state.worker.js era ancora vivo dopo il SIGINT). Solo i pid visti come suoi
    figli, con lo stesso avvio: il run che li possedeva e' morto."""
    end = time.time() + min(POLL_S, 10)  # tempo per uscire da soli
    while True:
        table = process_table()
        alive = {p: i for p, i in children.items() if (table.get(p) or (0, None))[1] == i}
        if not alive or time.time() >= end:
            break
        time.sleep(min(POLL_S, 1))
    term_then_kill(alive, "figlio dell'update interrotto ancora vivo")


def term_then_kill(alive, what):
    """TERM, 5 s per uscire, poi KILL; {pid: (avvio, comando)}, cosi' un pid riusato nel frattempo non si tocca."""
    for sig in (signal.SIGTERM, signal.SIGKILL):
        for p, ident in alive.items():
            log(f"{what}, {sig.name}: pid {p} {ident[1][:120]}")
            try:
                os.kill(p, sig)
            except OSError:
                pass
        end = time.time() + 5
        while alive and time.time() < end:
            time.sleep(0.2)
            table = process_table()
            alive = {p: i for p, i in alive.items() if (table.get(p) or (0, None))[1] == i}
        if not alive:
            return


def reconcile_ledger():
    """Chiude nello storico di OpenClaw un run rimasto `running` col driver morto: un SIGINT arrivato
    prima che l'update installi il suo gestore (01/10 00:18, 32 s dopo l'avvio) lo lascia li', e un
    run attivo blocca il prossimo update e le scritture di config finche' qualcuno non lo chiude.
    Si usa `openclaw update repair` (docs cli/update/repair-and-recovery.md), solo su un run prima
    dell'attivazione: col gateway sano e il driver morto chiude la riga come `failed/abandoned`
    senza Doctor ne' riavvii; un driver vivo lo rifiuta. In ogni altro caso repair ripiega sulla
    finalizzazione completa, che ferma il gateway per il Doctor: OPENCLAW_SERVICE_REPAIR_POLICY=
    external la fa fallire invece di fermarlo (doctor-maintenance salta lo stop del servizio).
    Ritorna True se nessun run resta attivo."""
    st = oc_json(["update", "status", "--json"], 60) or {}
    a = st.get("activeRun")
    if not a:
        return True
    rid = str(a.get("runId") or "?")[:8]
    if a.get("phase") not in PRE_ACTIVATION:
        log(f"run {rid} ancora attivo in fase {a.get('phase')}: non lo tocco")
        return False
    env = dict(os.environ, OPENCLAW_SERVICE_REPAIR_POLICY="external")
    rc, out, err = run(["openclaw", "update", "repair", "--yes", "--json"], 300, env)
    d = parse_json(out)
    d = d if isinstance(d, dict) else {}
    if rc == 0 and not (oc_json(["update", "status", "--json"], 60) or {}).get("activeRun"):
        log(f"storico update: run {rid} chiuso con update repair: {tail(d.get('message') or out)}")
        return True
    log(f"storico update: run {rid} resta attivo, update repair exit {rc}: {tail(err or out)}")
    return False


def clean_update_stages(root, since):
    """Le cartelle .openclaw.update-stage-* che l'update interrotto lascia accanto al pacchetto
    (~730 MB l'una, due il 01/10: OpenClaw non le riprende mai). Solo quelle nate durante questo
    update, e solo dopo che nessun run e' piu' attivo e i suoi figli sono morti."""
    if not root:
        return
    for p in sorted(Path(root).parent.glob(".openclaw.update-stage-*")):
        try:
            st = os.lstat(p)
            if not stat.S_ISDIR(st.st_mode) or st.st_mtime < since:
                continue
            size = tree_bytes(p)
            shutil.rmtree(p)
            log(f"cancellata {p.name} lasciata dall'update interrotto ({size / 1e6:.0f} MB)")
        except OSError as e:
            log(f"{p.name}: non cancellata ({e.strerror or e})")


CAPTURES = Path(str(OC_HOME) + ".update-captures")
CAPTURE_FRESH_S = 3600       # una copia piu' giovane di un'ora puo' essere di un update in corso
ORIGINALS_MIN_BYTES = 50e6   # sotto questa soglia i vecchi originali non valgono un riavvio del gateway


def clean_update_captures(dry):
    """Cancella le copie di ripristino che ogni tentativo di update lascia in ~/.openclaw.update-captures
    (~500 MB l'una, 13 per 6,2 GB il 25/10). `openclaw update cleanup` NON le tocca (ritira solo i vecchi
    originali di migrazione) e la documentazione dice che quelle copie non scadono mai da sole.
    Restano: la copia dell'ultimo update riuscito, quella dell'ultimo tentativo (e' lo stato prima di
    un guasto fresco), le copie senza riga nello storico, quelle di un run non finito e quelle giovani.
    Senza un update riuscito nello storico non si cancella nulla."""
    if not CAPTURES.is_dir():
        return
    try:
        con = sqlite3.connect(f"file:{OC_HOME / 'state/openclaw.sqlite'}?mode=ro", uri=True, timeout=5)
        try:
            runs = con.execute("SELECT run_id, status, reason, created_at_ms FROM update_runs").fetchall()
        finally:
            con.close()
    except sqlite3.Error as e:
        log(f"copie di ripristino: storico update illeggibile ({e}), non cancello niente")
        return
    ok = [r[3] for r in runs if r[1] == "succeeded"]
    if not ok:
        return
    present = {d.name for d in CAPTURES.iterdir()}
    newest = max((r for r in runs if r[0] in present), key=lambda r: r[3], default=None)
    keep = {r[0] for r in runs if r[1] == "running" or r[3] == max(ok)} | ({newest[0]} if newest else set())
    known = {r[0] for r in runs}
    freed = n = 0
    for d in sorted(CAPTURES.iterdir()):
        try:
            if not d.is_dir() or d.is_symlink() or d.name in keep or d.name not in known:
                continue
            if time.time() - os.lstat(d).st_mtime < CAPTURE_FRESH_S:
                continue
            size = tree_bytes(d)
            if not dry:
                shutil.rmtree(d)
            freed += size
            n += 1
        except OSError as e:
            log(f"copia di ripristino {d.name[:8]}: non cancellata ({e.strerror or e})")
    if n:
        log(f"copie di ripristino: {n} " + ("da cancellare" if dry else "cancellate") + f" ({freed / 1e9:.1f} GB); "
            f"resta quella dell'ultimo update riuscito")


def retire_originals(dry):
    """Ritira i vecchi originali di migrazione col comando nativo `openclaw update cleanup`. Vuole il
    gateway fermo (tiene il possesso dello stato: «blocked» a gateway acceso, provato il 26/10), quindi
    stop/start di servizio, solo se la anteprima dice che vale e nessuna persona sta scrivendo."""
    rc, out, err = run(["openclaw", "update", "cleanup", "--dry-run", "--json"], 120)
    d = parse_json(out)
    cand = ((d or {}).get("totals") or {}).get("candidateBytes") if isinstance(d, dict) else None
    if not cand:
        return
    log(f"originali di migrazione ritirabili: {cand / 1e6:.0f} MB" + (" (dry-run: non li tocco)" if dry else ""))
    if dry or cand < ORIGINALS_MIN_BYTES:
        return
    busy = busy_reasons()
    if busy:
        log("originali di migrazione: gateway non lo fermo adesso (" + ", ".join(busy) + "), riprovo la notte prossima")
        return
    run(["openclaw", "gateway", "stop", "--force"], 120)  # --force: da launchd non c'e' un terminale interattivo
    end = time.time() + 30
    while time.time() < end and gateway_up():
        time.sleep(1)
    try:
        rc, out, err = run(["openclaw", "update", "cleanup", "--yes", "--json"], 600)
        d = parse_json(out)
        t = (d or {}).get("totals") or {} if isinstance(d, dict) else {}
        log(f"originali di migrazione: exit {rc}, ritirati {(t.get('removedBytes') or 0) / 1e6:.0f} MB"
            + (f" ({tail(err)})" if rc else ""))
    finally:
        run(["openclaw", "gateway", "start"], 120)
        end = time.time() + KICK_S
        while time.time() < end and not gateway_up():
            time.sleep(min(POLL_S, 5))
        if not gateway_up():
            log("gateway non tornato su dopo il cleanup: " + (kickstart() or "riavviato con kickstart"))


def after_interrupt(children, started):
    """Dopo il SIGINT: niente figli orfani, niente run appeso nello storico, niente stage. Gli stage si
    cancellano comunque: il SIGINT arriva solo prima dell'attivazione e i figli sono gia' morti."""
    kill_orphans(children)
    reconcile_ledger()  # l'esito non decide piu': con repair che resta in sospeso (24/10) gli stage restavano li'
    root = ((oc_json(["update", "status", "--json"], 60) or {}).get("update") or {}).get("root")
    clean_update_stages(root, started - 5)


NO_INTERRUPT = False


# Il rollback e' un downgrade voluto: dalla 2026.10.8 OpenClaw lo rifiuta («runtime-verification-failed:
# Set OPENCLAW_ALLOW_OLDER_BINARY_DESTRUCTIVE_ACTIONS=1 only for an intentional downgrade or recovery
# action») e il 28/10 ha lasciato la 10.8 installata. Va passata solo al processo del rollback, mai
# nell'ambiente del servizio (che comunque la scarta).
ALLOW_OLDER = "OPENCLAW_ALLOW_OLDER_BINARY_DESTRUCTIVE_ACTIONS"


def run_update(target, down_ok=False, downgrade=False):
    """`openclaw update` verso target. Ritorna (exit, record del run, stderr, interrotto).
    interrotto = perche' OpenClaw si e' svegliato durante la validazione e l'update e' stato fermato
    con SIGINT prima dell'attivazione (docs cli/update/how-updates-run.md: run `failed/interrupted`,
    gateway vecchio intatto). La fase si rilegge per ultima, subito prima del segnale: dopo
    `activating` il gateway e' gia' fermo e interrompere lascerebbe un'installazione a meta'."""
    log(f"openclaw update --yes --json --tag {target}")
    cmd = ["openclaw", "update", "--yes", "--json", "--tag", target, "--timeout", "1800"]
    started = time.time()
    with tempfile.TemporaryFile("w+") as out, tempfile.TemporaryFile("w+") as errf:
        env = {**os.environ, ALLOW_OLDER: "1"} if downgrade else None
        p = subprocess.Popen(cmd, stdout=out, stderr=errf, stdin=subprocess.DEVNULL, text=True, env=env)
        busy, end, children = [], time.time() + 3 * 3600, {}
        while p.poll() is None:
            if time.time() > end:
                p.kill()
                break
            time.sleep(WATCH_S)
            if busy or p.poll() is not None:
                continue
            why = [] if NO_INTERRUPT else busy_reasons(down_ok)
            if why and update_phase() in PRE_ACTIVATION:
                busy = why
                log("OpenClaw si e' messo a lavorare durante la validazione (" + ", ".join(why)
                    + "): interrompo l'update prima dell'attivazione")
                # i figli dell'update partono detached (update-execution.runtime: setsid): chi sono
                # si vede solo adesso, finche' sono ancora figli suoi
                children = descendants(p.pid)
                p.send_signal(signal.SIGINT)
        rc = p.wait()
        if busy:
            after_interrupt(children, started)
        out.seek(0)
        errf.seek(0)
        stdout, stderr = out.read(), errf.read()
    res = parse_json(stdout) or {}
    if rc == 75:
        # consegnato a un helper gestito: l'esito vero arriva nello storico
        end = time.time() + 3600
        while time.time() < end and (oc_json(["update", "status", "--json"], 60) or {}).get("activeRun"):
            time.sleep(POLL_S)
    rec = res.get("run") if isinstance(res.get("run"), dict) else None
    if rec is None or rc == 75:
        rec = (oc_json(["update", "status", "--json"], 60) or {}).get("lastRun") or {}
    log(f"update: exit {rc}, stato {rec.get('status')} {rec.get('reason') or ''}".rstrip())
    return rc, rec, stderr, busy


def run_reason(rec, err=""):
    parts = [rec.get("reason")] if rec.get("reason") else []
    for s in rec.get("steps") or []:
        for f in s.get("failureFacts") or []:
            parts.append((f.get("message") or "").splitlines()[0] if f.get("message") else "")
    if len(parts) < 2 and tail(err):
        parts.append(tail(err))
    return ": ".join(dict.fromkeys(x for x in parts if x))[:200] or "motivo non riportato"


