        todo.append(f"patch tag tra bot: {msg}")
    rc, msg = announce_silent("check")
    if rc:
        todo.append(f"patch silenzio consegne: {msg}")
    rc, msg = wa_catchup("check")
    if rc:
        todo.append(f"patch coda WhatsApp: {msg}")
    rc, msg = hb_subagents("check")
    if rc:
        todo.append(f"patch battito: {msg}")
    rc, msg = session_settings("check")
    if rc:
        todo.append(f"patch sessione non pronta: {msg}")
    rc, msg = pinned_fallback("check")
    if rc:
        todo.append(f"patch ripiego silenzioso: {msg}")
    rc, msg = descendant_expiry("check")
    if rc:
        todo.append(f"patch consegne scadute: {msg}")
    rc, msg = cron_receipt_ddl("check")
    if rc:
        todo.append(f"patch exec integrity admission: {msg}")
    rc, msg = cron_history_names("check")
    if rc:
        todo.append(f"patch storia con cron: {msg}")
    if not todo:
        return 0
    log("da sistemare: " + "; ".join(todo))
    if dry:
        log("dry-run: non tocco niente")
        return 0
    rec = record(cur, root)
    problems, notes, deferred = converge(cur, idle)
    if deferred:
        log("riprovo la notte prossima")
        return 0
    problems = (problems or health_gate(cur, rec)) + [n for n in notes if n.startswith("patch annunci non")]
    if problems:
        notify(f"OpenClaw {short(cur)}: non riesco a sistemare {'; '.join(todo)}: {'; '.join(problems)}"[:300])
        return 1
    notify(f"OpenClaw {short(cur)}: sistemato {'; '.join(todo)}, tutto verde"[:300])
    return 0


def main():
    ap = argparse.ArgumentParser(description="Aggiorna OpenClaw a OpenClaw fermo, con rollback.")
    ap.add_argument("--dry-run", action="store_true", help="passi 1-3 senza toccare niente, poi il piano")
    ap.add_argument("--force-version", help="giro supervisionato verso questa versione (arma il notturno)")
    ap.add_argument("--idle-wait", type=float, default=45, help="minuti di attesa di OpenClaw fermo")
    ap.add_argument("--no-interrupt", action="store_true",
                    help="non fermare l'update se OpenClaw lavora: il drain nativo aspetta i turni in corso, "
                         "i messaggi arrivati a gateway giu' li ripescano openclaw-wa-catchup e oc-restart")
    a = ap.parse_args()
    global NO_INTERRUPT
    NO_INTERRUPT = a.no_interrupt

    LOCK.parent.mkdir(parents=True, exist_ok=True)
    lock = open(LOCK, "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        log("un altro giro e' in corso: esco")
        return 3
    if not a.dry_run:
        not_before_wait()
    global PID_BEFORE
    PID_BEFORE = gateway_pid()  # per resume_interrupted: il giro ha riavviato il gateway?

    gw = gateway_pid()
    if (gw and gw in ancestors()) or os.environ.get("OPENCLAW_GATEWAY_SERVICE_PID"):
        # e' esattamente il managed-service-preflight che ha fatto fallire l'auto-update:
        # dall'albero del gateway `openclaw update` non puo' fermare il gateway che lo contiene
        log(f"rifiuto: giro dentro il gateway di OpenClaw (pid {gw}); va lanciato da launchd o da un terminale")
        return 4

    # ogni notte, anche senza update, e prima del controllo del disco: gli avanzi di build da soli
    # bastavano a bloccare l'update. Solo --dry-run si limita a dire cosa cancellerebbe.
    clean_build_tmp(a.dry_run)
    clean_update_captures(a.dry_run)
    retire_originals(a.dry_run)

    state = load_state()
    armed = bool(state.get("armed"))
    dry = a.dry_run or not (armed or a.force_version)
    st = oc_json(["update", "status", "--json", "--timeout", "15"], 90)
    cur = installed_version()
    if not isinstance(st, dict) or not cur:
        log("OpenClaw non risponde a update status/--version: niente da fare stanotte")
        return 1
    root = (st.get("update") or {}).get("root")
    latest = (st.get("availability") or {}).get("latestVersion")
    last = state.get("last") or {}
    if st.get("activeRun"):
        ar = st["activeRun"]
        log(f"storico update: run {str(ar.get('runId'))[:8]} ancora {ar.get('status')} in fase {ar.get('phase')}"
            + (" (dry-run: non lo tocco)" if dry else ""))
        if not dry:
            reconcile_ledger()

    if last.get("result") == "rollback-pending" and cur == last.get("to"):
        log(f"rollback a {last.get('from')} in sospeso dal giro {last.get('started')}: {last.get('why')}")
        if a.dry_run:
            log("dry-run: non tocco niente")
            return 0
        try:
            rec = json.loads((BACKUPS / last["started"] / "record.json").read_text())
        except (OSError, ValueError, KeyError):
            rec = {}
        return finish_rollback(state, rec, last.get("why"))

    target = a.force_version or latest
    if a.force_version and not re.fullmatch(VER_RE, target):
        log(f"--force-version {target}: non e' una versione")
        return 4
    if not target or vtuple(target) <= vtuple(cur):
        if a.force_version and vtuple(target) < vtuple(cur):
            log(f"--force-version {target} e' piu' vecchia di {cur}: per tornare indietro openclaw update --tag")
            return 4
        log(f"OpenClaw {cur}: nessuna versione nuova (ultima {latest})")
        return quiet_night(cur, root, dry, a.idle_wait)
    if not a.force_version and last.get("to") == target and (
            last.get("result") in FAILED_RESULTS or last.get("run_status") == "rolled-back"):
        # riprovarla ogni notte vorrebbe dire un'interruzione dei canali ogni notte
        log(f"salto {target}: il giro {last.get('started')} e' tornato indietro ({last.get('why')}); "
            f"per riprovarla --force-version {target}")
        return quiet_night(cur, root, dry, a.idle_wait)

    why_dry = " [dry-run]" if a.dry_run else " [non armato: il primo giro vero e' quello supervisionato]" if dry else ""
    log(f"OpenClaw {cur} -> {target}{why_dry}")
    busy = busy_reasons() if dry else [] if NO_INTERRUPT else wait_idle(a.idle_wait)
    if busy:
        log("OpenClaw non e' fermo: " + ", ".join(busy) + ("" if dry else "; riprovo la notte prossima"))
        if not dry:
            return 0
    rec = record(cur, root)
    log(f"fotografia: {cur}, openclaw.json {str(rec['config_sha256'])[:12]}, "
        + ", ".join(f"{k} {v[:12]}" for k, v in rec["dist_sha256"].items())
        + " | plugin " + ", ".join(f"{k} {v['version']}" for k, v in sorted(rec["plugins"].items()))
        + f" | agents-doctor FAIL {len(rec['doctor'])} | problemi gia' presenti {rec['problems'] or 'nessuno'}")
    if dry:
        pins = sorted(k for k, v in rec["plugins"].items() if k == PLUGIN or pinned(v.get("spec")))
        for step in (f"backup SQLite (global + agenti) e openclaw.json in {BACKUPS}/<ts>",
                     f"openclaw update --yes --json --tag {target} (validazione, riavvio e verifica di OpenClaw);"
                     " se OpenClaw si mette a lavorare durante la validazione, SIGINT prima dell'attivazione",
                     f"plugin fissati {', '.join(pins)} -> {target} (plugins install --force --pin)",
                     "patch MCP: saltata se il fix upstream e' nel codice nuovo, se no openclaw-mcp-lazy.py apply",
                     "patch annunci: openclaw-announce-fix.py apply (se non entra lo annota, niente rollback)",
                     "un kickstart -k solo a OpenClaw fermo (se no rimandato), health gate (canali, WhatsApp,"
                     " heartbeat, patch, agents-doctor)",
                     f"dopo il verde, {app_plan(target)}",
                     f"se qualcosa fallisce: rollback a {cur} a OpenClaw fermo e health gate; una riga su WhatsApp ad Attilio"):
            log("piano: " + step)
        return 0

    strained = wait_mac_calm(MAC_WAIT_MIN)
    if strained:
        log(f"Mac sotto sforzo, rimando ({strained}, da {MAC_WAIT_MIN:.0f} min): {cur} resta, riprovo la notte prossima")
        return 0
    free = shutil.disk_usage(HOME).free / 1e9
    if free < MIN_FREE_GB:
        msg = f"aggiornamento OpenClaw {short(cur)}→{short(target)} non tentato: {free:.1f} GB liberi sul Mac"
        log(msg)
        notify(msg)
        return 4
    err = backup(rec)
    if err:
        msg = f"aggiornamento OpenClaw {short(cur)}→{short(target)} non tentato: {err}"
        log(msg)
        notify(msg[:300])
        return 1

    state["last"] = {"started": rec["ts"], "from": cur, "to": target}
    save_state(state)
    rc, run_rec, err, busy = run_update(target)
    clean_update_captures(False)  # ogni tentativo, riuscito o no, lascia la sua copia
    now = installed_version()
    if busy and now == cur:
        state["last"].update(result="interrupted", why=", ".join(busy))
        save_state(state)
        log(f"update interrotto prima dell'attivazione: {cur} resta, riprovo la notte prossima")
        return 0
    if rc == 0 and now == target:
        problems, notes, deferred = converge(target, POST_IDLE_MIN)
        problems = problems or health_gate(target, rec, deferred)
        if not problems:
            state["last"].update(result="ok", notes=notes)
            if a.force_version and not armed:
                state.update(armed=True, armed_at=datetime.datetime.now().isoformat(timespec="seconds"))
                log("armato: da domani il giro notturno aggiorna da solo")
            save_state(state)
            log(f"aggiornato {cur} -> {target}, tutto verde {notes or ''}".rstrip())
            app_note = align_app(target)  # dopo il verde: l'app non c'entra con la salute del gateway
            if app_note:
                log(app_note)
            later ="; plugin e patch MCP al prossimo giro (OpenClaw mai fermo)" if deferred else ""
            later += "".join(f"; {n}" for n in notes if n.startswith("patch annunci non"))
            notify(f"OpenClaw aggiornato {short(cur)}→{short(target)}, tutto verde{later}"[:300])
            return 0
        why = "; ".join(problems)
    elif now == cur:
        # OpenClaw non ha attivato la versione nuova, o e' tornato indietro da solo
        why = run_reason(run_rec, err)
        log(f"update non attivato ({run_rec.get('status')}): {why}")
        problems, _, deferred = converge(cur, POST_IDLE_MIN)
        problems = problems or health_gate(cur, rec, deferred)
        state["last"].update(result="failed", why=why, after=problems, run_status=run_rec.get("status"))
        save_state(state)
        if problems:
            notify(f"aggiornamento OpenClaw fallito ({why}) e {short(cur)} non e' sana: {'; '.join(problems)}"[:300])
            return 2
        notify(f"aggiornamento OpenClaw fallito, tornato a {short(cur)}: {why}"[:300])
        return 1
    else:
        why = run_reason(run_rec, err) if rc else f"installata {now}, attesa {target}"
    log(f"fallito dopo l'update: {why}")
    return finish_rollback(state, rec, why)


PID_BEFORE = None


def resume_interrupted(started):
    """Se il gateway e' stato riavviato durante il giro, fa riprendere i sottoagenti persi."""
    if "--dry-run" in sys.argv or PID_BEFORE is None or gateway_pid() in (None, PID_BEFORE):
        return
    mins = (time.time() - started) / 60 + 5
    rc, out, err = run([OC_RESTART, "--resume-since", f"{mins:.0f}"], 120)
    log(f"ripresa sottoagenti: {tail(out or err)}" if rc == 0 else f"ripresa sottoagenti fallita: {tail(err or out)}")


if __name__ == "__main__":
    _started = time.time()
    _rc = main()
    resume_interrupted(_started)
    sys.exit(_rc)
