def live_problems(expected):
    """Cosa non va adesso nel gateway in esecuzione (versione, canali, plugin)."""
    gs = oc_json(["gateway", "status", "--json"], 90) or {}
    rpc = gs.get("rpc") or {}
    if not rpc.get("ok"):
        return ["il gateway non risponde"]
    p = []
    ver = (rpc.get("server") or {}).get("version")
    if expected and ver != expected:
        p.append(f"il gateway gira {ver}, attesa {expected}")
    h = oc_json(["health", "--json"], 90) or {}
    if not h.get("ok"):
        p.append("health non ok")
    plug = h.get("plugins") or {}
    for e in plug.get("errors") or []:
        p.append(f"plugin in errore: {str(e.get('id') if isinstance(e, dict) else e)[:60]}")
    if PLUGIN not in (plug.get("loaded") or []):
        p.append("plugin whatsapp non caricato")
    chans = (oc_json(["channels", "status", "--json"], 90) or {}).get("channels") or {}
    for name, c in chans.items():
        if not c.get("configured"):
