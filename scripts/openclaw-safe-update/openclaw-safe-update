def pinned(spec):
    m = re.search(rf"(?<=.)@({VER_RE})$", spec or "")
    return m.group(1) if m else None


def plugin_ok(pv, core):
    # un core di correzione (2026.9.7-2) usa i plugin della sua coorte (2026.9.7): docs updating.md
    return pv in (core, base(core))


def misaligned(plugins, core):
    """{id: pacchetto} dei plugin che vanno riallineati a `core` a mano: whatsapp e ogni plugin
    globale con un pin esatto (OpenClaw allinea da solo quelli non fissati, tiene i pin esatti)."""
    todo = {}
    for pid, p in sorted(plugins.items()):
        spec = (p.get("trust") or {}).get("installSpec") or ""
        if (pid == PLUGIN or (p.get("origin") == "global" and pinned(spec))) and not plugin_ok(p.get("version"), core):
            todo[pid] = re.sub(r"(?<=.)@[^@/]*$", "", spec) or f"@openclaw/{pid}"
    return todo


