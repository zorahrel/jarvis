def log(msg):
    # niente numeri di telefono nei log, neanche dentro un errore riportato da OpenClaw
    line = f"{datetime.datetime.now():%Y-%m-%d %H:%M:%S} {re.sub(r'[+]?[0-9]{9,}', '<num>', str(msg))}"
    print(line, flush=True)
    try:
        LOG.parent.mkdir(parents=True, exist_ok=True)
        with open(LOG, "a") as f:
            f.write(line + "\n")
    except OSError:
        pass


def run(cmd, timeout=120, env=None):
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, stdin=subprocess.DEVNULL, env=env)
        return p.returncode, p.stdout, p.stderr
    except subprocess.TimeoutExpired as e:
        out = e.stdout.decode(errors="replace") if isinstance(e.stdout, bytes) else (e.stdout or "")
        return 124, out, f"timeout dopo {timeout} s"
    except OSError as e:
        return 127, "", str(e)


def oc(args, timeout=120):
    return run(["openclaw", *args], timeout)


def parse_json(text):
    text = (text or "").strip()
    starts = [0] + [m.start() + 1 for m in re.finditer(r"\n[\[{]", text)]
    for i in starts:
        try:
            return json.loads(text[i:])
        except ValueError:
            continue
    return None


def oc_json(args, timeout=120):
    rc, out, _ = oc(args, timeout)
    d = parse_json(out)
    return d if isinstance(d, (dict, list)) else None


def tail(text, n=160):
    lines = [x for x in (text or "").strip().splitlines() if x.strip()]
    return (lines[-1] if lines else "")[:n]


def vtuple(v):
    return tuple(int(x) for x in re.findall(r"\d+", v or ""))


def short(v):
    return re.sub(r"^\d{4}\.", "", v or "?")


def base(v):
    return re.sub(r"-\d+$", "", v or "")


def sha(path):
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()


