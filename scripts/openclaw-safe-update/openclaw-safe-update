    """Nessuna versione nuova: patch MCP e plugin fissati devono comunque essere a posto."""
    plugins = plugin_list()
    todo = [f"plugin {k} {plugins[k].get('version')} (core {cur})" for k in misaligned(plugins, cur)]
    rc, msg = mcp_lazy("check")
