def ancestors():
    pids, pid = set(), os.getpid()
    while pid > 1 and pid not in pids:
        pids.add(pid)
        _, out, _ = run(["ps", "-o", "ppid=", "-p", str(pid)], 10)
        pid = int(out.strip() or 0)
    return pids


def plugin_list():
