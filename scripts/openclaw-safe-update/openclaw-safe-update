def is_person_message(msg):
    """True se il messaggio utente lo ha scritto una persona su un canale. La provenienza vince su
    tutto: un messaggio interno (internal_system, inter_session) puo' portare lo stesso una
    idempotencyKey `channel-user:` (visto il 26/10), una persona no. Senza provenienza (evento
    compresso, o canale che non la scrive) decide la chiave: `channel-user:` la mette il gateway
    solo su cio' che arriva da un canale."""
    if msg.get("role") != "user":
        return False
    kind = (msg.get("provenance") or {}).get("kind")
    if kind:
        return kind == "external_user"
    return str(msg.get("idempotencyKey") or "").startswith("channel-user:")


def person_wrote_recently():
    """Ritorna (chi, eta' in s) dell'ultimo messaggio di una persona negli ultimi QUIET_S secondi, nei
    DB di tutti gli agenti; None se nessuno. Raises sqlite3.Error se un DB non si legge: chi chiama
    lo tratta come «non si sa» e quindi occupato.
    E' l'unico segnale che interrompe un giro (26/10). Sottoagenti, retry, copie di consegna,
    cron e profili heap non sono persone: dal 16/10 sei notti su otto sono fallite per loro, e con
    la 2026.10.7 il drain di 300 s del gateway e la ripresa dei turni in coda li reggono."""
    since_ms = (time.time() - QUIET_S) * 1000
    best = None
    for db in sorted(glob.glob(str(OC_HOME / "agents/*/agent/openclaw-agent.sqlite"))):
        con = sqlite3.connect(f"file:{db}?mode=ro", uri=True, timeout=5)
        try:
            rows = con.execute("SELECT created_at, event_json, navigation_json FROM transcript_events "
                               "WHERE created_at > ?", (since_ms,)).fetchall()
        finally:
            con.close()
        for created_ms, event_json, nav_json in rows:
            try:
                if event_json is not None:
                    msg = json.loads(event_json).get("message") or {}
                else:  # evento compresso: il messaggio sta nel riassunto di navigazione
                    nav = json.loads(nav_json)
                    msg = (nav.get("navigation") or nav.get("model") or {}).get("message") or {}
            except (ValueError, AttributeError, TypeError):
                continue
            if is_person_message(msg):
                age = max(0.0, time.time() - created_ms / 1000)
                if best is None or age < best[1]:
                    best = (db.split("/agents/")[1].split("/")[0], age)
    return best


def not_before_wait():
    """Rinvio una tantum: se state/openclaw-safe-update.not-before contiene un'ora ISO con fuso
    (es. 2026-10-25T05:30:00+01:00) e non e' ancora passata, il giro aspetta qui, poi cancella il file.
    Serve a rimettere in fila i lavori di una notte senza spostare l'orario fisso di launchd (04:20)."""
    f = JARVIS / "state/openclaw-safe-update.not-before"
    try:
        until = datetime.datetime.fromisoformat(f.read_text().strip()).timestamp()
    except (OSError, ValueError):
        return
    if until > time.time() + 6 * 3600:
        log(f"rinvio ignorato: {f.name} e' piu' di 6 ore avanti")
        return
    if until > time.time():
        log(f"rinviato su richiesta fino alle {datetime.datetime.fromtimestamp(until):%H:%M} ({f.name})")
        while time.time() < until:
            time.sleep(min(30, max(1, until - time.time())))
    try:
        f.unlink()
    except OSError:
        pass


def busy_reasons(down_ok=False):
    """Lista vuota = si puo' procedere. Altrimenti perche' no.
    Si ferma solo se una PERSONA ha scritto negli ultimi QUIET_S secondi (26/10): tutto il resto lo
    reggono il drain di 300 s del gateway e la ripresa dei turni in coda della 2026.10.7.
    down_ok: un gateway che non risponde conta come fermo. Vale solo dopo un update: non c'e' lavoro
    da interrompere, e aspettare non lo riporta su."""
    h = oc_json(["health", "--json"], 90)
    if not isinstance(h, dict):
        if down_ok and not gateway_up():
            log("il gateway non risponde: nessun lavoro da interrompere")
            return []
        return ["health non risponde"]
    try:
        last = person_wrote_recently()
    except sqlite3.Error as e:
        return [f"database degli agenti non leggibile ({e}): non so se una persona sta scrivendo"]
    if last:
        return [f"una persona ha scritto {int(last[1])} s fa (agente {last[0]})"]
    return []


def mac_strained():
    """(sotto sforzo?, perche'): mac-state.json del hub se fresco (< 90 s), se no carico per core > 1,5."""
    try:
        st = json.loads(MAC_STATE.read_text())
        if time.time() * 1000 - float(st["at"]) < 90_000:
            return bool(st.get("strained")), f"stato del hub, {st.get('loadPerCore')} per core"
    except (OSError, ValueError, KeyError, TypeError):
        pass
    per_core = os.getloadavg()[0] / (os.cpu_count() or 1)
    return per_core > 1.5, f"carico {per_core:.2f} per core"


def wait_mac_calm(minutes):
    """None quando il Mac respira; il motivo se dopo `minutes` e' ancora sotto sforzo."""
    deadline = time.time() + minutes * 60
    while True:
        busy, why = mac_strained()
        if not busy:
            return None
        if time.time() >= deadline:
            return why
        time.sleep(POLL_S)


def wait_idle(minutes, down_ok=False):
    end, polls = time.time() + minutes * 60, 0
    while True:
        why = busy_reasons(down_ok)
        if not why or time.time() >= end:
            return why
        if polls % 10 == 0:
            log("OpenClaw occupato: " + ", ".join(why))
        polls += 1
        time.sleep(POLL_S)


