# ---------------------------------------------------------------- pulizia di tmp

def tree_bytes(path):
    # come du: blocchi occupati, senza mai seguire i link (os.walk non li segue di default)
    total = 0
    for root, dirs, files in os.walk(path):
        for n in dirs + files:
            try:
                total += os.lstat(os.path.join(root, n)).st_blocks * 512
            except OSError:
                pass
    return total


def build_refs():
    """Testo in cui un plugin installato nominerebbe la sua cartella sorgente: plugins list,
    openclaw.json, npm/projects/*/package.json. None = plugin non leggibili: non si cancella niente."""
    rc, out, _ = oc(["plugins", "list", "--json"], 180)
    if rc or not isinstance(parse_json(out), dict):
        return None
    texts = [out]
    for f in [CONFIG, *glob.glob(str(OC_HOME / "npm/projects/*/package.json"))]:
        try:
            texts.append(Path(f).read_text(errors="replace"))
        except OSError:
            pass
    return "\n".join(texts)


def open_under(dirs):
    """(aperte, ignote): le cartelle sotto cui un processo ha un file aperto (o la cwd), e quelle
    di un lotto su cui lsof non ha dato una risposta leggibile. Le une e le altre si tengono."""
    used, unknown = set(), set()
    for i in range(0, len(dirs), LSOF_BATCH):
        batch = dirs[i:i + LSOF_BATCH]
        args = [x for d in batch for x in ("+D", str(d))]  # +D non segue i link simbolici
        rc, out, err = run(["lsof", "-w", "-F", "n", *args], 60)
        # lsof 4.91 esce 1 sia con file trovati, sia senza, sia per errore (es. un +D sparito nel
        # frattempo: stampa l'usage e rifiuta tutto il lotto). Con -w l'unico segno d'errore e'
        # stderr: se non e' vuoto, o l'rc e' altro (timeout 124, lsof assente 127), il lotto e' ignoto.
        if rc not in (0, 1) or err.strip():
            unknown.update(batch)
            continue
        names = [ln[1:] for ln in out.splitlines() if ln.startswith("n")]
        for d in batch:
            roots = {str(d), os.path.realpath(d)}
            if any(n == r or n.startswith(r + "/") for n in names for r in roots):
                used.add(d)
    return used, unknown


def clean_build_tmp(dry):
    """Cancella le cartelle openclaw-plugin-build-* di ~/.openclaw/tmp piu' vecchie di 6 ore, solo
    se nessun plugin le nomina e nessun processo ci ha file aperti. Mai un link, mai altro in tmp."""
    now, kept, old = time.time(), {}, []
    for p in sorted(BUILD_TMP.glob(BUILD_GLOB)):
        try:
            st = os.lstat(p)
        except OSError:
            continue
        if not stat.S_ISDIR(st.st_mode):  # un link simbolico non e' una cartella: non si segue
            kept.setdefault("non cartelle", []).append(p)
        elif now - st.st_mtime < BUILD_MIN_AGE_S:
            kept.setdefault("recenti", []).append(p)
        else:
            old.append(p)
    if not (old or kept):
        return
    gone = []
    if old:
        refs = build_refs()
        if refs is None:
            log(f"pulizia tmp: plugins list non risponde, non cancello le {len(old)} cartelle di build vecchie")
            return
        for p in old:
            if p.name in refs:
                kept.setdefault("nominate da un plugin", []).append(p)
        old = [p for p in old if p.name not in refs]
        used, unknown = open_under(old)
        kept.setdefault("con file aperti", []).extend(p for p in old if p in used)
        kept.setdefault("con lsof in errore", []).extend(p for p in old if p in unknown)
        gone = [p for p in old if p not in used and p not in unknown]
    freed, errors = 0, []
    for p in gone:
        size = tree_bytes(p)
        if dry:
            freed += size
            continue
        try:
            if stat.S_ISLNK(os.lstat(p).st_mode):  # sostituita da un link dopo il controllo
                continue
            shutil.rmtree(p)  # i link dentro li toglie, non li segue
            freed += size
        except OSError as e:
            errors.append(f"{p.name}: {e.strerror or e}")
    done = len(gone) - len(errors)
    why = ", ".join(f"{len(v)} {k}" for k, v in kept.items() if v)
    log(f"pulizia tmp{' [dry-run]' if dry else ''}: {'cancellerei' if dry else 'cancellate'} {done} cartelle "
        f"{BUILD_GLOB}, {freed / 1e9:.1f} GB {'da liberare' if dry else 'liberati'}"
        + (f"; tenute {why}" if why else "") + (f"; errori {'; '.join(errors)[:200]}" if errors else ""))


# ---------------------------------------------------------------- il giro

def rollback(old, rec):
    """Torna a `old` con `openclaw update --tag` (compatibilita' di schema, riavvio e verifica di
    OpenClaw), solo a OpenClaw fermo. Mai `npm i -g`: salterebbe il rifiuto di uno schema o di una
    config piu' nuovi, che le docs dicono di non aggirare (install/updating/rollback-and-recovery.md).
    Ritorna (problemi, in sospeso): in sospeso = OpenClaw mai fermo, nessun riavvio fatto."""
    log(f"rollback a {old}")
    busy = wait_idle(ROLLBACK_IDLE_MIN, down_ok=True)
    if busy:
        return [f"OpenClaw mai fermo in {ROLLBACK_IDLE_MIN:g} min ({', '.join(busy)})"], True
    rc, run_rec, err, busy = run_update(old, down_ok=True, downgrade=True)
    now = installed_version()
    if busy and now != old:
        return [f"OpenClaw si e' messo a lavorare durante la validazione ({', '.join(busy)})"], True
    if now != old:
        return [f"OpenClaw non torna a {old} ({run_reason(run_rec, err)}): installata {now}"], False
    problems, notes, deferred = converge(old, ROLLBACK_IDLE_MIN)
    problems = problems or health_gate(old, rec, deferred)
    root = (oc_json(["update", "status", "--json"], 60) or {}).get("update", {}).get("root") or rec.get("root")
    same = {Path(f).name: sha(f) for f in glob.glob(str(Path(root or "") / "dist/mcp-http.*.mjs"))
            if Path(f).name in rec.get("dist_sha256", {})} == rec.get("dist_sha256")
    log(f"rollback: dist patchato {'identico' if same else 'diverso'} da prima dell'update")
    return problems, False


def finish_rollback(state, rec, why):
    last = state["last"]
    old, new = last["from"], last["to"]
    problems, pending = rollback(old, rec)
    last.update(why=why, after=problems,
                result="rollback-pending" if pending else "rollback-failed" if problems else "rolled-back")
    save_state(state)
    if pending:
        notify(f"OpenClaw {short(new)} non passa i controlli ({why}); rollback a {short(old)} rimandato, "
               f"{problems[0]}: riprovo al prossimo giro o a mano con openclaw-safe-update"[:300])
        return 2
    if problems:
        # prima cosa si legge, poi i motivi: il 28/10 il taglio a 300 caratteri si e' mangiato la causa
        # e l'avviso non diceva che i cron potevano essere fermi
        now = short(installed_version())
        log(f"ROSSO: rollback a {old} NON riuscito, resta {now}")
        notify(f"ROSSO OpenClaw: update a {short(new)} fallito e rollback a {short(old)} NON riuscito, gira {now}. "
               f"Controlla subito i cron (openclaw cron list). Update: {why[:80]}. "
               f"Rollback: {'; '.join(problems)[:110]}")
        return 2
    notify(f"aggiornamento OpenClaw fallito, tornato a {short(old)}: {why}"[:300])
    return 1


