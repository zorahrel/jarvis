<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.jarvis.backup-mac</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/Applications/Backup Mac.app/Contents/MacOS/backup-mac-helper</string>
    <string>run</string>
    <string>__HOME__/.claude/jarvis/scripts/backup-mac/backup-mac</string>
    <string>run</string>
  </array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>5</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>__HOME__/.claude/jarvis/logs/backup-mac/launchd.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.claude/jarvis/logs/backup-mac/launchd.log</string>
  <key>LowPriorityIO</key><true/>
  <key>Nice</key><integer>15</integer>
  <key>ProcessType</key><string>Background</string>
</dict>
</plist>
