def selftest_quit():
    """Uscita della app con una app finta: niente Apple Event né pkill veri, log di prova.

    Il modulo si carica a parte, così i suoi globali (APP_LOG, app_running, ask_quit, force_quit,
    time) si cambiano senza toccare il processo del selftest.
    """
    import importlib.machinery
    import importlib.util
    import types
    name = "claude_account_quit_test"
    loader = importlib.machinery.SourceFileLoader(name, str(Path(__file__).resolve()))  # file senza .py
    spec = importlib.util.spec_from_file_location(name, loader.path, loader=loader)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    tmp = Path(tempfile.mkdtemp(prefix="claude-account-quit."))
    log = tmp / "main.log"
    mod.APP_LOG = log
    veto_line = "2026-10-27 03:40:04 [info] beforeQuit: vetoed by before-quit interceptor\n"

    def append(text):
        with log.open("a") as f:
            f.write(text)

    def case(prelog="", ask=lambda st: None, on_sleep=lambda n: None, force_kills=False):
        log.write_text(prelog)
        st = {"alive": True, "force": 0, "sleeps": 0}

        def fake_sleep(_s):
            st["sleeps"] += 1
            on_sleep(st["sleeps"])

        def fake_force():
            st["force"] += 1
            if force_kills:
                st["alive"] = False

        mod.app_running = lambda: st["alive"]
        mod.ask_quit = lambda: ask(st)
        mod.force_quit = fake_force
        mod.time = types.SimpleNamespace(sleep=fake_sleep, time=time.time)
        try:
            mod.quit_app()
            return 0, "", st["force"]
        except mod.Fail as e:
            return e.code, str(e), st["force"]

    results = []
    try:
        # veto alla richiesta: exit 10, nessun segnale mandato alla app
        code, msg, force = case(ask=lambda st: append(veto_line))
        results.append(("uscita vetata dalla app: exit 10 con «sessioni attive», nessun segnale",
                        code == 10 and "sessioni attive" in msg and force == 0))
        # veto vecchio, prima della richiesta: non conta, la app va comunque chiusa col segnale
        code, msg, force = case(prelog=veto_line * 3, force_kills=True)
        results.append(("veti di prima nel log non bloccano: segnale e app chiusa, exit 0",
                        code == 0 and force == 1))
        # nessun veto e app che non risponde: il comportamento di prima, exit 6 dopo il segnale
        code, msg, force = case(force_kills=False)
        results.append(("app che non risponde senza veto: segnale mandato, exit 6 come prima",
                        code == 6 and "non si chiude" in msg and force == 1))
        # veto che arriva mentre si aspetta: exit 10 senza segnale
        code, msg, force = case(on_sleep=lambda n: append(veto_line) if n == 2 else None)
        results.append(("veto scritto durante l'attesa: exit 10, nessun segnale",
                        code == 10 and force == 0))
        # uscita pulita dopo la richiesta: nessun segnale
        code, msg, force = case(ask=lambda st: st.update(alive=False))
        results.append(("app che esce alla richiesta: exit 0, nessun segnale",
                        code == 0 and force == 0))
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    return results


def selftest():
    """Su una app finta in una cartella temporanea e un servizio Keychain di prova."""
    me = Path(__file__).resolve()
    tmp = Path(tempfile.mkdtemp(prefix="claude-account-selftest."))
    app, data = tmp / "app", tmp / "data"
    app.mkdir()
    svc = f"claude-app-login-selftest-{os.getpid()}"
    env = dict(os.environ, CLAUDE_ACCOUNT_APP_DIR=str(app), CLAUDE_ACCOUNT_DATA_DIR=str(data),
               CLAUDE_ACCOUNT_KC_SERVICE=svc, CLAUDE_ACCOUNT_NO_APP="1",
               CLAUDE_ACCOUNT_LOG=str(tmp / "log"), CLAUDE_ACCOUNT_APP_LOG=str(tmp / "main.log"))
    env.pop("__CFBundleIdentifier", None)
    schema = ("CREATE TABLE cookies(creation_utc INTEGER NOT NULL,host_key TEXT NOT NULL,top_frame_site_key TEXT NOT NULL,"
              "name TEXT NOT NULL,value TEXT NOT NULL,encrypted_value BLOB NOT NULL,path TEXT NOT NULL,expires_utc INTEGER NOT NULL,"
              "is_secure INTEGER NOT NULL,is_httponly INTEGER NOT NULL,last_access_utc INTEGER NOT NULL,has_expires INTEGER NOT NULL,"
              "is_persistent INTEGER NOT NULL,priority INTEGER NOT NULL,samesite INTEGER NOT NULL,source_scheme INTEGER NOT NULL,"
              "source_port INTEGER NOT NULL,last_update_utc INTEGER NOT NULL,source_type INTEGER NOT NULL,"
              "has_cross_site_ancestor INTEGER NOT NULL)")
    future = int((time.time() + CHROME_EPOCH_OFFSET + 20 * 86400) * 1e6)
    past = int((time.time() + CHROME_EPOCH_OFFSET - 86400) * 1e6)
    secret = {"A": os.urandom(24), "B": os.urandom(24), "C": os.urandom(24)}
    other = os.urandom(16)

    def put_account(who, uuid, exp=future):
        db = app / "Cookies"
        con = sqlite3.connect(str(db))
        con.execute(schema.replace("CREATE TABLE", "CREATE TABLE IF NOT EXISTS"))
        with con:
            con.execute("delete from cookies where host_key like '%claude%'")
            for host, name, val in ((".claude.ai", "sessionKey", b"SEGRETO-" + secret[who]),
                                    (".claude.ai", "lastActiveOrg", b"org-" + who.encode()),
                                    ("claude.ai", "anthropic-device-id", b"dev-" + who.encode())):
                con.execute("insert into cookies values (1,?,'',?,'',?,'/',?,1,1,1,1,1,1,0,2,443,1,0,0)",
                            (host, name, val, exp))
            if not con.execute("select 1 from cookies where host_key='m.stripe.com'").fetchone():
                con.execute("insert into cookies values (1,'m.stripe.com','','m','',?,'/',?,1,1,1,1,1,1,0,2,443,1,0,0)",
                            (other, future))
        con.close()
        cfg = json.loads((app / "config.json").read_text()) if (app / "config.json").exists() else {"locale": "it-IT"}
        cfg.update({"oauth:tokenCacheV2": "cache-" + who, "lastKnownAccountUuid": uuid})
        (app / "config.json").write_text(json.dumps(cfg))

    def run(*a, email=None):
        e = dict(env, CLAUDE_ACCOUNT_SELFTEST_EMAIL=email) if email else env
        r = subprocess.run([sys.executable, "-I", str(me), *a], env=e, capture_output=True, text=True)
        return r.returncode, r.stdout + r.stderr

    def session_key():
        con = sqlite3.connect(str(app / "Cookies"))
        row = con.execute("select encrypted_value from cookies where name='sessionKey'").fetchone()
        con.close()
        return row[0] if row else None

    def kc_raw(label):
        return subprocess.run(["security", "find-generic-password", "-s", svc, "-a", label, "-w"],
                              capture_output=True, text=True).stdout

    checks = []

    def check(name, ok):
        checks.append(ok)
        print(("ok   " if ok else "FAIL ") + name)

    outputs = []
    try:
        uA, uB = "aaaaaaaa-0000-4000-8000-000000000001", "bbbbbbbb-0000-4000-8000-000000000002"
        put_account("A", uA)
        rc, out = run("save", "alfa"); outputs.append(out)
        check("save alfa esce 0", rc == 0)
        put_account("B", uB)
        (app / "bridge-state.json").write_text(json.dumps({f"o:{uA}": {"x": 1}, f"o:{uB}": {"x": 2}}))
        rc, out = run("save", "beta"); outputs.append(out)
        check("save beta esce 0", rc == 0)
        rc, out = run("save", "alfa"); outputs.append(out)
        check("save non sovrascrive un altro account con lo stesso nome (exit 2)", rc == 2)
        (data / "alfa/meta.json").write_text(json.dumps(dict(json.loads((data / "alfa/meta.json").read_text()),
                                                             email="alfa@esempio.test")))
        rc, out = run("use", "esempio"); outputs.append(out)
        check("use per dominio dell'email trova alfa ed esce 0", rc == 0)
        con = sqlite3.connect(str(app / "Cookies"))
        sk = (con.execute("select encrypted_value from cookies where name='sessionKey'").fetchone() or [None])[0]
        st = (con.execute("select encrypted_value from cookies where host_key='m.stripe.com'").fetchone() or [None])[0]
        n = con.execute("select count(*) from cookies where host_key like '%claude%'").fetchone()[0]
        con.close()
        check("cookie di accesso tornati quelli di alfa, byte per byte", sk == b"SEGRETO-" + secret["A"] and n == 3)
        check("cookie di altri siti non toccati", st == other)
        cfg = json.loads((app / "config.json").read_text())
        check("config: voci oauth di alfa, il resto intatto",
              cfg.get("oauth:tokenCacheV2") == "cache-A" and cfg.get("lastKnownAccountUuid") == uA
              and cfg.get("locale") == "it-IT")
        bridge = json.loads((app / "bridge-state.json").read_text())
        check("controllo remoto: tolta solo la voce dell'account d'arrivo", list(bridge) == [f"o:{uB}"])
        rc, out = run("use", "alfa"); outputs.append(out)
        check("use sull'account già attivo non fa niente ed esce 0", rc == 0 and "già su alfa" in out)
        rc, out = run("use", "alfa", "--again"); outputs.append(out)
        check("--again sullo stesso account riscrive ed esce 0", rc == 0 and "app su alfa" in out)
        rc, out = run("use", "beta"); outputs.append(out)
        cfg = json.loads((app / "config.json").read_text())
        check("ritorno su beta", rc == 0 and cfg.get("lastKnownAccountUuid") == uB)
        # uscita dalla app: lastKnownAccountUuid resta, il cookie no. Non è «già su»
        con = sqlite3.connect(str(app / "Cookies"))
        with con:
            con.execute("delete from cookies where name='sessionKey'")
        con.close()
        rc, out = run("use", "beta"); outputs.append(out)
        check("app uscita dall'accesso: use rimette il cookie invece di dire «già su»",
              rc == 0 and "già su" not in out and session_key() == b"SEGRETO-" + secret["B"])
        # un account nuovo il cui nome ricavato dall'email è già di un altro
        alfa_before = kc_raw("alfa")
        put_account("C", "cccccccc-0000-4000-8000-000000000003")
        rc, out = run("save", email="alfa@altro.test"); outputs.append(out)
        check("nome ricavato già preso: salva come account-cccccccc e alfa resta com'era",
              rc == 0 and (data / "account-cccccccc/meta.json").exists() and kc_raw("alfa") == alfa_before)
        put_account("B", uB)
        # config.json che non si può preparare: niente cookie a metà, niente traceback
        before = (app / "Cookies").read_bytes()
        env["CLAUDE_ACCOUNT_SELFTEST_DISK_FULL"] = "1"
        try:
            rc, out = run("use", "alfa"); outputs.append(out)
        finally:
            env.pop("CLAUDE_ACCOUNT_SELFTEST_DISK_FULL")
        check("disco pieno sulla config: cookie intatti, messaggio in italiano, nessun file temporaneo",
              rc == 1 and (app / "Cookies").read_bytes() == before and "errore inatteso" in out
              and "Traceback" not in out and not list(app.glob(".config.json.*")))
        rc, out = run("use", "gamma"); outputs.append(out)
        check("account sconosciuto: exit 2", rc == 2)
        # salvataggio rovinato nel Keychain: non deve arrivare a scrivere niente
        before = (app / "Cookies").read_bytes()
        subprocess.run(["security", "add-generic-password", "-U", "-s", svc, "-a", "alfa", "-w", "rovinato"],
                       capture_output=True)
        rc, out = run("use", "alfa"); outputs.append(out)
        check("salvataggio rovinato: exit 5 e app intatta", rc == 5 and (app / "Cookies").read_bytes() == before)
        put_account("A", uA, exp=past)
        rc, out = run("save", "alfa"); outputs.append(out)
        put_account("B", uB)
        rc, out = run("use", "alfa"); outputs.append(out)
        check("accesso salvato scaduto: exit 3", rc == 3)
        rc, out = run("current"); outputs.append(out)
        check("current esce 0 e dice beta", rc == 0 and "(beta)" in out)
        logs = (tmp / "log").read_text() if (tmp / "log").exists() else ""
        leak = any(s in blob for blob in outputs + [logs]
                   for v in secret.values()
                   for s in (v.hex(), base64.b64encode(b"SEGRETO-" + v).decode(), "SEGRETO-"))
        check("nessun segreto in output o nel log", not leak)
        metas = " ".join(p.read_text() for p in data.glob("*/meta.json"))
        check("meta.json senza segreti", "SEGRETO" not in metas and "cache-" not in metas)
    finally:
        for label in ("alfa", "beta", "gamma", "account-cccccccc"):
            subprocess.run(["security", "delete-generic-password", "-s", svc, "-a", label], capture_output=True)
        shutil.rmtree(tmp, ignore_errors=True)
    for name, good in selftest_quit():
        check(name, good)
    ok = all(checks)
    print(f"selftest: {sum(checks)}/{len(checks)} {'verde' if ok else 'ROSSO'}")
    return 0 if ok else 1


def main():
    ap = argparse.ArgumentParser(prog="claude-account",
                                 description="Cambia l'account della app Claude desktop senza rifare il login.")
    ap.add_argument("--selftest", action="store_true", help="prova su una app finta, exit 0 = verde")
    sub = ap.add_subparsers(dest="cmd")
    sub.add_parser("current", help="su quale account è la app, cosa è salvato, cosa usa il terminale")
    s = sub.add_parser("save", help="salva nel Keychain l'account su cui è la app adesso")
    s.add_argument("name", nargs="?", help="nome da dargli (di default la parte prima della @)")
    for cmd in ("use", "aggiungi"):
        u = sub.add_parser(cmd, aliases=["add"] if cmd == "aggiungi" else [],
                           help="passa la app su un account salvato" if cmd == "use"
                           else "login una tantum di un account nuovo, poi torna dove eri")
        u.add_argument("name")
        u.add_argument("--force", action="store_true", help="non aspetta le sessioni ferme (le taglia)")
        u.add_argument("--again", action="store_true", help="rifà il cambio anche se la app è già su quell'account")
        u.add_argument("--wait", type=int, default=0, help="minuti di attesa per sessioni ferme e Mac libero")
        u.add_argument("--cron", action="store_true", help="modo notturno: richiede anche il Mac libero")
        u.add_argument("--dry-run", action="store_true", help="dice cosa farebbe")
        if cmd == "aggiungi":
            u.add_argument("--wait-login", type=int, default=15, help="minuti per fare l'accesso")
            u.add_argument("--stay", action="store_true", help="resta sull'account nuovo")
    args = ap.parse_args()
    try:
        if args.selftest:
            return selftest()
        if args.cmd in ("use", "aggiungi", "add") and not args.dry_run and inside_app() \
                and not os.environ.get("CLAUDE_ACCOUNT_DETACHED"):
            return detach(sys.argv[1:])
        if args.cmd == "save":
            save(args.name)
            return 0
        if args.cmd == "use":
            return use(args)
        if args.cmd in ("aggiungi", "add"):
            return add(args)
        return current(args)
    except Fail as e:
        say(f"❌ {e}")
        return e.code
    except Exception as e:
        # niente traceback ad Attilio: tipo e messaggio bastano, il resto si rifà a mano
        say(f"❌ errore inatteso ({type(e).__name__}: {str(e)[:160]}). Stato: claude-account current")
        return 1


if __name__ == "__main__":
    sys.exit(main())
