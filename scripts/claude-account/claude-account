def inside_app():
    """Vero se la app è fra i processi padre: chiudendola si chiuderebbe anche questo comando."""
    if NO_APP:
        return False
    pid = os.getppid()
    for _ in range(40):
        if pid <= 1:
            return False
        r = subprocess.run(["ps", "-o", "ppid=,comm=", "-p", str(pid)], capture_output=True, text=True)
        parts = r.stdout.strip().split(None, 1)
        if len(parts) < 2:
            return False
        if parts[1].endswith("/Claude.app/Contents/MacOS/Claude"):
            return True
        pid = int(parts[0])
    return False


def detach(argv):
    """Lanciato da una sessione della app, il cambio la chiuderebbe sotto di sé: si rilancia via launchd."""
    label = "com.jarvis.claude-account-run"
    run_dir = DATA_DIR / "run"
    run_dir.mkdir(parents=True, exist_ok=True)
    plist = run_dir / f"{label}.plist"
    out = run_dir / "ultimo-cambio.log"
    # CLAUDE_CODE_HOST_SESSION_ID: la sessione che lancia non conta fra quelle da aspettare
    keep = ("HOME", "USER", "LOGNAME", "PATH", "LANG", "CLAUDE_CODE_HOST_SESSION_ID")
    env = {k: v for k, v in os.environ.items() if k in keep}
    env["CLAUDE_ACCOUNT_DETACHED"] = "1"
    # bootout alla fine: senza, launchd terrebbe il job caricato
    script = (f"sleep 3; {sh_quote(sys.executable)} -I {sh_quote(str(Path(__file__).resolve()))} "
              f"{' '.join(map(sh_quote, argv))}; "
              f"launchctl bootout gui/{os.getuid()}/{label}")
    plist.write_bytes(plistlib.dumps({
        "Label": label, "ProgramArguments": ["/bin/sh", "-c", script],
        "RunAtLoad": True, "EnvironmentVariables": env,
        "StandardOutPath": str(out), "StandardErrorPath": str(out),
    }))
    subprocess.run(["launchctl", "bootout", f"gui/{os.getuid()}/{label}"], capture_output=True)
    out.write_text("")
    r = subprocess.run(["launchctl", "bootstrap", f"gui/{os.getuid()}", str(plist)], capture_output=True, text=True)
    if r.returncode != 0:
        raise Fail(f"launchd non ha preso il cambio: {r.stderr.strip()}")
    print(f"parte fuori dalla app fra 3 s (questa sessione verrà chiusa dal riavvio). Esito in {out}")
    return 0


def sh_quote(s):
    return "'" + s.replace("'", "'\"'\"'") + "'"


